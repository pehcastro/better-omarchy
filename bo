# Writes the bare record a unit gets when it declares a `replaces` and nothing
# was found in that slot at install time.

SNAPSHOT_PY='
import hashlib, json, os, sys, time

MODE = os.environ["BO_SNAP_MODE"]
REF = os.environ["BO_SNAP_REF"]
ROOT = os.environ["BO_SNAP_DIR"]
CONFIG = os.environ.get("BO_SNAP_SHELL", "")

MANIFEST = os.path.join(ROOT, "manifest.json")
VALUES = os.path.join(ROOT, "values")


def digest(data):
    return hashlib.sha256(data).hexdigest()


def read_shell():
    try:
        with open(CONFIG) as handle:
            return json.load(handle)
    except Exception:
        return None


def write_shell(shell):
    with open(CONFIG, "w") as handle:
        json.dump(shell, handle, indent=2, ensure_ascii=False)
        handle.write("\n")


# ------------------------------------------------------------------ reading
#
# One reader per kind. Each answers with a value that says "absent" as loudly as
# it says anything else, because absent is the case the bar widget bug was made
# of: something was there before and nothing was after, and a restore that only
# knows how to put files back cannot express that.

def read_file(path, slot):
    path = os.path.expanduser(path)
    if os.path.islink(path):
        return {"present": True, "type": "link", "target": os.readlink(path)}
    if not os.path.exists(path):
        return {"present": False}
    try:
        with open(path, "rb") as handle:
            body = handle.read()
    except OSError:
        return {"present": False}
    if slot is not None:
        os.makedirs(VALUES, exist_ok=True)
        with open(os.path.join(VALUES, slot), "wb") as handle:
            handle.write(body)
    return {"present": True, "type": "file", "hash": digest(body),
            "file": slot, "mode": oct(os.stat(path).st_mode & 0o777)}


def read_barwidget(wid, _slot):
    shell = read_shell()
    if shell is None:
        return {"present": False}
    layout = shell.get("bar", {}).get("layout", {})
    for section, widgets in layout.items():
        for index, widget in enumerate(widgets):
            if isinstance(widget, dict) and widget.get("id") == wid:
                body = json.dumps(widget, sort_keys=True).encode()
                return {"present": True, "type": "barwidget", "value": widget,
                        "section": section, "index": index, "hash": digest(body)}
    return {"present": False}


def read_shelljson(dotted, _slot):
    shell = read_shell()
    if shell is None:
        return {"present": False}
    node = shell
    for part in dotted.split("."):
        if not isinstance(node, dict) or part not in node:
            return {"present": False}
        node = node[part]
    body = json.dumps(node, sort_keys=True).encode()
    return {"present": True, "type": "shelljson", "value": node, "hash": digest(body)}


def read_command(name, _slot):
    for folder in os.environ.get("PATH", "").split(":"):
        candidate = os.path.join(folder, name)
        if os.path.islink(candidate):
            return {"present": True, "type": "link", "target": os.readlink(candidate),
                    "at": candidate}
        if os.path.exists(candidate):
            return {"present": True, "type": "file", "at": candidate,
                    "hash": digest(open(candidate, "rb").read())}
    return {"present": False}



MODMASK = {"SHIFT": 1, "CAPS": 2, "CTRL": 4, "ALT": 8, "MOD2": 16,
           "MOD3": 32, "SUPER": 64, "MOD5": 128}


def read_key(spec, _slot):
    # The compositor is asked rather than a config file parsed: a binding can
    # come from any of several files and only Hyprland knows which one won. The
    # value is what the key does, which is the thing somebody has in their
    # fingers and the only thing worth comparing across months.
    import subprocess
    parts = [p.strip().upper() for p in spec.replace("-", "+").split("+") if p.strip()]
    if not parts:
        return {"present": False}
    want_key, mods = parts[-1], parts[:-1]
    mask = 0
    for mod in mods:
        mask |= MODMASK.get(mod, 0)
    try:
        out = subprocess.run(["hyprctl", "binds", "-j"], capture_output=True,
                             text=True, timeout=5).stdout
        binds = json.loads(out)
    except Exception:
        return {"present": False}
    for bind in binds:
        if bind.get("modmask") != mask:
            continue
        if str(bind.get("key", "")).upper() != want_key:
            continue
        what = bind.get("description") or ""
        body = json.dumps({"d": bind.get("dispatcher"), "a": bind.get("arg"),
                           "w": what}, sort_keys=True).encode()
        return {"present": True, "type": "key", "hash": digest(body),
                "what": what or (str(bind.get("dispatcher")) + " " + str(bind.get("arg"))),
                "dispatcher": bind.get("dispatcher"), "arg": bind.get("arg")}
    return {"present": False}


def put_key(_spec, _value):
    # Deliberately not written. A binding lives in whichever of somebody hypr
    # files they keep their own in, and bo guessing at that is how a config
    # gets a line nobody asked for. The proposal prints what to paste instead.
    return "manual"

READERS = {"file": read_file, "key": read_key, "barwidget": read_barwidget,
           "shelljson": read_shelljson, "command": read_command}


# ------------------------------------------------------------------ writing

def put_file(path, value):
    path = os.path.expanduser(path)
    if not value.get("present"):
        if os.path.islink(path) or os.path.exists(path):
            os.remove(path)
        return "removed"
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    if os.path.islink(path) or os.path.exists(path):
        os.remove(path)
    if value.get("type") == "link":
        os.symlink(value["target"], path)
        return "relinked"
    body = open(os.path.join(VALUES, value["file"]), "rb").read()
    if digest(body) != value.get("hash"):
        return "refused"
    with open(path, "wb") as handle:
        handle.write(body)
    if value.get("mode"):
        os.chmod(path, int(value["mode"], 8))
    return "restored"


def put_barwidget(wid, value):
    shell = read_shell()
    if shell is None:
        return "skipped"
    layout = shell.setdefault("bar", {}).setdefault("layout", {})

    for section in layout:
        layout[section] = [w for w in layout[section]
                           if not (isinstance(w, dict) and w.get("id") == wid)]

    if not value.get("present"):
        write_shell(shell)
        return "removed"

    section = value.get("section") or ""
    if value.get("assumed") and os.environ.get("BO_SNAP_STANDIN"):
        for name, widgets in layout.items():
            for at, widget in enumerate(widgets):
                if isinstance(widget, dict) and widget.get("id") == os.environ["BO_SNAP_STANDIN"]:
                    section, value = name, dict(value, index=at)
                    break
            if section:
                break
    if section not in layout:
        section = "left" if "left" in layout else next(iter(layout), "")
    if not section:
        return "skipped"
    index = value.get("index", -1)
    if index is None or index < 0 or index > len(layout[section]):
        index = len(layout[section])
    layout[section].insert(index, value["value"])
    write_shell(shell)
    return "restored"


def put_shelljson(dotted, value):
    shell = read_shell()
    if shell is None:
        return "skipped"
    parts = dotted.split(".")
    node = shell
    for part in parts[:-1]:
        node = node.setdefault(part, {})
    if not value.get("present"):
        node.pop(parts[-1], None)
        write_shell(shell)
        return "removed"
    node[parts[-1]] = value["value"]
    write_shell(shell)
    return "restored"


def put_command(name, value):
    if not value.get("present"):
        return "skipped"
    at = value.get("at")
    if not at:
        return "skipped"
    return put_file(at, value)


PUTTERS = {"file": put_file, "key": put_key, "barwidget": put_barwidget,
           "shelljson": put_shelljson, "command": put_command}


def load():
    with open(MANIFEST) as handle:
        return json.load(handle)


def save(data):
    os.makedirs(ROOT, exist_ok=True)
    with open(MANIFEST, "w") as handle:
        json.dump(data, handle, indent=2, ensure_ascii=False)
        handle.write("\n")


def same(a, b):
    if not a.get("present") and not b.get("present"):
        return True
    if a.get("present") != b.get("present"):
        return False
    if a.get("type") != b.get("type"):
        return False
    if a.get("type") == "link":
        return a.get("target") == b.get("target")
    return a.get("hash") == b.get("hash")


def describe(value):
    if not value.get("present"):
        return "absent"
    kind = value.get("type")
    if kind == "link":
        return "-> " + value.get("target", "")
    if kind == "key":
        return value.get("what", "")[:34]
    if kind == "barwidget":
        return "%s[%s]" % (value.get("section"), value.get("index"))
    if kind == "shelljson":
        return json.dumps(value.get("value"))[:40]
    return (value.get("hash") or "")[:12]


# --------------------------------------------------------------------- modes

if MODE == "before":
    # First snapshot wins. A second one taken while the first is unrestored
    # would capture what this unit already put there as the thing to go back to,
    # which is how an original is lost for good.
    if os.path.exists(MANIFEST):
        print("kept")
        raise SystemExit(0)

    items = []
    for n, line in enumerate(sys.stdin.read().split("\n")):
        line = line.strip()
        if not line or "\t" not in line:
            continue
        klass, kind, key = "", "", ""
        parts = line.split("\t")
        if len(parts) == 3:
            klass, kind, key = parts
        else:
            kind, key = parts[0], parts[1]
        reader = READERS.get(kind)
        if reader is None:
            continue
        if klass == "keeps":
            items.append({"kind": kind, "key": key, "class": "keeps",
                          "before": {"present": False}})
            continue
        value = reader(key, "b%d" % n)
        if not klass:
            # Nothing declared, so the value says which it is: something was
            # there and this is taking its place, or nothing was and this is an
            # addition. That is not a guess, it is a reading, which is why the
            # automatic half needs no declaration and the declared half does.
            klass = "displaced" if value.get("present") else "added"
        if (kind == "barwidget" and not value.get("present")
                and os.environ.get("BO_SNAP_STANDIN")):
            value = {"present": True, "type": "barwidget", "assumed": True,
                     "value": {"id": key}, "section": "", "index": -1,
                     "hash": digest(json.dumps({"id": key}, sort_keys=True).encode())}
        # Displacement is a two-sided class: recording that something was in
        # the slot is only half of it, and the other half is taking the slot,
        # or the machine ends up with both. Bar widgets are the case where bo
        # can do that itself; the others are the unit own doing.
        if klass == "displaced" and kind == "barwidget" and value.get("present") \
                and not value.get("assumed"):
            put_barwidget(key, {"present": False})

        items.append({"kind": kind, "key": key, "class": klass, "before": value})

    save({"schema": 1, "ref": REF, "taken": time.strftime("%Y-%m-%dT%H:%M:%S"),
          "version": os.environ.get("BO_SNAP_VERSION", ""), "items": items})
    print("took %d" % len(items))

elif MODE == "after":
    if not os.path.exists(MANIFEST):
        raise SystemExit(0)
    data = load()
    for n, item in enumerate(data["items"]):
        reader = READERS.get(item["kind"])
        if reader:
            item["after"] = reader(item["key"], "a%d" % n)
    save(data)

elif MODE == "restore":
    if not os.path.exists(MANIFEST):
        raise SystemExit(0)
    data = load()
    for item in data["items"]:
        kind, key = item["kind"], item["key"]
        before = item.get("before", {})
        after = item.get("after")
        reader, putter = READERS.get(kind), PUTTERS.get(kind)
        if reader is None or putter is None:
            continue

        now = reader(key, None)

        # Nothing to do when the unit never changed it.
        if after is not None and same(before, after):
            continue

        # Changed since the unit put it there, so it now belongs to the user.
        if after is not None and not same(now, after):
            print("kept\t%s\t%s" % (kind, key))
            continue

        result = putter(key, before)
        print("%s\t%s\t%s" % (result, kind, key))

elif MODE == "putone":
    if not os.path.exists(MANIFEST):
        raise SystemExit(0)
    data = load()
    want = (os.environ.get("BO_SNAP_ONE_KIND"), os.environ.get("BO_SNAP_ONE_KEY"))
    for item in data["items"]:
        if (item["kind"], item["key"]) == want:
            putter = PUTTERS.get(item["kind"])
            if putter:
                print(putter(item["key"], item.get("before", {})))

elif MODE == "diff":
    if not os.path.exists(MANIFEST):
        raise SystemExit(0)
    data = load()
    print("taken\t%s" % data.get("taken", ""))
    for item in data["items"]:
        reader = READERS.get(item["kind"])
        if reader is None:
            continue
        now = reader(item["key"], None)
        after = item.get("after", {})
        state = "same" if same(now, after) else "drifted"
        print("%s\t%s\t%s\t%s\t%s\t%s" % (
            state, item.get("class", "?"), item["key"],
            describe(item.get("before", {})), describe(after), describe(now)))

elif MODE == "drift":
    if not os.path.exists(MANIFEST):
        raise SystemExit(0)
    data = load()
    for item in data["items"]:
        reader = READERS.get(item["kind"])
        if reader is None or item.get("after") is None:
            continue
        now = reader(item["key"], None)
        if not same(now, item["after"]):
            print("%s\t%s" % (item["kind"], item["key"]))

elif MODE == "keys":
    if not os.path.exists(MANIFEST):
        raise SystemExit(0)
    for item in load()["items"]:
        print("%s\t%s" % (item["kind"], item["key"]))
'


# Hands the slot back. Called on remove, before anything else touches the
# layout, because where the unit sits now is what decides where the widget it
# replaced goes back: somebody who moved the widget after installing it meant to
# move that slot, not to pin the old one to where it used to be.


# Drops one id from shell.json's plugins list. Written back with the same two
# space indent the shell writes, so a later diff is about the change and not
# about formatting.
FORGET_PLUGIN_PY='
import json, os

path = os.environ["BO_FORGET_CONFIG"]
wanted = os.environ["BO_FORGET_ID"]

try:
    with open(path) as handle:
        config = json.load(handle)
except Exception:
    raise SystemExit(0)

plugins = config.get("plugins")
if not isinstance(plugins, list):
    raise SystemExit(0)

def names(entry):
    return entry.get("id") if isinstance(entry, dict) else entry

kept = [entry for entry in plugins if names(entry) != wanted]
if len(kept) == len(plugins):
    raise SystemExit(0)

config["plugins"] = kept
with open(path, "w") as handle:
    json.dump(config, handle, indent=2)
    handle.write("\n")
'

# ---------------------------------------------------------------- marketplaces

# Every marketplace root, one per line. A checkout carrying this script counts
# even when it is not under MARKETS_DIR.
market_roots() {
  local dir seen=""

  # Two checkouts can claim one name, which happens the moment somebody clones a
  # marketplace they already develop in. market_root answers with the first, so
  # letting the second through would list every unit twice with half of them
  # unreachable by ref. First one wins, and the one bo runs from is first.
  if [[ -f "$SELF_ROOT/registry.json" ]]; then
    printf '%s\n' "$SELF_ROOT"
    seen=$(market_name "$SELF_ROOT")$'\n'
  fi

  # Working trees somebody pointed bo at with `bo market link`. They are not
  # under MARKETS_DIR and bo never wrote them, which is exactly what makes them
  # local: nothing here can be fetched, and editing the checkout changes what
  # the marketplace offers with no update step in between.
  if [[ -f $LOCAL_FILE ]]; then
    while read -r dir; do
      [[ -z $dir || ! -f "$dir/registry.json" ]] && continue
      [[ $(readlink -f "$dir") == "$(readlink -f "$SELF_ROOT")" ]] && continue

      local lname
      lname=$(market_name "$dir")
      printf '%s\n' "$seen" | grep -qxF "$lname" && continue
      seen+="$lname"$'\n'

      printf '%s\n' "$dir"
    done < <(grep -v '^[[:space:]]*$' "$LOCAL_FILE" 2>/dev/null)
  fi

  for dir in "$MARKETS_DIR"/*/; do
    [[ -f "$dir/registry.json" ]] || continue
    dir="${dir%/}"
    [[ $(readlink -f "$dir") == "$(readlink -f "$SELF_ROOT")" ]] && continue

    local name
    name=$(market_name "$dir")
    printf '%s\n' "$seen" | grep -qxF "$name" && continue
    seen+="$name"$'\n'

    printf '%s\n' "$dir"
  done
}

market_name() {
  local root="$1" name
  name=$(json_get "$root/registry.json" name)
  printf '%s' "${name:-$(basename "$root")}"
}

# local or remote, and it is derivable rather than recorded because bo already
# decides it by where it puts things. Everything `bo market add` clones lands
# under MARKETS_DIR; everything else is a checkout on this machine that bo was
# pointed at and cannot fetch. The distinction a developer cares about is which
# of those they are running against, and this is that question exactly.
market_kind() {
  local real markets
  real=$(readlink -f "$1" 2>/dev/null) || real="$1"
  markets=$(readlink -f "$MARKETS_DIR" 2>/dev/null) || markets="$MARKETS_DIR"
  case "$real" in
  "$markets"/*) printf remote ;;
  *) printf local ;;
  esac
}

# Where it came from, in the terms of its kind: a remote one names the URL it
# was cloned from, a local one names the tree it is.
market_source() {
  local root="$1"
  if [[ $(market_kind "$root") == remote ]]; then
    git -C "$root" remote get-url origin 2>/dev/null && return 0
    printf '%s' "$root"
    return 0
  fi
  printf '%s' "${root/#$HOME/\~}"
}

# How many commits the last fetch left it behind by. Never fetches: `bo market
# update` does that, and a list that pauses on the network is a list nobody
# runs.
market_behind() {
  local root="$1" branch
  [[ $(market_kind "$root") == remote ]] || return 0
  branch=$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null) || return 0
  git -C "$root" rev-list --count "HEAD..origin/$branch" 2>/dev/null || return 0
}

market_root() {
  local want="$1" root
  while read -r root; do
    [[ $(market_name "$root") == "$want" ]] && {
      printf '%s' "$root"
      return 0
    }
  done < <(market_roots)
  return 1
}

# market_name prints without a newline so it composes inside $(). This is the
# line-per-name form every caller that counts or joins needs.
market_names() {
  local root
  while read -r root; do
    market_name "$root"
    printf '\n'
  done < <(market_roots)
}

# ---------------------------------------------------------------- json / toml

# json_get <file> <dotted.path> -> scalar, or a space-joined list, or empty
json_get() {
  [[ -f $1 ]] || return 0
  python3 - "$1" "$2" <<'PY' 2>/dev/null
import json, sys
try:
    node = json.load(open(sys.argv[1]))
    for key in sys.argv[2].split("."):
        node = node[key]
except Exception:
    sys.exit(0)
print(" ".join(map(str, node)) if isinstance(node, list) else node)
PY
}

# unit.toml is a strict subset of TOML so sed can read it: `key = "value"` and
# `key = ["a", "b"]`, one per line, no tables, no multi-line values.
toml_get() {
  local file="$1" key="$2"
  [[ -f $file ]] || return 0
  sed -n "s/^[[:space:]]*$key[[:space:]]*=[[:space:]]*\"\(.*\)\"[[:space:]]*$/\1/p" "$file" | head -1
}

# paste -sd', ' cycles through the delimiter list one character at a time, so it
# joins with a comma, then a space, then a comma. Join here instead.
join_lines() { paste -sd, - | sed 's/,/, /g'; }

toml_list() {
  local file="$1" key="$2" raw
  [[ -f $file ]] || return 0
  raw=$(sed -n "s/^[[:space:]]*$key[[:space:]]*=[[:space:]]*\[\(.*\)\][[:space:]]*$/\1/p" "$file" | head -1)
  [[ -z $raw ]] && return 0
  printf '%s' "$raw" | tr ',' '\n' | sed 's/^[[:space:]]*"\?//; s/"\?[[:space:]]*$//' | grep -v '^$'
}

# ---------------------------------------------------------------- units
#
# A ref is `marketplace/unit`. Everything below takes a full ref; resolve_ref
# turns whatever the user typed into one.

ref_market() { printf '%s' "${1%%/*}"; }
ref_unit() { printf '%s' "${1##*/}"; }

ref_dir() {
  local root unit
  root=$(market_root "$(ref_market "$1")") || return 1
  unit=$(ref_unit "$1")

  # A wrapped Omarchy plugin keeps its generated unit under .bo, so the author's
  # tree stays exactly as they published it.
  if [[ -f "$root/.bo/units/$unit/unit.toml" ]]; then
    printf '%s/.bo/units/%s' "$root" "$unit"
    return 0
  fi

  printf '%s/units/%s' "$root" "$unit"
}

ref_exists() {
  local dir
  dir=$(ref_dir "$1") || return 1
  [[ -f "$dir/unit.toml" ]]
}

# Every ref across every marketplace.
all_refs() {
  local root name dir
  while read -r root; do
    name=$(market_name "$root")

    for dir in "$root"/units/*/ "$root"/.bo/units/*/; do
      [[ -f "$dir/unit.toml" ]] || continue
      printf '%s/%s\n' "$name" "$(basename "$dir")"
    done
  done < <(market_roots)
}

resolve_ref() {
  local q="$1" hits n
  if [[ $q == */* ]]; then
    ref_exists "$q" && {
      printf '%s' "$q"
      return 0
    }
    die "no unit '$q'"
  fi

  hits=$(all_refs | awk -F/ -v u="$q" '$NF == u')
  n=$(printf '%s' "$hits" | grep -c .)
  case "$n" in
  1)
    printf '%s' "$hits"
    return 0
    ;;
  0) ;;
  *) die "'$q' exists in several marketplaces: $(printf '%s' "$hits" | tr '\n' ' '). Name one." ;;
  esac

  # Nothing exact: fall back to a substring match so a half-typed name works.
  hits=$(all_refs | grep -F "$q")
  n=$(printf '%s' "$hits" | grep -c .)
  case "$n" in
  1) printf '%s' "$hits" ;;
  0) die "no unit matching '$q'. Try: bo list" ;;
  *) die "'$q' matches: $(printf '%s' "$hits" | tr '\n' ' ')" ;;
  esac
}

meta() { toml_get "$(ref_dir "$1")/unit.toml" "$2"; }
meta_list() { toml_list "$(ref_dir "$1")/unit.toml" "$2"; }

# Fields only the registry knows: the content hash, the commit, the date.
reg() {
  local root
  root=$(market_root "$(ref_market "$1")") || return 0
  json_get "$root/registry.json" "units.$(ref_unit "$1").$2"
}

# ---------------------------------------------------------------- state

is_linked() { grep -qxF "$1" "$LINKED_FILE"; }
mark_linked() { is_linked "$1" || printf '%s\n' "$1" >>"$LINKED_FILE"; }

mark_unlinked() {
  local tmp
  tmp=$(mktemp)
  grep -vxF "$1" "$LINKED_FILE" >"$tmp"
  mv "$tmp" "$LINKED_FILE"
}

linked_refs() { grep -v '^[[:space:]]*$' "$LINKED_FILE"; }

# What version and content hash a unit was at when it was linked, so `bo
# outdated` compares without re-hashing the tree.
record_installed() {
  python3 - "$INSTALLED" "$1" "$(reg "$1" version)" "$(reg "$1" hash)" <<'PY'
import json, sys
path, ref, version, digest = sys.argv[1:5]
try:
    data = json.load(open(path))
except Exception:
    data = {}
data[ref] = {"version": version, "hash": digest}
json.dump(data, open(path, "w"), indent=2)
PY
}

forget_installed() {
  python3 - "$INSTALLED" "$1" <<'PY'
import json, sys
path, ref = sys.argv[1:3]
try:
    data = json.load(open(path))
except Exception:
    data = {}
data.pop(ref, None)
json.dump(data, open(path, "w"), indent=2)
PY
}

installed_field() {
  python3 - "$INSTALLED" "$1" "$2" <<'PY' 2>/dev/null
import json, sys
try:
    print(json.load(open(sys.argv[1]))[sys.argv[2]][sys.argv[3]])
except Exception:
    pass
PY
}

# ---------------------------------------------------------------- snapshots
#
# The contract a unit keeps with the machine it is installed on: everything it
# changes is written down before it changes it, and removing it puts that back.
#
# Two halves, because two different people know two different things.
#
#   What bo can see, bo records without being told. Every path a unit will link
#   into place is read first: its bytes, or the fact that nothing was there.
#   A unit that only links files needs to declare nothing and is still fully
#   reversible.
#
#   What only the author knows is declared, in `touches`, one line of
#   `kind:key` entries. That covers the things bo cannot infer by looking at the
#   unit directory: a bar widget this unit stands in for, a value in shell.json,
#   a command on PATH it shadows.
#
#   touches = ["barwidget:omarchy.workspaces", "shelljson:bar.position"]
#
# Both are read again after the install finishes, so the manifest holds a
# `before` and an `after` for every item. That pair is what makes removal safe:
# if what is there now matches what the unit left, the unit still owns it and
# the `before` goes back; if it does not, somebody changed it on purpose since,
# and it is left alone and said so.
#
# Absent is a value. A file that did not exist before is recorded as absent and
# restoring deletes it. A bar widget that was on the bar before and gone after
# is put back where it was, which is the whole of the workspaces bug in its
# general form.
#
# Every captured value carries a sha256, checked on the way back out, so a
# snapshot somebody edited by hand or a truncated copy is refused rather than
# replayed over a working machine.
#
# A unit whose changes cannot be written down this way ships snapshot.sh and
# restore.sh. Each is handed a directory of its own and may put anything in it.
# Same contract, arbitrary content, and `bo info` says which of the three a unit
# is using.
#
# See docs/CONTRACT.md for the version a third party reads.

# What a unit promises about putting things back, said before it goes on and
# again in `bo info`. Three answers, and the third is the one worth reading.
snapshot_promise() {
  local ref="$1" dir
  dir=$(ref_dir "$ref") || return 0

  if [[ -x "$dir/snapshot.sh" && -x "$dir/restore.sh" ]]; then
    printf '  %s %s\n' "$(green "$(printf '%-6s' puts)")" \
      "everything back through its own snapshot.sh and restore.sh"
    return 0
  fi
  if [[ -n $(meta_list "$ref" touches) ]]; then
    printf '  %s %s\n' "$(green "$(printf '%-6s' puts)")" \
      "back what it links, and $(meta_list "$ref" touches | join_lines)"
    return 0
  fi
  printf '  %s %s\n' "$(green "$(printf '%-6s' puts)")" \
    "back every file it links. It declares nothing else, so anything it changes at runtime is its own to undo"
  return 0
}

snapshot_dir() { printf '%s/snapshots/%s/%s' "$STATE_DIR" "$(ref_market "$1")" "$(ref_unit "$1")"; }
has_snapshot() { [[ -f "$(snapshot_dir "$1")/manifest.json" ]]; }

# Everything bo will put its hands on, one `kind<TAB>key` per line. The links it
# is about to make, then whatever the unit declared on top.
snapshot_plan() {
  local ref="$1" dir file rel id
  dir=$(ref_dir "$ref") || return 0

  shopt -s nullglob
  for file in "$dir"/bin/*; do
    printf 'file\t%s\n' "$BIN_DIR/$(basename "$file")"
  done
  for file in "$dir"/hypr/*.lua; do
    printf 'file\t%s\n' "$HYPR_MODULES/$(hypr_link_name "$ref" "$file")"
    [[ $(basename "$file") == "monitors.lua" ]] &&
      printf 'file\t%s\n' "$HYPR_DIR/monitors.lua"
  done
  shopt -u nullglob

  while read -r rel; do
    [[ -n $rel ]] && printf 'file\t%s\n' "$CONFIG_HOME/$rel"
  done < <(config_files "$ref")

  if [[ $(meta "$ref" kind) == plugin ]]; then
    id=$(meta "$ref" id)
    [[ -n $id ]] && printf 'file\t%s\n' "$PLUGINS_DIR/$id"
  fi

  # `class:kind:key`. The class is the author decision and bo never guesses it:
  # a keybinding that exists before and after with a different meaning looks
  # identical to bo and is the one thing it must not get wrong.
  local item rest
  while read -r item; do
    [[ -z $item || $item != *:*:* ]] && continue
    rest="${item#*:}"
    printf '%s\t%s\t%s\n' "${item%%:*}" "${rest%%:*}" "${rest#*:}"
  done < <(meta_list "$ref" touches)
}

snapshot_run() {
  local ref="$1" mode="$2"
  BO_SNAP_MODE="$mode" BO_SNAP_REF="$ref" BO_SNAP_DIR="$(snapshot_dir "$ref")" \
    BO_SNAP_SHELL="$CONFIG_HOME/omarchy/shell.json" \
    BO_SNAP_VERSION="$(meta "$ref" version)" \
    BO_SNAP_STANDIN="$(meta "$ref" id)" \
    python3 -c "$SNAPSHOT_PY" 2>/dev/null
}

# Before anything is linked. Silent when a snapshot is already there, which is
# the install-twice case: the first one is the one that knows what the machine
# looked like.
snapshot_before() {
  local ref="$1" dir out
  dir=$(snapshot_dir "$ref")
  mkdir -p "$dir"
  out=$(snapshot_plan "$ref" | BO_SNAP_MODE=before BO_SNAP_REF="$ref" \
    BO_SNAP_DIR="$dir" BO_SNAP_SHELL="$CONFIG_HOME/omarchy/shell.json" \
    BO_SNAP_VERSION="$(meta "$ref" version)" \
    BO_SNAP_STANDIN="$(meta "$ref" id)" python3 -c "$SNAPSHOT_PY" 2>/dev/null)

  [[ $out == kept ]] && {
    say "  $(dim 'keeping the snapshot taken when this first went on')"
    return 0
  }
  [[ -n $out ]] && say "  $(dim "snapshot ${out#took } thing(s) this will touch")"

  # The escape hatch, for a unit whose changes are not any of the kinds above.
  local script="$(ref_dir "$ref")/snapshot.sh"
  [[ -x $script ]] && {
    mkdir -p "$dir/own"
    "$script" "$dir/own" >/dev/null 2>&1 ||
      warn "$ref snapshot.sh failed, so removing it may not put everything back"
  }
  return 0
}

snapshot_after() { snapshot_run "$1" after >/dev/null; return 0; }

# The other side. Anything the unit still owns goes back to what it displaced;
# anything changed since is left where it is and named.
# A rebinding, at the moment of removal. The old value is a stale opinion and
# the value in somebody fingers is the one the unit installed, so this is a
# question rather than a rollback: the user example is going back to a keybinding
# from four months ago and being lost.
#
# Three answers, and how long ago it was, because age is what tells you whether
# the old value still means anything.
rebound_choice() {
  local ref="$1" kind="$2" key="$3" before="$4" after="$5" taken="$6" age="" pick=""
  [[ -n $taken ]] && age=$(days_since "$taken")

  say ""
  say "  $(bold "$key") $(dim "changed by $(ref_unit "$ref")")"
  say "    was      $before"
  say "    is now   $after $(dim "${age:+since $age}")"

  if ((ASSUME_YES)) || ! interactive; then
    # Nobody to ask. Keeping what the machine does today loses nothing somebody
    # is currently relying on, and the old value is written down in the snapshot
    # for as long as they want it, so this is the answer that discards least.
    say "    $(green keeping) $(dim 'what it does now. bo diff shows what it was.')"
    return 0
  fi

  say ""
  say "    1  put back  $before"
  say "    2  keep      $after $(dim '(as it is now)')"
  say "    3  unbind it"
  printf '    choose [2] ' >/dev/tty
  read -r pick </dev/tty || pick=2
  case "${pick:-2}" in
  1) snapshot_put_one "$ref" "$kind" "$key" && say "    $(green 'put back') $before" ;;
  3) say "    $(dim 'left unbound')" ;;
  *) say "    $(green kept) $after" ;;
  esac
  return 0
}

snapshot_put_one() {
  BO_SNAP_ONE_KIND="$2" BO_SNAP_ONE_KEY="$3" snapshot_run "$1" putone >/dev/null
}

days_since() {
  local when="$1" then now days
  then=$(date -d "$when" +%s 2>/dev/null) || return 0
  now=$(date +%s)
  days=$(((now - then) / 86400))
  ((days < 1)) && { printf 'today'; return 0; }
  ((days == 1)) && { printf 'yesterday'; return 0; }
  ((days < 60)) && { printf '%s days ago' "$days"; return 0; }
  printf '%s months ago' "$((days / 30))"
}

snapshot_restore() {
  local ref="$1" dir line what kind key kept=0
  dir=$(snapshot_dir "$ref")
  has_snapshot "$ref" || return 0

  local script="$(ref_dir "$ref")/restore.sh"
  [[ -x $script && -d "$dir/own" ]] && {
    "$script" "$dir/own" >/dev/null 2>&1 ||
      warn "$ref restore.sh failed; $dir/own is left for you to look at"
  }

  local before after taken
  while IFS=$'\t' read -r what kind key before after taken; do
    case "$what" in
    restored | relinked) say "  $(green 'put back') $(dim "${key/#$HOME/~}")" ;;
    removed) say "  $(dim "took back ${key/#$HOME/~}")" ;;
    held)
      say "  $(yellow held) ${key/#$HOME/~} $(dim 'changed since this went on, so it is yours now')"
      ;;
    keeps)
      say "  $(cyan keeps) ${key/#$HOME/~} $(dim 'your own data, left alone; delete it yourself if you want to')"
      ;;
    refused) warn "the snapshot of $key does not match its hash, so it was not restored" ;;
    propose) rebound_choice "$ref" "$kind" "$key" "$before" "$after" "$taken" ;;
    esac
  done < <(snapshot_run "$ref" restore)

  rm -rf "$dir"
  rmdir "$(dirname "$dir")" 2>/dev/null
  return 0
}

# ---------------------------------------------------------------- link helpers

link_path() {
  local src="$1" dst="$2"

  if [[ -L $dst ]]; then
    [[ $(readlink -f "$dst") == "$(readlink -f "$src")" ]] && return 0
    die "$dst is a symlink to something else. Remove it first."
  fi

  if [[ -e $dst ]]; then
    local backup="$dst.before-bo.$(date +%s)"
    warn "$dst exists, moving it to $(basename "$backup")"
    mv "$dst" "$backup"
  fi

  mkdir -p "$(dirname "$dst")"
  ln -s "$src" "$dst"
}

# Remove a symlink only if it points into a marketplace we manage.
unlink_path() {
  local dst="$1" target root
  [[ -L $dst ]] || return 0
  target=$(readlink -f "$dst")
  while read -r root; do
    root=$(readlink -f "$root")
    # The root itself counts, not only paths under it: a wrapped Omarchy plugin
    # links its plugin folder to the repo root, so the resolved target is the
    # marketplace directory rather than something inside it.
    case "$target" in
    "$root" | "$root"/*)
      rm -f "$dst"
      restore_backup "$dst"
      return 0
      ;;
    esac
  done < <(market_roots)
  warn "$dst points outside every marketplace, leaving it alone"
}

# link_path moves anything already sitting at a path aside as `.before-bo.<ts>`.
# Nothing used to bring those back, so a remove left the path empty and the old
# file orphaned next to it. Put the newest one back instead.
restore_backup() {
  local dst="$1" newest had_nullglob=0
  [[ -e $dst || -L $dst ]] && return 0

  # Collected into an array rather than passed to `ls` as a glob. With nullglob
  # on, a pattern that matches nothing disappears entirely, `ls -1dt` is left
  # with no operand at all, and `-d` makes it answer `.`. That turned "there is
  # no backup" into `mv . <dst>`, which is how removing a unit printed
  # "cannot move '.': Device or resource busy" twice and left nothing restored.
  shopt -q nullglob && had_nullglob=1
  shopt -s nullglob
  local -a found=("$dst".before-bo.*)
  ((had_nullglob)) || shopt -u nullglob

  ((${#found[@]})) || return 0
  newest=$(ls -1dt "${found[@]}" 2>/dev/null | head -1)
  [[ -n $newest && -e $newest ]] || return 0
  mv "$newest" "$dst" && say "  $(dim "put your own $(basename "$dst") back")"
}

shell_running() { pgrep -f '[q]uickshell.*omarchy' >/dev/null; }

rescan_plugins() {
  shell_running || return 0
  omarchy-shell shell rescanPlugins >/dev/null 2>&1
}

reload_hypr() {
  command -v hyprctl >/dev/null || return 0
  hyprctl reload >/dev/null 2>&1
}

# ---------------------------------------------------------------- linking

plugin_in_layout() {
  python3 - "$1" <<'PY' 2>/dev/null
import json, os, sys
try:
    layout = json.load(open(os.path.expanduser("~/.config/omarchy/shell.json")))["bar"]["layout"]
except Exception:
    sys.exit(1)
sys.exit(0 if any(w.get("id") == sys.argv[1] for s in layout.values() for w in s) else 1)
PY
}

# Where a widget sits and how much of it the user typed, as `section<TAB>count`.
# The count is the settings on the entry, everything but the id, and it is what
# makes the difference between a stale line and a thing worth keeping.
plugin_layout_place() {
  python3 - "$1" <<'PY' 2>/dev/null
import json, os, sys
try:
    layout = json.load(open(os.path.expanduser("~/.config/omarchy/shell.json")))["bar"]["layout"]
except Exception:
    sys.exit(1)
for section, widgets in layout.items():
    for widget in widgets:
        if widget.get("id") == sys.argv[1]:
            print(f"{section}\t{len(widget) - 1}")
            sys.exit(0)
sys.exit(1)
PY
}

# One copy of shell.json before we write to it. The shell rewrites this file
# whole rather than editing it, so a wrong edit is not something you undo by
# hand, and `bo remove --purge` throws away settings nothing else has a copy of.
backup_shell_json() {
  local config="$CONFIG_HOME/omarchy/shell.json" copy
  [[ -f $config ]] || return 0
  copy="$config.before-bo.$(date +%s)"
  [[ -e $copy ]] || cp -p "$config" "$copy"

  # Three, newest first. One copy per layout write piles up fast now that a unit
  # standing in for a stock widget writes on both add and remove, and a
  # directory of forty identical shell.json copies is its own kind of leftover.
  local -a old=()
  shopt -s nullglob
  old=("$config".before-bo.*)
  shopt -u nullglob
  ((${#old[@]} > 3)) &&
    printf '%s\n' "${old[@]}" | sort -r | tail -n +4 | while read -r stale; do
      rm -f "$stale"
    done

  printf '%s' "$copy"
}

# Drops a widget's whole layout entry, position and settings with it. Only
# reached through `bo remove --purge`, and only after saying what goes.
purge_layout_entry() {
  local id="$1" config="$CONFIG_HOME/omarchy/shell.json"
  [[ -f $config ]] || return 0

  python3 - "$config" "$id" <<'PY'
import json, sys
path, wanted = sys.argv[1:3]
try:
    config = json.load(open(path))
    layout = config["bar"]["layout"]
except Exception:
    raise SystemExit(0)

for section, widgets in layout.items():
    layout[section] = [w for w in widgets if w.get("id") != wanted]

with open(path, "w") as handle:
    json.dump(config, handle, indent=2)
    handle.write("\n")
PY

  shell_running && omarchy-shell shell reloadConfig >/dev/null 2>&1
  return 0
}

# Takes the bar slot a unit declares it stands in for, recording verbatim what
# was in it. Prints `placed` when it put the unit's own widget in that slot.
# Hands the slot back on the way out.
link_plugin() {
  local ref="$1" dir id
  dir=$(ref_dir "$ref")
  id=$(meta "$ref" id)
  [[ -n $id ]] || die "$ref is kind=plugin but has no id"
  [[ -d "$dir/plugin" ]] || die "$ref has no plugin/ folder"

  link_path "$dir/plugin" "$PLUGINS_DIR/$id"
  rescan_plugins
  sleep 1
  shell_running || return 0

  # `plugin enable` appends the widget to its default section. Calling it on a
  # widget that is already placed would move it there and drop its settings, so
  # only enable one the layout has never seen.
  if plugin_in_layout "$id"; then
    say "  $(dim "$id keeps its bar position and settings")"
    reload_shell_config
    return 0
  fi

  omarchy plugin enable "$id" >/dev/null 2>&1 ||
    warn "linked $id but could not enable it; run: omarchy plugin enable $id"
}

reload_shell_config() {
  shell_running && omarchy-shell shell reloadConfig >/dev/null 2>&1
  return 0
}

unlink_plugin() {
  local ref="$1" id
  id=$(meta "$ref" id)
  [[ -n $id ]] || return 0

  # Deliberately no `plugin disable`: for a bar widget that command deletes its
  # layout entry, taking its position and every setting with it. Removing the
  # symlink is enough. The stale entry renders nothing while the plugin is gone,
  # and is what makes a later `bo add` restore the widget where it was.
  unlink_path "$PLUGINS_DIR/$id"

  # A widget's layout entry is worth keeping. Its entry in `plugins[]` is not:
  # that list is what the registry reads to decide a third-party plugin is on,
  # so leaving the id there means the shell keeps loading something whose files
  # are gone. A service plugin is the case that bites, since it has no layout
  # entry to notice and can leave the desktop in whatever state it last set.
  forget_plugin_enabled "$id"

  purge_plugin_layout "$ref"
  rescan_plugins
  reload_shell_config
}

# The one thing `bo remove` keeps that `omarchy plugin remove` would take. The
# rule is: take back what bo put there, keep what you arranged by hand. Which
# half is which gets said at the time rather than left for somebody to find in
# shell.json, and `--purge` takes the second half too, after asking.
purge_plugin_layout() {
  local ref="$1" id place section settings copy
  id=$(meta "$ref" id)
  [[ -n $id ]] || return 0

  place=$(plugin_layout_place "$id") || return 0
  section=${place%%$'\t'*}
  settings=${place##*$'\t'}

  ((PURGE)) || {
    say "  $(dim "kept $id in the bar layout ($section, $settings setting(s)); bo add puts the widget back there")"
    say "  $(dim "bo remove --purge $(ref_unit "$ref") takes that too")"
    return 0
  }

  say "  $(yellow 'purge') $id sits in the bar's $section section with $settings setting(s) on it"
  confirm "Delete that layout entry too? A later bo add cannot bring it back." || {
    say "  $(dim 'left the layout entry alone')"
    return 0
  }

  copy=$(backup_shell_json)
  [[ -n $copy ]] && say "  $(dim "shell.json copied to $(basename "$copy") first")"
  purge_layout_entry "$id"
}

# Whether shell.json's plugins[] carries this id. Asked before writing a backup,
# so a remove that changes nothing does not leave a copy of a file it never
# touched. Matching the id anywhere in the text would also hit a layout entry.
plugin_is_enabled_entry() {
  python3 - "$CONFIG_HOME/omarchy/shell.json" "$1" <<'PY' 2>/dev/null
import json, sys
try:
    plugins = json.load(open(sys.argv[1])).get("plugins") or []
except Exception:
    sys.exit(1)
def name(entry):
    return entry.get("id") if isinstance(entry, dict) else entry
sys.exit(0 if any(name(e) == sys.argv[2] for e in plugins) else 1)
PY
}

forget_plugin_enabled() {
  local id="$1" config="$CONFIG_HOME/omarchy/shell.json"
  [[ -f $config ]] || return 0

  plugin_is_enabled_entry "$id" && backup_shell_json >/dev/null

  BO_FORGET_ID="$id" BO_FORGET_CONFIG="$config" python3 -c "$FORGET_PLUGIN_PY"

  # The shell holds shell.json in memory and rewrites the whole file on every
  # mutation of its own. It watches for external changes, but until that reload
  # arrives any shell-side write is computed from the stale copy and takes this
  # one with it. Telling it to reload closes that window.
  shell_running && omarchy-shell shell reloadConfig >/dev/null 2>&1
  return 0
}

# Linked names carry the marketplace and the unit, so two units can ship a
# bindings.lua without colliding and `ls modules.d` says who owns what.
hypr_link_name() { printf '%s-%s-%s' "$(ref_market "$1")" "$(ref_unit "$1")" "$(basename "$2")"; }

link_hypr() {
  local ref="$1" file found=0
  shopt -s nullglob
  for file in "$(ref_dir "$ref")"/hypr/*.lua; do
    ((found++ == 0)) && {
      mkdir -p "$HYPR_MODULES"
      ensure_modules_loader
    }
    link_path "$file" "$HYPR_MODULES/$(hypr_link_name "$ref" "$file")"

    # monitors.lua is read by name, not just loaded. `omarchy-hyprland-monitor-clamshell`
    # runs on every wake and parses ~/.config/hypr/monitors.lua to learn the
    # scale to restore, falling back to a hardcoded 2 when that path does not
    # exist. A unit that owns the monitor config has to answer there too, or the
    # screen comes back from sleep at twice the size.
    if [[ $(basename "$file") == "monitors.lua" ]]; then
      link_path "$file" "$HYPR_DIR/monitors.lua"
    fi
  done
  shopt -u nullglob
  ((found > 0)) && reload_hypr
  return 0
}

unlink_hypr() {
  local ref="$1" file found=0
  shopt -s nullglob
  for file in "$(ref_dir "$ref")"/hypr/*.lua; do
    unlink_path "$HYPR_MODULES/$(hypr_link_name "$ref" "$file")"
    [[ $(basename "$file") == "monitors.lua" ]] && unlink_path "$HYPR_DIR/monitors.lua"
    ((found++))
  done
  shopt -u nullglob
  ((found > 0)) && {
    forget_modules_loader
    reload_hypr
  }
  return 0
}

# The other half of ensure_modules_loader. That function appends one require to
# hyprland.lua and writes a modules.lua beside it, and until now neither ever
# came back out: a machine that had tried better-omarchy and removed every unit
# still carried both, forever, with an empty modules.d underneath them.
#
# Only when the last linked lua is gone, and only what bo itself wrote. A
# modules.lua somebody has edited is left alone and said so.
forget_modules_loader() {
  local loader="$HYPR_DIR/modules.lua" main="$HYPR_DIR/hyprland.lua" tmp

  shopt -s nullglob
  local -a still=("$HYPR_MODULES"/*.lua)
  shopt -u nullglob
  ((${#still[@]} > 0)) && return 0

  rmdir "$HYPR_MODULES" 2>/dev/null

  if [[ -f $loader ]]; then
    if grep -q "Managed by better-omarchy" "$loader"; then
      rm -f "$loader"
    else
      warn "$loader has been edited, so it is left as it is"
      return 0
    fi
  fi

  [[ -f $main ]] || return 0
  grep -q 'require("hypr.modules")' "$main" || return 0

  # sed rather than a python pass, because the whole edit is two known lines:
  # the comment ensure_modules_loader wrote and the require under it. A file
  # where somebody added the require by hand loses only the require.
  if grep -q '^-- better-omarchy: load every linked unit' "$main"; then
    sed -i '/^-- better-omarchy: load every linked unit/,+1d' "$main"
  else
    sed -i '/^require("hypr\.modules")$/d' "$main"
  fi

  # Whatever blank lines that left at the end, back to one newline.
  printf '%s\n' "$(cat "$main")" >"$main.bo.tmp" && mv "$main.bo.tmp" "$main"
  say "  $(dim 'took the better-omarchy loader back out of hyprland.lua')"
  return 0
}

link_setting() {
  local script
  script="$(ref_dir "$1")/apply.sh"
  [[ -x $script ]] || die "$1 is kind=setting but has no executable apply.sh"
  "$script" || die "apply.sh failed for $1"
}

unlink_setting() {
  local script
  script="$(ref_dir "$1")/revert.sh"
  [[ -x $script ]] || {
    warn "$1 has no revert.sh, leaving the setting as it is"
    return 0
  }
  "$script" || warn "revert.sh failed for $1"
}

link_bin() {
  local file
  shopt -s nullglob
  for file in "$(ref_dir "$1")"/bin/*; do
    link_path "$file" "$BIN_DIR/$(basename "$file")"
  done
  shopt -u nullglob
}

# A unit's config/ mirrors into ~/.config, path for path. This is how a unit
# extends another program without bo knowing anything about it: a launcher
# extension is just config/omarchy/omacast/extensions/thing.json.
#
# Files link individually here, unlike a plugin folder, because two units will
# want to drop files into the same directory.
config_files() {
  local base
  base="$(ref_dir "$1")/config"
  [[ -d $base ]] || return 0
  find "$base" -type f -printf '%P\n' 2>/dev/null
}

link_config() {
  local ref="$1" rel base
  base="$(ref_dir "$ref")/config"
  while read -r rel; do
    [[ -z $rel ]] && continue
    link_path "$base/$rel" "$CONFIG_HOME/$rel"
  done < <(config_files "$ref")
}

unlink_config() {
  local ref="$1" rel dir
  while read -r rel; do
    [[ -z $rel ]] && continue
    unlink_path "$CONFIG_HOME/$rel"
    # Leave no empty directory behind that only existed for this unit.
    dir=$(dirname "$CONFIG_HOME/$rel")
    while [[ $dir != "$CONFIG_HOME" && $dir != "/" ]]; do
      rmdir "$dir" 2>/dev/null || break
      dir=$(dirname "$dir")
    done
  done < <(config_files "$ref")
}

unlink_bin() {
  local file
  shopt -s nullglob
  for file in "$(ref_dir "$1")"/bin/*; do
    unlink_path "$BIN_DIR/$(basename "$file")"
  done
  shopt -u nullglob
}

# One require line in hyprland.lua, plus a loader that walks modules.d. After
# this runs, adding a unit never edits a config file again.
ensure_modules_loader() {
  local loader="$HYPR_DIR/modules.lua" main="$HYPR_DIR/hyprland.lua"

  if [[ ! -f $loader ]]; then
    cat >"$loader" <<'LUA'
-- Loads every .lua in ~/.config/hypr/modules.d, in name order.
-- Managed by better-omarchy. Units link their files into that directory.
--
-- Two reasons this uses neither require() nor default.hypr.require_all:
--   require() turns every dot in a module name into a path separator, so
--     "hypr.modules.d.foo" would look for hypr/modules/d/foo.lua.
--   require_all runs `find -type f`, which does not match a symlink, and every
--     file in here is a symlink into a marketplace checkout.
-- dofile on an absolute path has neither problem, and always re-executes.

local dir = os.getenv("HOME") .. "/.config/hypr/modules.d"
local handle = io.popen("find -L '" .. dir .. "' -maxdepth 1 -name '*.lua' -printf '%f\\n' 2>/dev/null | sort")

if handle then
  for filename in handle:lines() do
    dofile(dir .. "/" .. filename)
  end
  handle:close()
end
LUA
  fi

  if [[ -f $main ]] && ! grep -q 'require("hypr.modules")' "$main"; then
    printf '\n-- better-omarchy: load every linked unit from ~/.config/hypr/modules.d\nrequire("hypr.modules")\n' >>"$main"
  fi
}

# ------------------------------------------------------------ what a unit runs
#
# `omarchy plugin add` never runs anything from the plugin, never executes an
# install hook and never asks for sudo. bo does run things: it puts a unit's
# bin/ on your PATH and runs a setting's apply.sh. That capability is the point
# of a unit, but it has to be agreed to rather than discovered afterwards.

# One `what<TAB>detail` line per thing that will execute. No output means a unit
# that only links files other programs read.
unit_runs() {
  local ref="$1" dir file names=()
  dir=$(ref_dir "$ref") || return 0

  shopt -s nullglob
  for file in "$dir"/bin/*; do names+=("$(basename "$file")"); done
  shopt -u nullglob

  # One line however many there are. omacast alone ships 42 commands, and a
  # prompt you have to scroll is a prompt people answer without reading.
  if ((${#names[@]} > 6)); then
    printf 'PATH\t%s commands in %s, including %s\n' \
      "${#names[@]}" "$BIN_DIR" "$(printf '%s, ' "${names[@]:0:5}")and $((${#names[@]} - 5)) more"
  elif ((${#names[@]} > 0)); then
    printf 'PATH\t%s in %s\n' "$(printf '%s, ' "${names[@]}" | sed 's/, $//')" "$BIN_DIR"
  fi

  case "$(meta "$ref" kind)" in
  setting)
    [[ -f "$dir/apply.sh" ]] &&
      printf 'runs\tapply.sh, now, as you; revert.sh when you remove it\n'
    ;;
  plugin)
    printf 'runs\t%s inside omarchy-shell, unsandboxed, for as long as the shell lives\n' \
      "$(meta "$ref" id)"
    ;;
  esac
  return 0
}

unit_executes() { [[ -n $(unit_runs "$1") ]]; }

# Everything an add will do to this machine, printed before any of it happens.
unit_plan() {
  local ref="$1" dir file rel what detail
  dir=$(ref_dir "$ref")

  say "$(bold "$ref") $(dim "$(meta "$ref" version)")"
  say "  $(dim "$(meta "$ref" summary)")"

  [[ -d "$dir/plugin" ]] &&
    printf '  %-6s %s\n' links "plugin/  ->  $PLUGINS_DIR/$(meta "$ref" id)"

  shopt -s nullglob
  for file in "$dir"/hypr/*.lua; do
    printf '  %-6s %s\n' links \
      "hypr/$(basename "$file")  ->  $HYPR_MODULES/$(hypr_link_name "$ref" "$file")"
  done
  shopt -u nullglob

  local configs
  configs=$(config_files "$ref" | wc -l)
  if ((configs > 3)); then
    printf '  %-6s %s\n' links "$configs files from config/ into $CONFIG_HOME, path for path"
  else
    while read -r rel; do
      [[ -z $rel ]] && continue
      printf '  %-6s %s\n' links "config/$rel  ->  $CONFIG_HOME/$rel"
    done < <(config_files "$ref")
  fi

  while IFS=$'\t' read -r what detail; do
    [[ -z $what ]] && continue
    printf '  %s %s\n' "$(yellow "$(printf '%-6s' "$what")")" "$detail"
  done < <(unit_runs "$ref")
}

# `conflicts` and `requires` name bare unit names, not refs, because a unit
# author cannot know which marketplace a user got the other one from. Both are
# resolved against whatever is available here.
check_conflicts() {
  local ref="$1" other resolved
  while read -r other; do
    [[ -z $other ]] && continue
    resolved=$(all_refs | awk -F/ -v u="$other" '$NF == u' | head -1)
    [[ -n $resolved ]] || continue
    is_linked "$resolved" &&
      die "$ref conflicts with $resolved, which is on. Turn that off first: bo remove $resolved"
  done < <(meta_list "$ref" conflicts)
}

check_requires() {
  local ref="$1" other resolved
  while read -r other; do
    [[ -z $other ]] && continue
    resolved=$(all_refs | awk -F/ -v u="$other" '$NF == u' | head -1)
    [[ -n $resolved ]] || die "$ref needs a unit called '$other', and no marketplace here has one"
    is_linked "$resolved" || {
      say "  $(dim "$ref needs $resolved, turning that on first")"
      # A dependency gets asked about on its own terms, and saying no to it is
      # saying no to the unit that wanted it.
      link_unit "$resolved" || die "$ref needs $resolved, which was not turned on"
    }
  done < <(meta_list "$ref" requires)
}

link_unit() {
  local ref="$1" kind
  ref_exists "$ref" || die "no unit '$ref'"
  is_linked "$ref" && {
    say "$ref is already on"
    return 0
  }

  check_conflicts "$ref"

  # A unit that only links files other programs read is not worth a question.
  # One that executes gets its plan printed either way, so even a `--yes` run
  # leaves a record of what it was allowed to run.
  if unit_executes "$ref"; then
    unit_plan "$ref"
    snapshot_promise "$ref"
    ((ASSUME_YES)) || {
      say "  $(dim 'none of this is sandboxed. Read the code if you have not.')"
      confirm "Turn on $(ref_unit "$ref")?" || {
        say "$(dim skipped) $ref"
        return 1
      }
    }
  fi

  check_requires "$ref"

  # Before anything is touched. Every path this is about to link is read first,
  # and so is whatever the unit declared in `touches`.
  snapshot_before "$ref"

  # Every unit may carry hypr/ and bin/, whatever its kind: a bar widget that
  # also wants a keybinding is normal. kind only decides the extra step.
  kind=$(meta "$ref" kind)
  case "$kind" in
  plugin) link_plugin "$ref" ;;
  setting) link_setting "$ref" ;;
  hypr) ;;
  *) die "$ref has an unknown kind: '${kind:-<empty>}'" ;;
  esac

  link_hypr "$ref"
  link_bin "$ref"
  link_config "$ref"
  mark_linked "$ref"
  record_installed "$ref"

  # And again now it is on, so removal can tell what this unit left behind from
  # what somebody changed afterwards.
  snapshot_after "$ref"
  say "$(green on) $ref $(dim "$(meta "$ref" version)")"
}

unlink_unit() {
  local ref="$1" kind
  ref_exists "$ref" || die "no unit '$ref'"
  kind=$(meta "$ref" kind)

  is_linked "$ref" || {
    say "$ref is already off"
    # --purge on a unit that is already off is the second half of a remove
    # somebody already did: that message is exactly when they read that the
    # widget was still in the bar.
    ((PURGE)) && [[ $kind == plugin ]] && {
      purge_plugin_layout "$ref"
      rescan_plugins
    }
    return 0
  }

  case "$kind" in
  plugin) unlink_plugin "$ref" ;;
  setting) unlink_setting "$ref" ;;
  esac

  unlink_hypr "$ref"
  unlink_bin "$ref"
  unlink_config "$ref"

  # Last, so the links are gone before what they displaced goes back.
  snapshot_restore "$ref"
  reload_shell_config

  mark_unlinked "$ref"
  forget_installed "$ref"
  say "$(dim off) $ref"
}

# ---------------------------------------------------------------- browsing

# `bo list --json`: the same units `bo list` prints, for a program instead of a
# person. Everything here is already known to bo; nothing is re-derived.
#
# Three fields exist only in this form, because they are the ones a caller
# cannot work out on its own without reimplementing half of this file:
#
#   missing    the `needs` commands that are not on this machine. `bo doctor`
#              applies the same rule, but only to units that are already on,
#              because that is the question a person asks in a terminal. A
#              caller drawing units it might offer to turn on has to ask it of
#              every unit, and asking it here keeps one answer to one question.
#   blockedBy  a linked unit this one `conflicts` with, resolved to a real ref
#              rather than the bare name unit.toml carries.
#   restarts   whether turning this on or off reloads the shell. It is true for
#              exactly the plugin kind, because link_plugin calls rescanPlugins
#              and nothing else does. A caller that lives inside the shell has
#              to know which toggles will destroy it before it offers them.
#
# `available` is the two-field summary those first two add up to: false means
# `bo add` would fail, so do not offer it.
cmd_list_json() {
  local ref toml refs need other resolved missing blocked
  local US=$'\037'
  local -A KIND_OF=() SOURCE_OF=() BEHIND_OF=()

  # Every conflict has to be resolved against every ref, and `bo list` already
  # costs half a second walking marketplaces through python. Reading all_refs
  # once here rather than once per conflict is the difference between a command
  # a launcher can run on a keystroke and one it cannot.
  refs=$(all_refs)

  {
    while read -r ref; do
      # ref_dir goes through market_root, which reads a registry.json through
      # python. Once per unit, not once per field: meta and meta_list would
      # each pay it again, and eleven fields is eleven python starts a unit.
      toml="$(ref_dir "$ref")/unit.toml"

      missing=""
      while read -r need; do
        [[ -z $need ]] && continue
        command -v "$need" >/dev/null 2>&1 && continue
        missing+="$need$US"
      done < <(toml_list "$toml" needs)

      blocked=""
      while read -r other; do
        [[ -z $other ]] && continue
        resolved=$(printf '%s\n' "$refs" | awk -F/ -v u="$other" '$NF == u' | head -1)
        [[ -n $resolved ]] || continue
        is_linked "$resolved" && blocked+="$resolved$US"
      done < <(toml_list "$toml" conflicts)

      # Kind, source and how far behind belong to the marketplace, not the unit,
      # so they are worked out once per marketplace and carried on every unit
      # of it. A caller drawing a unit has to be able to say where it came from
      # without a second pass over the marketplaces.
      local market
      market=$(ref_market "$ref")
      if [[ -z ${KIND_OF[$market]:-} ]]; then
        local mroot
        mroot=$(market_root "$market") || mroot=""
        KIND_OF[$market]=$([[ -n $mroot ]] && market_kind "$mroot" || printf unknown)
        SOURCE_OF[$market]=$([[ -n $mroot ]] && market_source "$mroot" || printf '')
        BEHIND_OF[$market]=$([[ -n $mroot ]] && market_behind "$mroot" || printf 0)
      fi

      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$ref" "${toml%/unit.toml}" "$(ref_market "$ref")" \
        "${KIND_OF[$market]}" "${SOURCE_OF[$market]}" "${BEHIND_OF[$market]:-0}" \
        "$(ref_unit "$ref")" \
        "$(toml_get "$toml" summary)" "$(toml_get "$toml" version)" \
        "$(toml_get "$toml" kind)" "$(toml_get "$toml" category)" \
        "$(toml_get "$toml" id)" "$(toml_get "$toml" author)" \
        "$(toml_list "$toml" tags | tr '\n' "$US")" \
        "$(toml_list "$toml" needs | tr '\n' "$US")" "$missing" \
        "$(toml_list "$toml" keys | tr '\n' "$US")" \
        "$(toml_list "$toml" requires | tr '\n' "$US")" \
        "$(toml_list "$toml" conflicts | tr '\n' "$US")" "$blocked" \
        "$(is_linked "$ref" && printf 1 || printf 0)" \
        "$(unit_executes "$ref" && printf 1 || printf 0)"
    done <<<"$refs"
  } | python3 -c "$LIST_JSON_PY"
  return 0
}

# Kept in a variable rather than a heredoc: this one is on the right of a pipe,
# and a heredoc would take over the stdin the pipe is feeding it.
LIST_JSON_PY='
import json, sys

FIELDS = ("ref", "path", "marketplace", "marketplaceKind", "marketplaceSource",
          "marketplaceBehind", "unit", "summary", "version", "kind", "category",
          "id", "author", "tags", "needs", "missing", "keys", "requires",
          "conflicts", "blockedBy", "on", "runs")
LISTS = {"tags", "needs", "missing", "keys", "requires", "conflicts", "blockedBy"}

out = []
for line in sys.stdin.read().split("\n"):
    if not line.strip():
        continue
    parts = line.split("\t")
    if len(parts) < len(FIELDS):
        continue
    unit = {}
    for name, raw in zip(FIELDS, parts):
        if name in LISTS:
            unit[name] = [x for x in raw.split("\x1f") if x]
        elif name in ("on", "runs"):
            unit[name] = raw == "1"
        elif name == "marketplaceBehind":
            try:
                unit[name] = int(raw or 0)
            except ValueError:
                unit[name] = 0
        else:
            unit[name] = raw
    unit["restarts"] = unit["kind"] == "plugin"
    unit["available"] = not unit["missing"] and not unit["blockedBy"]
    out.append(unit)

json.dump(out, sys.stdout, indent=2)
sys.stdout.write("\n")
'

cmd_list() {
  local ref state multi

  if [[ ${1:-} == "--json" ]]; then
    cmd_list_json
    return 0
  fi

  # `--plain` drops the colour and the header, so something piping this into a
  # picker can read the unit name off the front of a line rather than stripping
  # escape codes out of it.
  if [[ ${1:-} == "--plain" ]]; then
    while read -r ref; do
      printf '%-22s %s\n' "$(ref_unit "$ref")" "$(meta "$ref" summary)"
    done < <(all_refs)
    return 0
  fi

  multi=$(market_names | wc -l)

  # Second column is the one that matters before you type `bo add`: a `!` is a
  # unit that will run something, not just link a file somewhere.
  local mark any_runs=0
  printf '%-30s %-9s %-13s %-7s %s\n' UNIT KIND CATEGORY VERSION SUMMARY
  while read -r ref; do
    if is_linked "$ref"; then state=$(green '●'); else state=$(dim '○'); fi
    if unit_executes "$ref"; then
      mark=$(yellow '!')
      any_runs=1
    else
      mark=' '
    fi
    printf '%s%s %-27s %-9s %-13s %-7s %s\n' \
      "$state" "$mark" "$([[ $multi -gt 1 ]] && printf '%s' "$ref" || ref_unit "$ref")" \
      "$(meta "$ref" kind)" "$(meta "$ref" category)" \
      "$(meta "$ref" version)" "$(meta "$ref" summary)"
  done < <(all_refs)

  ((any_runs)) &&
    say "$(yellow '!') $(dim 'runs code on this machine. bo info <unit> says exactly what, and bo add asks first.')"

  # Which of these are trees on this machine rather than clones bo can fetch.
  # It is the first thing a developer wants to know and the list said nothing
  # about it, so a checkout being edited looked identical to a pinned clone.
  local root locals=""
  while read -r root; do
    [[ $(market_kind "$root") == local ]] && locals+="$(market_name "$root") "
  done < <(market_roots)
  [[ -n $locals ]] &&
    say "$(cyan local) $(dim "${locals% } $([[ $(printf '%s' "$locals" | wc -w) -gt 1 ]] && printf 'are trees' || printf 'is a tree') on this machine. bo market list says where.")"
  return 0
}

cmd_search() {
  (($# > 0)) || die "usage: bo search <term>"
  local q="${*,,}" ref hay n=0
  while read -r ref; do
    hay="$ref $(meta "$ref" summary) $(meta "$ref" category) $(meta_list "$ref" tags | tr '\n' ' ')"
    [[ ${hay,,} == *"$q"* ]] || continue
    printf '%-30s %s\n' "$ref" "$(meta "$ref" summary)"
    ((n++))
  done < <(all_refs)
  ((n == 0)) && say "Nothing matches '$*'."
  return 0
}

cmd_info() {
  (($# > 0)) || die "usage: bo info <unit>"
  local ref
  ref=$(resolve_ref "$1")

  printf '%s %s\n' "$(bold "$ref")" "$(dim "$(meta "$ref" version)")"
  printf '  %s\n\n' "$(meta "$ref" summary)"
  local unit_root unit_kind
  unit_root=$(market_root "$(ref_market "$ref")") || unit_root=""
  unit_kind=$([[ -n $unit_root ]] && market_kind "$unit_root" || printf '')
  printf '  %-11s %s %s\n' marketplace "$(ref_market "$ref")" \
    "$([[ $unit_kind == local ]] && cyan '(local)' || { [[ -n $unit_kind ]] && dim '(remote)'; })"
  printf '  %-11s %s\n' kind "$(meta "$ref" kind)"
  printf '  %-11s %s\n' category "$(meta "$ref" category)"
  printf '  %-11s %s\n' tags "$(meta_list "$ref" tags | join_lines)"
  printf '  %-11s %s\n' author "$(meta "$ref" author)"
  [[ -n $(meta "$ref" id) ]] && printf '  %-11s %s\n' "plugin id" "$(meta "$ref" id)"
  printf '  %-11s %s\n' needs "$(meta_list "$ref" needs | join_lines)"
  printf '  %-11s %s\n' keys "$(meta_list "$ref" keys | join_lines)"
  [[ -n $(meta_list "$ref" requires) ]] &&
    printf '  %-11s %s\n' requires "$(meta_list "$ref" requires | join_lines)"
  [[ -n $(meta_list "$ref" conflicts) ]] &&
    printf '  %-11s %s\n' conflicts "$(meta_list "$ref" conflicts | join_lines)"
  [[ -n $(meta_list "$ref" touches) ]] &&
    printf '  %-11s %s\n' touches "$(meta_list "$ref" touches | join_lines)"

  local updated
  updated=$(reg "$ref" updated)
  if [[ -n $updated ]]; then
    printf '\n  %-11s %s\n' updated "$updated"
    printf '  %-11s %s\n' commit "$(reg "$ref" commit | cut -c1-12)"
    printf '  %-11s %s\n' hash "$(reg "$ref" hash | cut -c1-16)"
    printf '  %-11s %s\n' files "$(reg "$ref" files)"
  fi

  # The part `omarchy plugin add` would never do, spelled out before you add it.
  local what detail first=1
  while IFS=$'\t' read -r what detail; do
    [[ -z $what ]] && continue
    ((first)) && printf '\n  %s\n' "$(yellow 'runs code')" && first=0
    printf '    %-5s %s\n' "$what" "$detail"
  done < <(unit_runs "$ref")

  printf '\n  %-11s %s\n' state "$(is_linked "$ref" && green on || dim off)"
  printf '  %-11s %s\n' path "$(ref_dir "$ref")"
}

cmd_status() {
  local ref key seen="" dupes=""

  say "$(bold 'Linked units')"
  if [[ -z $(linked_refs) ]]; then
    say "  none"
  else
    while read -r ref; do
      ref_exists "$ref" || {
        say "  $ref $(red '(gone from its marketplace)')"
        continue
      }
      printf '  %-30s %-7s %s\n' "$ref" "$(dim "$(meta "$ref" version)")" "$(meta "$ref" summary)"
    done < <(linked_refs)
  fi

  # Two linked units claiming the same key is the failure this catches.
  while read -r ref; do
    ref_exists "$ref" || continue
    while read -r key; do
      [[ -z $key ]] && continue
      printf '%s\n' "$seen" | grep -qxF "$key" && dupes+="$key"$'\n'
      seen+="$key"$'\n'
    done < <(meta_list "$ref" keys)
  done < <(linked_refs)

  printf '\n%s\n' "$(bold 'Key conflicts')"
  if [[ -z $dupes ]]; then
    say "  none"
  else
    printf '%s' "$dupes" | sort -u | while read -r key; do
      [[ -z $key ]] && continue
      printf '  %s %s claimed by:' "$(red '!')" "$key"
      while read -r ref; do
        ref_exists "$ref" || continue
        meta_list "$ref" keys | grep -qxF "$key" && printf ' %s' "$ref"
      done < <(linked_refs)
      printf '\n'
    done
  fi
}

cmd_doctor() {
  local ref need missing=0
  while read -r ref; do
    ref_exists "$ref" || continue
    while read -r need; do
      [[ -z $need ]] && continue
      command -v "$need" >/dev/null && continue
      say "$(red missing) $need, needed by $ref"
      missing=1
    done < <(meta_list "$ref" needs)
  done < <(linked_refs)

  ((missing == 0)) && say "$(green 'All dependencies present.')"

  # What has changed since a unit went on. Not a fault: it is what removal will
  # decline to touch, and knowing that before you remove is the point.
  local kind key drifted=0
  while read -r ref; do
    ref_exists "$ref" || continue
    has_snapshot "$ref" || continue
    while IFS=$'\t' read -r kind key; do
      [[ -z $kind ]] && continue
      ((drifted == 0)) && say ""
      say "$(yellow changed) ${key/#$HOME/\~} $(dim "since $ref went on; bo remove will leave it alone")"
      drifted=1
    done < <(snapshot_run "$ref" drift)
  done < <(linked_refs)

  return $missing
}

# ---------------------------------------------------------------- add / remove

cmd_add() {
  parse_flags "$@"
  set -- ${ARGS[@]+"${ARGS[@]}"}

  local arg rc=0
  if (($# > 0)); then
    # A declined prompt is not success, so a script chaining onto `bo add` sees
    # the difference between "on" and "you were asked and said no".
    for arg in "$@"; do link_unit "$(resolve_ref "$arg")" || rc=1; done
    return $rc
  fi

  command -v gum >/dev/null || die "gum is not installed; pass unit names instead"

  local choices=() ref
  while read -r ref; do
    is_linked "$ref" && continue
    choices+=("$ref  ·  $(meta "$ref" summary)")
  done < <(all_refs)

  ((${#choices[@]} > 0)) || {
    say "Every unit is already on."
    return 0
  }

  local picked
  picked=$(printf '%s\n' "${choices[@]}" | gum choose --no-limit --header "Turn on which units?") || return 0
  while read -r line; do
    [[ -z $line ]] && continue
    link_unit "${line%%  ·  *}"
  done <<<"$picked"
}

cmd_remove() {
  parse_flags "$@"
  set -- ${ARGS[@]+"${ARGS[@]}"}

  local arg
  if (($# > 0)); then
    for arg in "$@"; do unlink_unit "$(resolve_ref "$arg")"; done
    return
  fi

  command -v gum >/dev/null || die "gum is not installed; pass unit names instead"

  local choices=() ref
  while read -r ref; do
    ref_exists "$ref" || continue
    choices+=("$ref  ·  $(meta "$ref" summary)")
  done < <(linked_refs)

  ((${#choices[@]} > 0)) || {
    say "Nothing is on."
    return 0
  }

  local picked
  picked=$(printf '%s\n' "${choices[@]}" | gum choose --no-limit --header "Turn off which units?") || return 0
  while read -r line; do
    [[ -z $line ]] && continue
    unlink_unit "${line%%  ·  *}"
  done <<<"$picked"
}

# ---------------------------------------------------------- marketplace admin

market_usage() {
  cat <<'TXT'
  bo market list                  every marketplace bo knows
  bo market add <git-url> [name]  clone one and start offering its units
  bo market link <path> [name]    point at a checkout here, without copying it
  bo market remove <name>         drop a cloned one (refuses while units are on)
  bo market unlink <name>         stop pointing at a linked checkout
  bo market update [name]         fetch and fast-forward
  bo market info <name>           where it came from and what it holds
TXT
}

cmd_market_list() {
  local root name kind count behind mark any_local=0

  # Kind is the second column because it is the one that changes what a line
  # means: the same repo pointed at locally and cloned from git are different
  # things to be running against, and a URL in the source column looked the
  # same either way.
  printf '%-22s %-7s %-7s %s\n' MARKETPLACE KIND UNITS SOURCE
  while read -r root; do
    name=$(market_name "$root")
    kind=$(market_kind "$root")
    count=$(find "$root/units" "$root/.bo/units" -maxdepth 2 -name unit.toml 2>/dev/null | wc -l)

    if [[ $kind == local ]]; then
      mark=$(cyan "$(printf '%-7s' local)")
      any_local=1
    else
      mark=$(dim "$(printf '%-7s' remote)")
    fi

    behind=$(market_behind "$root")
    printf '%-22s %s %-7s %s' "$name" "$mark" "$count" "$(market_source "$root")"
    [[ -n $behind && $behind != 0 ]] && printf ' %s' "$(yellow "($behind behind)")"
    printf '\n'

    [[ $(readlink -f "$root") == "$(readlink -f "$SELF_ROOT")" ]] &&
      printf '%s\n' "$(dim "  the checkout bo itself runs from")"
  done < <(market_roots)

  ((any_local)) &&
    say "$(cyan local) $(dim 'is a tree on this machine: editing it changes what is offered, and there is nothing to fetch.')"
  return 0
}

# Turn a cloned Omarchy plugin repo into a marketplace holding one unit.
#
# The plugin folder is the repo root, and a unit wants it under `plugin/`, so the
# generated unit links to it rather than copying: one checkout, one thing to
# update, and `bo remove` still only removes symlinks it made. The generated
# files live under .bo, so the author's tree is left exactly as published.
wrap_plugin_repo() {
  local root="$1" url="$2"
  local id name version author description unit

  id=$(json_get "$root/manifest.json" id)
  [[ -n $id ]] || {
    warn "that repo has a manifest.json with no id"
    return 1
  }

  name=$(json_get "$root/manifest.json" name)
  version=$(json_get "$root/manifest.json" version)
  author=$(json_get "$root/manifest.json" author)
  description=$(json_get "$root/manifest.json" description)

  # Named after the plugin without its author prefix, since the marketplace
  # already carries who it came from.
  unit="${id##*.}"

  mkdir -p "$root/.bo/units/$unit"
  # Relative, because the clone is staged under one name and moved to another:
  # an absolute link would point at the staging path and break on the move.
  ln -sfn ../../.. "$root/.bo/units/$unit/plugin"

  {
    printf '%-9s = "%s"\n' name "$unit"
    printf '%-9s = "%s"\n' summary "${description:-${name:-$id}}"
    printf '%-9s = "%s"\n' version "${version:-0.0.0}"
    printf '%-9s = "%s"\n' category "Other"
    printf '%-9s = "%s"\n' author "${author:-unknown}"
    printf '%-9s = "%s"\n' kind "plugin"
    printf '%-9s = "%s"\n' id "$id"
    printf '%-9s = []\n' needs
    printf '%-9s = []\n' keys
  } >"$root/.bo/units/$unit/unit.toml"

  # A generated registry, so everything downstream reads one shape. No content
  # hash: the author never asked to be in a registry, and hashing a tree we did
  # not generate would go stale on their next commit for no gain.
  BO_WRAP_ROOT="$root" BO_WRAP_UNIT="$unit" BO_WRAP_ID="$id" \
  BO_WRAP_NAME="${name:-$id}" BO_WRAP_VERSION="${version:-0.0.0}" \
  BO_WRAP_AUTHOR="${author:-unknown}" BO_WRAP_DESC="$description" \
  BO_WRAP_URL="$url" python3 -c "$WRAP_REGISTRY_PY"
}

cmd_market_add() {
  (($# > 0)) || die "usage: bo market add <git-url> [name]"
  local url="$1" name="${2:-}" tmp

  command -v git >/dev/null || die "git is not installed"

  # Clone to a staging directory first: the registry decides the final name, and
  # a repo with no registry.json is not a marketplace.
  tmp="$MARKETS_DIR/.add.$$"
  rm -rf "$tmp"
  say "Cloning $url ..."
  git clone --quiet --depth 50 "$url" "$tmp" || {
    rm -rf "$tmp"
    die "clone failed"
  }

  # A plain Omarchy plugin repo has a manifest.json at its root and no registry.
  # Rather than turning it away, wrap it as a marketplace of one unit, so an
  # existing plugin installs and removes through bo with nothing changed by its
  # author. This is the only place bo knows what an Omarchy plugin is.
  if [[ ! -f "$tmp/registry.json" && -f "$tmp/manifest.json" ]]; then
    wrap_plugin_repo "$tmp" "$url" || {
      rm -rf "$tmp"
      return 1
    }
  fi

  [[ -f "$tmp/registry.json" ]] || {
    rm -rf "$tmp"
    die "that repo has neither a registry.json nor a manifest.json at its root, so it is neither a marketplace nor an Omarchy plugin"
  }

  [[ -n $name ]] || name=$(json_get "$tmp/registry.json" name)
  [[ -n $name ]] || {
    rm -rf "$tmp"
    die "its registry.json has no \"name\", so pass one: bo market add <url> <name>"
  }

  if market_root "$name" >/dev/null; then
    rm -rf "$tmp"
    die "a marketplace named '$name' is already here"
  fi

  mv "$tmp" "$MARKETS_DIR/$name"
  say "$(green added) $name $(dim "$(json_get "$MARKETS_DIR/$name/registry.json" homepage)")"
  say "$(find "$MARKETS_DIR/$name/units" "$MARKETS_DIR/$name/.bo/units" -maxdepth 2 -name unit.toml 2>/dev/null | wc -l) units. Run: bo list"

  # Code from a marketplace runs on this machine, so say so once, plainly.
  say ""
  say "$(yellow 'A marketplace is code you are about to run.') Its units link scripts into"
  say "your PATH and QML into your shell. Read what you turn on."
}

# Point at a checkout instead of cloning one. The path is recorded and nothing
# is copied, so the marketplace is the working tree: edit a unit and the next
# `bo list` says so. This is the half of "local" that did not exist, since the
# only local marketplace used to be whichever checkout bo happened to run from.
cmd_market_link() {
  (($# > 0)) || die "usage: bo market link <path> [name]"
  local path="$1" name="${2:-}"

  path=$(readlink -f "$path" 2>/dev/null) || die "no such path: $1"
  [[ -d $path ]] || die "no such directory: $1"
  [[ -f "$path/registry.json" ]] ||
    die "$path has no registry.json at its root, so it is not a marketplace. Run: bo registry"

  [[ -n $name ]] || name=$(json_get "$path/registry.json" name)
  [[ -n $name ]] || die "its registry.json has no \"name\", so pass one: bo market link <path> <name>"

  if market_root "$name" >/dev/null; then
    die "a marketplace named '$name' is already here. Run: bo market list"
  fi

  mkdir -p "$DATA_DIR"
  touch "$LOCAL_FILE"
  grep -qxF "$path" "$LOCAL_FILE" || printf '%s\n' "$path" >>"$LOCAL_FILE"

  say "$(green linked) $name $(cyan local) $(dim "$path")"
  say "$(find "$path/units" "$path/.bo/units" -maxdepth 2 -name unit.toml 2>/dev/null | wc -l) units. Run: bo list"
  say ""
  say "$(yellow 'This is a tree you can edit.') Its units link into your PATH and your"
  say "shell from where they sit, so a change here is live the next time one runs."
}

cmd_market_unlink() {
  (($# > 0)) || die "usage: bo market unlink <name>"
  local name="$1" root ref on=0 tmp
  root=$(market_root "$name") || die "no marketplace named '$name'"

  [[ $(market_kind "$root") == local ]] ||
    die "'$name' was cloned by bo, so it is removed rather than unlinked: bo market remove $name"
  [[ $(readlink -f "$root") == "$(readlink -f "$SELF_ROOT")" ]] &&
    die "'$name' is the checkout bo itself runs from; it is registered by being where bo lives"

  while read -r ref; do
    [[ $(ref_market "$ref") == "$name" ]] && {
      say "  still on: $ref"
      on=1
    }
  done < <(linked_refs)
  ((on == 1)) && die "turn those off first: bo remove <unit>"

  tmp=$(mktemp)
  grep -vxF "$(readlink -f "$root")" "$LOCAL_FILE" 2>/dev/null >"$tmp"
  mv "$tmp" "$LOCAL_FILE"
  say "$(dim unlinked) $name $(dim "the tree at $root is untouched")"
}

cmd_market_remove() {
  (($# > 0)) || die "usage: bo market remove <name>"
  local name="$1" root ref on=0
  root=$(market_root "$name") || die "no marketplace named '$name'"

  [[ $(readlink -f "$root") == "$(readlink -f "$SELF_ROOT")" ]] &&
    die "'$name' is the checkout bo itself runs from; removing it would remove bo"

  while read -r ref; do
    [[ $(ref_market "$ref") == "$name" ]] && {
      say "  still on: $ref"
      on=1
    }
  done < <(linked_refs)
  ((on == 1)) && die "turn those off first: bo remove <unit>"

  case "$(readlink -f "$root")" in
  "$(readlink -f "$MARKETS_DIR")"/*) ;;
  *) die "'$name' is a tree bo never copied. Stop pointing at it with: bo market unlink $name" ;;
  esac

  rm -rf "$root"
  say "$(dim removed) $name"
}

cmd_market_info() {
  (($# > 0)) || die "usage: bo market info <name>"
  local root
  root=$(market_root "$1") || die "no marketplace named '$1'"

  local kind behind
  kind=$(market_kind "$root")
  behind=$(market_behind "$root")

  printf '%s\n' "$(bold "$(market_name "$root")")"
  printf '  %-11s %s\n' kind \
    "$([[ $kind == local ]] && cyan local || dim remote)"
  printf '  %-11s %s\n' homepage "$(json_get "$root/registry.json" homepage)"
  printf '  %-11s %s\n' source "$(market_source "$root")"
  printf '  %-11s %s\n' path "$root"
  [[ -n $behind && $behind != 0 ]] &&
    printf '  %-11s %s\n' behind "$(yellow "$behind commit(s). Run: bo market update $1")"
  printf '  %-11s %s\n' commit "$(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo '-')"
  printf '  %-11s %s\n' units "$(find "$root/units" -maxdepth 2 -name unit.toml 2>/dev/null | wc -l)"
}

# Fetch one marketplace and report per-unit changes before applying them.
update_market() {
  local root="$1" name branch before remote changes
  name=$(market_name "$root")

  git -C "$root" rev-parse --git-dir >/dev/null 2>&1 || {
    say "$(dim "$name: not a git checkout, skipped")"
    return 0
  }

  branch=$(git -C "$root" rev-parse --abbrev-ref HEAD)
  before=$(git -C "$root" rev-parse HEAD)

  git -C "$root" fetch --quiet origin "$branch" 2>/dev/null || {
    warn "$name: fetch failed"
    return 0
  }

  remote=$(git -C "$root" rev-parse "origin/$branch" 2>/dev/null) || {
    warn "$name: no origin/$branch"
    return 0
  }

  if [[ $before == "$remote" ]]; then
    say "$(dim "$name: up to date at ${before:0:12}")"
    return 0
  fi

  # Ahead of origin, which is the normal state in a checkout somebody develops
  # in. Without this the differing hashes read as an update, and it prints a
  # changelog backwards and claims to have applied it.
  if git -C "$root" merge-base --is-ancestor "$remote" "$before" 2>/dev/null; then
    local ahead
    ahead=$(git -C "$root" rev-list --count "$remote..$before" 2>/dev/null)
    say "$(dim "$name: $ahead commit(s) ahead of origin, nothing to pull")"
    return 0
  fi

  local commits
  commits=$(git -C "$root" rev-list --count "$before..$remote" 2>/dev/null)
  say "$(bold "$name") $(dim "${before:0:12} -> ${remote:0:12}, $commits commit(s)")"

  changes=$(registry_diff "$root" "$name" "$before" "$remote")
  if [[ $changes == "__NOCHANGES__" ]]; then
    say "  $(dim 'no unit changed. Only docs or tooling moved:')"
    git -C "$root" log --no-merges --format='%s' "$before..$remote" 2>/dev/null |
      head -10 | while read -r subject; do say "    $(dim "$subject")"; done
  else
    printf '%s\n' "$changes"
  fi
  say "  $(dim "every line of it: git -C $root diff HEAD origin/$branch")"

  # Omarchy asks before it fast-forwards a plugin and so does this. A unit is
  # what somebody turned on, so the summary above is per unit rather than a raw
  # commit diff, and this is the last point at which none of it has happened.
  confirm "Update $name?" || {
    say "  $(dim "skipped $name")"
    return 0
  }

  if ! git -C "$root" merge --ff-only "origin/$branch" --quiet 2>/dev/null; then
    warn "$name: cannot fast-forward, you have local commits. Rebase or stash them."
    return 0
  fi

  say "  $(green updated) $(dim "${before:0:12} -> ${remote:0:12}")"
}

# Compare a marketplace's registry at two refs and print one line per changed
# unit. This is what makes an update legible before it is applied, and it is
# deliberately not a commit diff: a unit is the thing somebody turned on.
registry_diff() {
  python3 - "$1" "$2" "$3" "$4" "$LINKED_FILE" <<'PY'
import json, subprocess, sys

root, market, old_ref, new_ref, linked_path = sys.argv[1:6]

def git(*args):
    out = subprocess.run(["git", "-C", root, *args], capture_output=True, text=True)
    return out.stdout if out.returncode == 0 else ""

def registry_at(ref):
    try:
        return json.loads(git("show", f"{ref}:registry.json"))["units"]
    except Exception:
        return {}

old, new = registry_at(old_ref), registry_at(new_ref)
linked = {line.strip() for line in open(linked_path) if line.strip()}

def executes(entry):
    # The same question `bo info` answers, asked of the version being pulled in.
    # A unit that gains a bin/ script or an apply.sh is a different proposition
    # from one that fixed a comment, and the row says so before you agree.
    if entry.get("kind") in ("plugin", "setting"):
        return True
    listing = git("ls-tree", "-r", "--name-only", new_ref, "--", f"{entry.get('path', '')}/bin")
    return bool(listing.strip())

rows = []
for name in sorted(set(old) | set(new)):
    a, b = old.get(name), new.get(name)
    on = f"{market}/{name}" in linked
    if a and not b:
        rows.append((not on, name, "removed", on, False, False, f"was {a['version']}"))
    elif b and not a:
        rows.append((not on, name, "new", on, executes(b), True, f"{b['version']}  {b['summary']}"))
    elif a["hash"] != b["hash"]:
        bump = a["version"] != b["version"]
        detail = (f"{a['version']} -> {b['version']}" if bump
                  else f"{b['version']} unchanged, but its files are not")
        rows.append((not on, name, "changed", on, executes(b), bump, detail))

if not rows:
    print("__NOCHANGES__")
    sys.exit(0)

# Units you have on come first: they are the only ones this changes today.
rows.sort()

colour = {"new": "32", "changed": "36", "removed": "31"}
for _, name, kind, on, runs, loud, detail in rows:
    dot = "\033[32m●\033[0m" if on else "\033[2m○\033[0m"
    mark = "\033[33m!\033[0m" if runs else " "
    label = f"\033[1m{name:<20}\033[0m" if on else f"{name:<20}"
    body = detail if loud else f"\033[2m{detail}\033[0m"
    print(f"  \033[{colour[kind]}m{kind:<8}\033[0m {dot}{mark} {label} {body}")

changed_on = sum(1 for row in rows if row[3])
runs_on = sum(1 for row in rows if row[3] and row[4])
tail = f"{len(rows)} unit(s) change, {changed_on} of them on"
if runs_on:
    tail += f", {runs_on} of those runs code"
print(f"  \033[2m{tail}.\033[0m")
PY
}

cmd_market_update() {
  parse_flags "$@"
  set -- ${ARGS[@]+"${ARGS[@]}"}

  local root
  if (($# > 0)); then
    root=$(market_root "$1") || die "no marketplace named '$1'"
    update_market "$root"
  else
    while read -r root; do update_market "$root"; done < <(market_roots)
  fi
}

cmd_market() {
  local sub="${1:-list}"
  shift 2>/dev/null || true
  case "$sub" in
  list | ls) cmd_market_list ;;
  add) cmd_market_add "$@" ;;
  link) cmd_market_link "$@" ;;
  unlink) cmd_market_unlink "$@" ;;
  remove | rm) cmd_market_remove "$@" ;;
  update) cmd_market_update "$@" ;;
  info) cmd_market_info "$@" ;;
  *)
    say "unknown: bo market $sub"
    market_usage
    return 1
    ;;
  esac
}

# ---------------------------------------------------------------- updating

cmd_outdated() {
  local ref want have n=0
  while read -r ref; do
    ref_exists "$ref" || continue
    want=$(reg "$ref" hash)
    have=$(installed_field "$ref" hash)
    [[ -z $want || $want == "$have" ]] && continue
    printf '  %-30s %s -> %s\n' "$ref" "$(installed_field "$ref" version)" "$(reg "$ref" version)"
    ((n++))
  done < <(linked_refs)

  if ((n == 0)); then
    say "$(green 'Every linked unit matches its marketplace.')"
  else
    say ""
    say "Run $(cyan 'bo relink') to apply."
  fi
  return 0
}

# Re-run link for units whose content changed. Symlinked files need nothing, but
# a unit that gained a hypr/ file or a bin/ script does.
cmd_relink() {
  local ref want have n=0
  while read -r ref; do
    ref_exists "$ref" || continue
    want=$(reg "$ref" hash)
    have=$(installed_field "$ref" hash)
    [[ -z $want || $want == "$have" ]] && continue

    link_hypr "$ref"
    link_bin "$ref"
    link_config "$ref"
    [[ $(meta "$ref" kind) == plugin ]] && rescan_plugins
    record_installed "$ref"
    say "$(cyan relinked) $ref $(dim "$(meta "$ref" version)")"
    ((n++))
  done < <(linked_refs)

  ((n == 0)) && say "Nothing to relink."
  return 0
}

cmd_update() {
  parse_flags "$@"
  cmd_market_update
  say ""
  cmd_relink
  say ""
  refresh_self_link
}

# `bo` lives inside a marketplace checkout, so updating that marketplace already
# updated the script. The link into PATH can still be missing or stale: somebody
# who ran the repo's `./bo` before installing has no link at all, and somebody
# who moved their checkout has one pointing at nothing.
refresh_self_link() {
  local link="$BIN_DIR/bo"
  local target="$SELF_ROOT/bo"

  [[ -f $target ]] || return 0

  if [[ -L $link && $(readlink -f "$link") == "$(readlink -f "$target")" ]]; then
    say "$(dim "bo is linked and current")"
    return 0
  fi

  if [[ -e $link && ! -L $link ]]; then
    warn "$link is a real file, not a link. Leaving it alone."
    return 0
  fi

  mkdir -p "$BIN_DIR"
  ln -sf "$target" "$link"
  say "$(green relinked) bo -> $target"
}

# One line, once a day, when the marketplace bo came from has moved on. It never
# blocks and never fetches inline: a launcher command that pauses on the network
# is a command people stop running.
check_self_stale() {
  git -C "$SELF_ROOT" rev-parse --git-dir >/dev/null 2>&1 || return 0

  local stamp="$STATE_DIR/last-update-check"
  local now age
  now=$(date +%s)

  if [[ -f $stamp ]]; then
    age=$(( now - $(cat "$stamp" 2>/dev/null || echo 0) ))
    ((age < 86400)) && return 0
  fi

  # Compare against what the last fetch already told us, rather than fetching
  # here. `bo update` does the fetching; this only reports what is known.
  local branch behind
  branch=$(git -C "$SELF_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null) || return 0
  behind=$(git -C "$SELF_ROOT" rev-list --count "HEAD..origin/$branch" 2>/dev/null) || return 0

  printf '%s' "$now" >"$stamp"

  ((behind > 0)) &&
    warn "$behind commit(s) behind origin/$branch. Run: bo update"

  # A background fetch, so the next command has something fresh to compare
  # against without this one waiting for the network.
  (git -C "$SELF_ROOT" fetch --quiet origin "$branch" >/dev/null 2>&1 &) 2>/dev/null
  return 0
}

# What a unit changed, against the snapshot taken when it went on. Three columns
# because three values are the whole story: what was there, what the unit left,
# and what is there now. A `drifted` line is something changed since, which is
# also the thing removal will leave alone.
cmd_diff() {
  (($# > 0)) || die "usage: bo diff <unit>"
  local ref state kind key before after now first=1
  ref=$(resolve_ref "$1")

  has_snapshot "$ref" || {
    say "No snapshot for $ref. It was installed before bo took them, or it is off."
    return 0
  }

  while IFS=$'\t' read -r state kind key before after now; do
    [[ $state == taken ]] && {
      printf '%s %s\n\n' "$(bold "$ref")" "$(dim "snapshot taken $kind")"
      continue
    }
    ((first)) && {
      printf '%-9s %-10s %-42s %-18s %-18s %s\n' STATE KIND WHAT BEFORE INSTALLED NOW
      first=0
    }
    printf '%s %-10s %-42s %-18s %-18s %s\n' \
      "$([[ $state == same ]] && dim "$(printf '%-9s' same)" || yellow "$(printf '%-9s' drifted)")" \
      "$kind" "${key/#$HOME/\~}" "$before" "$after" "$now"
  done < <(snapshot_run "$ref" diff)
  return 0
}

# Replays a snapshot without needing the unit. A marketplace that disappears
# must not strand a machine, and the snapshot is self-contained on purpose.
cmd_restore() {
  (($# > 0)) || die "usage: bo restore <unit>"
  local ref="$1" dir
  ref_exists "$ref" && ref=$(resolve_ref "$1")

  dir=$(snapshot_dir "$ref")
  [[ -f "$dir/manifest.json" ]] || die "no snapshot for '$ref'. Run: bo snapshots"

  say "$(bold "$ref")"
  snapshot_restore "$ref"
  is_linked "$ref" && {
    mark_unlinked "$ref"
    forget_installed "$ref"
  }
  reload_shell_config
  say "$(dim done)"
  return 0
}

# Every snapshot on this machine, including ones whose unit is gone.
cmd_snapshots() {
  local base="$STATE_DIR/snapshots" market unit ref
  [[ -d $base ]] || {
    say "No snapshots yet."
    return 0
  }
  printf '%-34s %-9s %s\n' UNIT UNIT-HERE TAKEN
  for market in "$base"/*/; do
    [[ -d $market ]] || continue
    for unit in "$market"*/; do
      [[ -f "$unit/manifest.json" ]] || continue
      ref="$(basename "$market")/$(basename "$unit")"
      printf '%-34s %-9s %s\n' "$ref" \
        "$(ref_exists "$ref" && green yes || red no)" \
        "$(json_get "$unit/manifest.json" taken)"
    done
  done
  return 0
}

# ---------------------------------------------------------------- leaving
#
# The whole point of recording what a unit displaced is that somebody can decide
# against all of this and get their machine back. That needs one command, and
# until now there was not one: `bo uninstall` was an alias for `bo remove`, so
# leaving meant remembering every unit by hand and then finding bo's own state
# directory, its clones and its bin link yourself.
#
# Order matters. Units come off first, one at a time and through the same path a
# single `bo remove` takes, so every widget slot is handed back and every
# displaced file is restored before the state that records them is deleted.
cmd_uninstall() {
  parse_flags "$@"

  local ref count=0
  count=$(linked_refs | grep -c . || true)

  say "$(bold 'Leaving better-omarchy')"
  say ""
  ((count > 0)) && say "  turns off $count unit(s), putting back whatever each displaced"
  say "  removes   $STATE_DIR"
  say "  removes   $DATA_DIR"
  say "  removes   $BIN_DIR/bo"
  say ""
  say "  $(dim 'A marketplace you linked with `bo market link` is a tree of your own')"
  say "  $(dim 'and is never deleted. Neither is this checkout.')"
  say ""

  ((ASSUME_YES)) || confirm "Go ahead?" || {
    say "$(dim 'left as it is')"
    return 1
  }

  # Reverse order, so a unit that another one requires goes last.
  local -a refs=()
  while read -r ref; do [[ -n $ref ]] && refs=("$ref" "${refs[@]}"); done < <(linked_refs)
  for ref in ${refs[@]+"${refs[@]}"}; do
    ref_exists "$ref" || {
      mark_unlinked "$ref"
      forget_installed "$ref"
      continue
    }
    unlink_unit "$ref"
  done

  rm -rf "$STATE_DIR"

  # Only the clones. A linked tree is somebody's working copy and the file that
  # points at it goes with DATA_DIR, which is bo's own bookkeeping.
  rm -rf "$MARKETS_DIR"
  rm -rf "$DATA_DIR"

  if [[ -L "$BIN_DIR/bo" ]]; then
    rm -f "$BIN_DIR/bo"
    restore_backup "$BIN_DIR/bo"
  fi

  # Anything bo moved aside and could not put back, named rather than left for
  # somebody to find. This is empty on a clean leave.
  local -a left=()
  shopt -s nullglob globstar
  left=("$CONFIG_HOME"/**/*.before-bo.* "$BIN_DIR"/*.before-bo.*)
  shopt -u nullglob globstar
  ((${#left[@]} > 0)) && {
    say ""
    say "$(yellow 'Still here'), files bo moved aside and did not put back:"
    printf '  %s\n' "${left[@]}"
  }

  say ""
  say "$(green gone) $(dim 'this checkout is still here; delete it if you want to.')"
  return 0
}

# ---------------------------------------------------------------- author tools

cmd_registry() {
  local root builder
  root=$(market_root "${1:-$(market_name "$SELF_ROOT")}") || die "no such marketplace"
  builder="$root/tools/build-registry"
  [[ -x $builder ]] || die "$root has no executable tools/build-registry"
  "$builder"
}

# ---------------------------------------------------------------- testing
#
# Nothing else looks at what an extension prints. A script that emits malformed
# JSON fails silently in the launcher, because one unparseable line is skipped
# so the rest of a long answer survives, and the result is a keyword that shows
# nothing and says nothing. This runs each one and reads the answer the way the
# launcher would, then says where it stopped making sense.

# The query every extension is asked. Short, harmless, and nothing in
# particular, because this tests the shape of an answer and not its content.
TEST_QUERY="test"

# The kinds of check, in the order they run. `manifest` only reads files;
# each of the other three runs the extension, which is where the seconds go.
# A run can be narrowed to any of them, so editing one JSON does not cost a
# round trip to GitHub.
TEST_KINDS_ALL="manifest answer actions cases"
TEST_KINDS="$TEST_KINDS_ALL"
wants_kind() { [[ " $TEST_KINDS " == *" $1 "* ]]; }
kind_exists() { [[ " $TEST_KINDS_ALL " == *" $1 "* ]]; }
kinds_left_out() {
  local kind
  for kind in $TEST_KINDS_ALL; do
    wants_kind "$kind" || printf '%s ' "$kind"
  done
}
# Unquoted on purpose: the kinds arrive as one space-separated word and want
# splitting into the lines join_lines reads.
kinds_as_list() { printf '%s\n' $1 | join_lines; }

# ok, skipped and fail line up in one column, so one failure in a long run is
# findable rather than buried in a sentence.
test_line() {
  local state="$1" name="$2" mark
  shift 2
  case "$state" in
  ok) mark=$(green "$(printf '%-7s' ok)") ;;
  skipped) mark=$(dim "$(printf '%-7s' skipped)") ;;
  *) mark=$(red "$(printf '%-7s' fail)") ;;
  esac
  printf '  %s %-22s %s\n' "$mark" "$name" "$*"
}

# One extension JSON, read in a single pass: whether it is usable, which command
# it names, how long to wait, that command with its placeholders filled in twice
# over, and its `when` gate. A problem comes back as one line starting with `!`,
# so a caller never has to parse a report to find out whether it is one.
ext_meta() {
  python3 - "$1" "$2" <<'PY'
import json, re, shlex, sys

# The views that exist, read off disk rather than listed here. A hand-kept list
# went stale the moment anyone added a view: `bo test` then failed every
# extension that used the new one, which reads as the extension being broken.
# ResultFoo.qml is the view named "foo"; the launcher's own switch agrees.
def _views(extension_path):
    # The extension file lives at <unit>/config/omarchy/omacast/extensions/x.json,
    # so the plugin directory is four levels up and one across.
    import pathlib
    unit = pathlib.Path(extension_path).resolve().parents[4]
    found = {"list"}
    for qml in (unit / "plugin").glob("Result*.qml"):
        found.add(qml.stem[len("Result"):].lower())
    return found
TIERS = ("calc", "forced", "prefix", "substring", "weak", "file", "web")
NUMBERS = ("minChars", "debounceMs", "timeoutMs", "maxRows")

path, sample = sys.argv[1:3]


def fail(message):
    print("!" + message)
    sys.exit(0)


try:
    ext = json.load(open(path, encoding="utf-8"))
except Exception as e:
    fail(f"not JSON: {e}")

if not isinstance(ext, dict):
    fail("the top level is not an object")

# The launcher drops an extension with neither of these and says nothing, so a
# typo in either key costs a keyword with no error anywhere.
if not str(ext.get("id", "")).strip():
    fail("no id, so the launcher ignores the file without a word")
search = str(ext.get("search", "")).strip()
if not search:
    fail("no search, so the launcher ignores the file without a word")

view = ext.get("view")
if view is not None:
    views = _views(path)
    if view not in views:
        fail(f"view is {view!r}, and no ResultX.qml provides it. "
             f"There is: {', '.join(sorted(views))}")

tier = ext.get("tier")
if tier is not None and tier not in TIERS:
    fail(f"tier is {tier!r}, and it is one of: {', '.join(TIERS)}")

for key in NUMBERS:
    if key not in ext:
        continue
    value = ext[key]
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        fail(f"{key} is {value!r}, which is not a number")

# {query} takes the query, shell quoted; every other placeholder takes an empty
# argument, which is what the launcher passes for a filter nobody typed.
def command(query):
    return re.sub(
        r"\{([A-Za-z0-9_-]+)\}",
        lambda m: shlex.quote(query) if m.group(1).lower() == "query" else "''",
        search,
    )


timeout = ext.get("timeoutMs", 4000)
seconds = max(1, int((timeout + 999) // 1000))

# An extension whose minChars is 0 is the kind that answers a bare `sys:` with
# everything it has and a typed `sys:test` with nothing, so it is asked both
# ways. Testing only the typed form would test almost nothing.
bare = command("") if ext.get("minChars", 1) == 0 else ""

print("ok")
print(search.split()[0])
print(seconds)
print(command(sample))
print(bare)
print(str(ext.get("when", "")).replace("\n", " "))
PY
}

# What came back, checked the way the launcher reads it. Prints how many rows
# there were, or one `!` line naming the first problem with the output that
# caused it under it.
ext_rows() {
  python3 - "$1" <<'PY'
import json, sys

text = open(sys.argv[1], encoding="utf-8", errors="replace").read().strip()


def fail(message, offending=""):
    print("!" + message)
    if offending:
        print(offending[:400])
    sys.exit(0)


def number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool)


if text == "":
    print(0)
    sys.exit(0)

# A whole document first, array or single object, then one object per line. The
# launcher skips a line it cannot parse so that one bad row does not lose the
# other forty; here that silence is the thing being hunted, so a bad line is the
# answer rather than being stepped over.
try:
    whole = json.loads(text)
except ValueError:
    whole = None

rows = None
if isinstance(whole, list):
    rows = whole
elif isinstance(whole, dict):
    rows = [whole]

if rows is None:
    rows = []
    for n, line in enumerate(text.splitlines(), 1):
        line = line.strip()
        if not line:
            continue
        try:
            rows.append(json.loads(line))
        except ValueError as e:
            fail(f"line {n} is not JSON: {e}", line)

for n, row in enumerate(rows, 1):
    dump = json.dumps(row) if not isinstance(row, str) else row
    if not isinstance(row, dict):
        fail(f"row {n} is not an object", dump)

    title = row.get("title")
    if title is None or isinstance(title, bool) or str(title).strip() == "":
        fail(f"row {n} has no title, so the launcher drops it", dump)

    if "exec" in row and not isinstance(row["exec"], str):
        fail(f"row {n}: exec is not a string", dump)

    if "score" in row and not number(row["score"]):
        fail(f"row {n}: score is not a number", dump)

    if "progress" in row:
        progress = row["progress"]
        if not number(progress):
            fail(f"row {n}: progress is not a number", dump)
        if not 0 <= progress <= 1:
            fail(f"row {n}: progress is {progress}, and it is a fraction from 0 to 1", dump)

    actions = row.get("actions")
    if actions is not None:
        if not isinstance(actions, list):
            fail(f"row {n}: actions is not an array", dump)
        for i, action in enumerate(actions, 1):
            if not isinstance(action, dict):
                fail(f"row {n}: action {i} is not an object", dump)
            if str(action.get("title", "")).strip() == "":
                fail(f"row {n}: action {i} has no title", dump)

print(len(rows))
PY
}

# Run one command and read what it printed. Prints a row count, or a `!` line
# and the output that caused it, the same shape ext_rows uses.
ext_answer() {
  local cmd="$1" secs="$2" out err status
  out=$(mktemp)
  err=$(mktemp)

  # stderr is kept apart, because the launcher reads stdout alone: a script that
  # warns and still answers is fine, and one that only warns is not.
  timeout "$secs" bash -lc "$cmd" >"$out" 2>"$err"
  status=$?

  if ((status == 124)); then
    printf '!no answer in %ss\n%s\n' "$secs" "$cmd"
  elif [[ ! -s $out && -s $err ]]; then
    printf '!printed nothing, and wrote to stderr\n'
    head -5 "$err"
  else
    ext_rows "$out"
  fi

  rm -f "$out" "$err"
}

rows_word() { ((${1:-0} == 1)) && printf '1 row' || printf '%s rows' "${1:-0}"; }

test_extension() {
  local file="$1" dir="$2" name binary secs when problem detail cmd
  local -a info result queries counts=()
  name=$(basename "$file" .json)

  mapfile -t info < <(ext_meta "$file" "$TEST_QUERY")
  problem="${info[0]:-!could not be read at all}"
  [[ $problem == ok ]] || {
    test_line fail "$name" "${problem#!}"
    return 1
  }
  binary="${info[1]:-}"
  secs="${info[2]:-4}"
  queries=("${info[3]:-}")
  [[ -n ${info[4]:-} ]] && queries+=("${info[4]}")
  when="${info[5]:-}"

  # A script the unit ships but has not linked is the common case here, and it
  # is worth saying which of the two problems it is: the launcher runs whatever
  # is on PATH and knows nothing about bin/.
  command -v "$binary" >/dev/null || {
    if [[ -e "$dir/bin/$binary" ]]; then
      test_line fail "$name" "search names $binary, which this unit ships and has not linked: bo relink"
    else
      test_line fail "$name" "search names $binary, which is not on PATH"
    fi
    return 1
  }

  # Everything above read the file; everything below runs it. With `answer` in
  # the run the row count vouches for the file too, so only one of the two
  # lines is ever printed.
  if wants_kind manifest && ! wants_kind answer; then
    test_line ok "$name" "reads as an extension"
  fi

  if ! wants_kind answer && ! wants_kind actions && ! wants_kind cases; then
    return 0
  fi

  # The `when` gate first. An extension for software this machine does not have
  # is not a failure, it is an extension that correctly never runs here.
  if [[ -n $when ]] && ! bash -lc "$when" >/dev/null 2>&1; then
    test_line skipped "$name" "when condition false: $when"
    return 0
  fi

  wants_kind answer || queries=()

  for cmd in ${queries[@]+"${queries[@]}"}; do
    mapfile -t result < <(ext_answer "$cmd" "$secs")
    problem="${result[0]:-!the output could not be read at all}"
    [[ $problem != '!'* ]] || {
      test_line fail "$name" "${problem#!}"
      ((${#result[@]} > 1)) && printf '%s\n' "${result[@]:1}" | sed 's/^/          /'
      return 1
    }
    counts+=("$problem")
  done

  if ((${#counts[@]} > 0)); then
    detail="$(rows_word "${counts[0]}")"
    [[ -n ${counts[1]:-} ]] && detail+=", ${counts[1]} bare"
    test_line ok "$name" "$detail"
  fi

  wants_kind actions && { test_actions "$file" "$binary" "$secs" || return 1; }
  wants_kind cases && { test_cases "$file" "$binary" "$secs" || return 1; }
  return 0
}

# Every action on every row has to be able to run.
#
# An action that does nothing is the worst kind of broken: the panel lists it,
# the key works, the row highlights, and then nothing happens and there is
# nothing to see. It happened three times in one evening, and each time the
# cause was mechanical and checkable: a command that is not installed, a script
# the unit ships and has not linked, a `query` pointing at a keyword nobody
# registered.
#
# So every exec is taken apart and its program looked for. This does not run
# anything: it reads the first word out of the command, follows `sh -c` and the
# omarchy launchers to the real program inside, and asks whether that exists.
ACTIONS_PY='
import json, os, re, shutil, subprocess, sys

binary, query, timeout = sys.argv[1], sys.argv[2], float(sys.argv[3])

try:
    out = subprocess.run([binary, query], capture_output=True, text=True, timeout=timeout).stdout
except Exception as exc:
    print("!could not run: %s" % exc)
    sys.exit(0)

rows = []
text = out.strip()
if text.startswith("["):
    try:
        rows = json.loads(text)
    except Exception:
        rows = []
else:
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rows.append(json.loads(line))
        except Exception:
            pass

# Wrappers that take the real program as an argument. Checking the wrapper alone
# would pass an action that runs a program nobody has.
WRAPPERS = {
    "omarchy-launch-tui", "omarchy-launch-browser", "omarchy-launch-editor",
    "uwsm-app", "setsid", "timeout", "env", "nohup",
}
SKIP_ARG = re.compile(r"^(--?[A-Za-z0-9-]+(=.*)?)$")

def program_of(command):
    """The program an exec actually runs, or None when it is a shell fragment
    whose first word is a variable, a builtin, or an assignment."""
    parts = command.strip().split()
    while parts:
        head = parts[0]
        if head in ("sh", "bash") and len(parts) > 2 and parts[1] in ("-c", "-lc"):
            # The command is the quoted string after -c, and its first word is
            # what runs.
            inner = command.split(parts[1], 1)[1].strip().strip("\x27\"")
            return program_of(inner) if inner else None
        if head in WRAPPERS:
            parts = [p for p in parts[1:] if not SKIP_ARG.match(p)]
            # A browser launcher takes a URL, not a program. Unwrapping past it
            # asked whether "https://github.com/tmux/tmux" was installed.
            if parts and re.match(r"^[\x27\"]?[a-z]+://", parts[0]):
                return None
            # An editor launcher takes a file, not a program. Unwrapping past it
            # asked whether "/home/nkz/.ssh/config" was installed, which it
            # reported as a missing command for a file that exists and is the
            # whole point of the action.
            if parts and re.match(r"^[\x27\"]?[~/]", parts[0]):
                return None
            continue
        if "=" in head and not head.startswith("/"):
            # `out=$(docker stop x)` is an assignment whose program is inside
            # the substitution. Skipping the whole word left "stop" as the head
            # and reported that stop was not installed.
            after = head.split("=", 1)[1]
            if after.startswith("$("):
                return program_of(after[2:] + " " + " ".join(parts[1:]))
            parts = parts[1:]
            continue
        if head in ("true", "false", ":", "printf", "echo", "cd", "exit", "test", "["):
            return None
        return head
    return None

missing = {}
seen_rows = 0
for row in rows:
    seen_rows += 1
    actions = row.get("actions") or []
    for action in actions:
        exec_ = str(action.get("exec") or "")
        if not exec_:
            if action.get("query") is None:
                missing.setdefault("an action with neither exec nor query", set()).add(
                    str(action.get("title") or "?"))
            continue
        program = program_of(exec_)
        if program is None or program.startswith("$") or program.startswith("{"):
            continue
        if program.startswith("/") or program.startswith("~"):
            if not os.path.exists(os.path.expanduser(program)):
                missing.setdefault(program, set()).add(str(action.get("title") or "?"))
            continue
        if shutil.which(program) is None:
            missing.setdefault(program, set()).add(str(action.get("title") or "?"))

print(seen_rows)
for program, titles in sorted(missing.items()):
    print("!%s is not installed, used by: %s" % (program, ", ".join(sorted(titles))))
'

# Checks that every action an extension offers can actually run.
test_actions() {
  local file="$1" binary="$2" secs="$3" name probe
  local -a lines
  name=$(basename "$file" .json)
  probe=$(json_get "$file" testQuery)
  [[ -n $probe ]] || probe=""

  mapfile -t lines < <(python3 -c "$ACTIONS_PY" "$binary" "$probe" "$secs" 2>&1)

  if ((${#lines[@]} <= 1)); then
    # The answer line already vouches for this extension. With `answer` left
    # out there is no such line, and silence reads as nothing having run.
    wants_kind answer || test_line ok "$name actions" "$(rows_word "${lines[0]:-0}") checked"
    return 0
  fi

  test_line fail "$name actions" "$((${#lines[@]} - 1)) cannot run"
  printf '%s\n' "${lines[@]:1}" | sed 's/^!/          /'
  return 1
}

# Cases: what an extension must still answer after somebody changes it.
#
# `bo test` already proves an extension runs and returns valid JSON. That is not
# enough. Moving the clock out of a `tz:` row title into its own field kept every
# row valid and left the hero drawing cities with no times against them, and
# nothing caught it until a screen recording did, two hours later.
#
# So an extension may ship `<name>.cases.json` beside its own JSON: a list of
# queries and what the answer has to look like.
#
#   [
#     { "why": "a city gives a hero with a clock",
#       "query": "tokyo",
#       "minRows": 2,
#       "row": 0,
#       "view": "hero",
#       "fields": ["clock", "title"],
#       "matches": { "clock": "^[0-9]{2}:[0-9]{2}$" } }
#   ]
#
# `fields` must be present and non-empty. `matches` is a regex per field.
# `absent` is the other direction. `row` picks which row to look at, default 0.
# `why` is printed when it fails, because a failing assertion should say what it
# was protecting rather than only which key was wrong.
CASES_PY='
import json, re, subprocess, sys

path, binary, timeout = sys.argv[1], sys.argv[2], float(sys.argv[3])

with open(path) as fh:
    cases = json.load(fh)

failures = []
for case in cases:
    query = case.get("query", "")
    try:
        out = subprocess.run([binary, query], capture_output=True, text=True,
                             timeout=timeout).stdout
    except subprocess.TimeoutExpired:
        failures.append((case, "did not answer in %gs" % timeout))
        continue

    rows = []
    text = out.strip()
    if text.startswith("["):
        try:
            rows = json.loads(text)
        except Exception as exc:
            failures.append((case, "output is not JSON: %s" % exc))
            continue
    else:
        for line in text.splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(json.loads(line))
            except Exception as exc:
                failures.append((case, "a line is not JSON: %s" % exc))
                break

    need = case.get("minRows")
    if need is not None and len(rows) < need:
        failures.append((case, "%d rows, wanted at least %d" % (len(rows), need)))
        continue

    if case.get("maxRows") is not None and len(rows) > case["maxRows"]:
        failures.append((case, "%d rows, wanted at most %d" % (len(rows), case["maxRows"])))
        continue

    if not rows:
        continue

    index = case.get("row", 0)
    if index >= len(rows):
        failures.append((case, "no row %d, there are %d" % (index, len(rows))))
        continue
    row = rows[index]

    want_view = case.get("view")
    if want_view is not None and str(row.get("view", "")) != want_view:
        failures.append((case, "row %d is view %r, wanted %r"
                         % (index, row.get("view", ""), want_view)))
        continue

    bad = False
    for field in case.get("fields", []):
        value = row.get(field)
        if value in (None, "", [], {}):
            failures.append((case, "row %d has no %s" % (index, field)))
            bad = True
    for field in case.get("absent", []):
        if row.get(field) not in (None, "", [], {}):
            failures.append((case, "row %d still carries %s" % (index, field)))
            bad = True
    # How many, when the field is a list. Counting through a regex on the
    # serialised list was the first attempt and it measured exec string length,
    # which is not what "no more than three actions" means.
    for field, limit in (case.get("atMost") or {}).items():
        value = row.get(field)
        if isinstance(value, (list, dict)) and len(value) > limit:
            failures.append((case, "row %d has %d %s, wanted at most %d"
                             % (index, len(value), field, limit)))
            bad = True

    for field, pattern in (case.get("matches") or {}).items():
        value = str(row.get(field, ""))
        if not re.search(pattern, value):
            failures.append((case, "row %d %s is %r, wanted /%s/" % (index, field, value, pattern)))
            bad = True
    if bad:
        continue

print(len(cases))
for case, why in failures:
    print("!%s  (%s)" % (why, case.get("why") or case.get("query", "")))
'

# Runs an extension's cases, if it has any.
test_cases() {
  local file="$1" binary="$2" secs="$3" name cases total
  local -a lines
  name=$(basename "$file" .json)
  cases="${file%.json}.cases.json"
  [[ -f $cases ]] || return 0

  mapfile -t lines < <(python3 -c "$CASES_PY" "$cases" "$binary" "$secs" 2>&1)
  total="${lines[0]:-0}"

  if ((${#lines[@]} <= 1)); then
    test_line ok "$name cases" "$total held"
    return 0
  fi

  test_line fail "$name cases" "$((${#lines[@]} - 1)) of $total broke"
  printf '%s\n' "${lines[@]:1}" | sed 's/^!/          /'
  return 1
}

# A unit.toml that is wrong fails later and further away: bo registry refuses to
# build, or a plugin links under a name Omarchy never enables.
test_unit_toml() {
  local ref="$1" dir kind key id manifest
  local -a missing=()
  dir=$(ref_dir "$ref")

  for key in name summary version kind; do
    [[ -n $(meta "$ref" "$key") ]] || missing+=("$key")
  done
  ((${#missing[@]} == 0)) || {
    test_line fail unit.toml "no $(printf '%s\n' "${missing[@]}" | join_lines)"
    return 1
  }

  [[ $(meta "$ref" name) == "$(ref_unit "$ref")" ]] || {
    test_line fail unit.toml "name is $(meta "$ref" name), and the folder is $(ref_unit "$ref")"
    return 1
  }

  kind=$(meta "$ref" kind)
  case "$kind" in
  plugin | hypr | setting) ;;
  *)
    test_line fail unit.toml "kind is '$kind', and it is one of: plugin, hypr, setting"
    return 1
    ;;
  esac

  if [[ $kind == plugin ]]; then
    id=$(meta "$ref" id)
    manifest="$dir/plugin/manifest.json"
    [[ -n $id ]] || {
      test_line fail unit.toml "kind is plugin and there is no id to link it under"
      return 1
    }
    [[ -f $manifest ]] || {
      test_line fail unit.toml "kind is plugin and there is no plugin/manifest.json"
      return 1
    }
    [[ $(json_get "$manifest" id) == "$id" ]] || {
      test_line fail unit.toml "id is $id, and manifest.json says $(json_get "$manifest" id)"
      return 1
    }
  fi

  test_line ok unit.toml "$kind, $(meta "$ref" version)"
}

# Every extension JSON a unit ships. `<name>.cases.json` belongs to the
# extension beside it and is checked as part of it, never loaded as one of its
# own.
#
# It takes the directory rather than the ref, because ref_dir reads a
# registry.json through python and a run that called it once per extension
# spent more time finding the files than checking them.
ext_files() {
  local dir="$1" file
  [[ -n $dir ]] || return 0
  shopt -s nullglob
  for file in "$dir"/config/omarchy/omacast/extensions/*.json; do
    [[ $file == *.cases.json ]] && continue
    printf '%s\n' "$file"
  done
  shopt -u nullglob
}

# Which extension files a name means. A person has four names for the same
# thing depending on where they last saw it: the file, the `id`, the `keyword`
# and its aliases. All four match, in one python pass so that naming an
# extension is not slower than testing it.
ext_named() {
  local want="$1"
  shift
  (($# > 0)) || return 0
  python3 - "$want" "$@" <<'PY'
import json, os, sys

want = sys.argv[1].lower()
for path in sys.argv[2:]:
    names = {os.path.basename(path)[:-len(".json")].lower()}
    try:
        ext = json.load(open(path, encoding="utf-8"))
    except Exception:
        ext = {}
    if isinstance(ext, dict):
        names.add(str(ext.get("id", "")).lower())
        names.add(str(ext.get("keyword", "")).lower())
        for alias in ext.get("aliases") or []:
            names.add(str(alias).lower())
    if want in names:
        print(path)
PY
}

# One target on the command line, turned into `ref<TAB>file` lines: one per
# extension to check, plus a bare `ref<TAB>` asking for that unit's manifest.
#
# The grammar has to live beside `bo add omacast` and `bo info better-omarchy/
# omacast`, which is why a slash keeps meaning what it already meant. A pair is
# read as marketplace/unit first, because that is what the rest of bo calls it,
# and only falls through to unit/extension when no such unit exists.
test_target() {
  local q="$1" ref="" want="" file dir hit=0
  local -a files=()

  case "$q" in
  */*/*)
    ref="${q%/*}"
    want="${q##*/}"
    ;;
  */*)
    if ref_exists "$q"; then
      ref="$q"
    else
      ref=$(resolve_ref "${q%/*}" 2>/dev/null) || ref=""
      want="${q##*/}"
    fi
    ;;
  *)
    ref=$(all_refs | awk -F/ -v u="$q" '$NF == u')
    [[ $ref == *$'\n'* ]] && ref=""
    ;;
  esac

  # A bare word that names no unit is looked for as an extension across every
  # unit, so `bo test git` works without knowing which unit ships git. A unit
  # wins the name, because that is what a bare word means everywhere else in
  # bo, and `<unit>/<extension>` still says the other thing.
  if [[ -z $ref && -z $want ]]; then
    local r
    while read -r r; do
      [[ -z $r ]] && continue
      dir=$(ref_dir "$r") || continue
      mapfile -t files < <(ext_files "$dir")
      while read -r file; do
        [[ -z $file ]] && continue
        printf '%s\t%s\t%s\n' "$r" "$dir" "$file"
        hit=1
      done < <(ext_named "$q" ${files[@]+"${files[@]}"})
    done < <(all_refs)
    ((hit == 1)) && return 0

    # Not a unit and not an extension: the same half-typed-name match every
    # other command accepts gets the last word.
    ref=$(resolve_ref "$q" 2>/dev/null) || return 0
  fi

  [[ -n $ref ]] || return 0
  ref_exists "$ref" || return 0
  dir=$(ref_dir "$ref") || return 0
  mapfile -t files < <(ext_files "$dir")

  if [[ -z $want ]]; then
    printf '%s\t%s\t\n' "$ref" "$dir"
    for file in ${files[@]+"${files[@]}"}; do
      printf '%s\t%s\t%s\n' "$ref" "$dir" "$file"
    done
    return 0
  fi

  while read -r file; do
    [[ -n $file ]] && printf '%s\t%s\t%s\n' "$ref" "$dir" "$file"
  done < <(ext_named "$want" ${files[@]+"${files[@]}"})
}

# How many extensions run at once. They are separate processes that mostly sit
# waiting on somebody else's server, so the core count is a floor rather than a
# ceiling; 16 is where the courtesy to the machine stops.
test_jobs_default() {
  local n
  n=$(nproc 2>/dev/null || echo 4)
  ((n > 16)) && n=16
  ((n < 1)) && n=1
  printf '%s' "$n"
}

# One queued item, run in its own process with its output held back. Nothing
# here prints where anyone can see it: cmd_test replays the files in order, so
# a parallel run reads exactly like a serial one.
test_item() {
  local ref="$1" dir="$2" file="$3"
  if [[ -z $file ]]; then
    test_unit_toml "$ref"
  else
    test_extension "$file" "$dir"
  fi
}

test_usage() {
  cat <<'TXT'
  bo test [target...] [--only kind[,kind]] [--fast] [--jobs n] [--quiet]

Targets. With none, every unit.
  bo test omacast              one unit, every extension in it
  bo test git                  one extension, wherever it lives
  bo test omacast/git          the same one, said in full
  bo test omacast/git tz       as many as you like

Kinds. --only takes any of them, comma separated.
  manifest    unit.toml and each extension's own JSON. Runs nothing.
  answer      runs each extension and reads the rows it prints
  actions     every action on every row names a program that exists
  cases       the assertions in <extension>.cases.json

  --fast      manifest only, and says what it left out
  --jobs n    extensions checked at once (default: cores, at most 16)
  --quiet     print only what failed, for a hook

Exit 0 when everything held, 1 when something failed, 2 when the target
matched nothing. Results are never remembered between runs.
TXT
}

cmd_test() {
  local arg jobs="" quiet=0 only="" tmp i=0 rc line
  local ref dir file failed=0 shown=0 last=""
  local -a queue=() targets=()

  while (($# > 0)); do
    case "$1" in
    --only)
      [[ -n ${2:-} ]] || die "--only wants a kind: $TEST_KINDS_ALL"
      only="${only:+$only,}$2"
      shift
      ;;
    --only=*) only="${only:+$only,}${1#*=}" ;;
    --fast) only="${only:+$only,}manifest" ;;
    --jobs | -j)
      jobs="${2:-}"
      shift
      ;;
    --jobs=*) jobs="${1#*=}" ;;
    -q | --quiet) quiet=1 ;;
    -h | --help) test_usage && return 0 ;;
    -*) die "unknown option: $1. Try: bo test --help" ;;
    *) targets+=("$1") ;;
    esac
    shift
  done

  if [[ -n $only ]]; then
    TEST_KINDS=""
    for arg in ${only//,/ }; do
      kind_exists "$arg" || die "no such kind: $arg. There is: $TEST_KINDS_ALL"
      TEST_KINDS="$TEST_KINDS $arg"
    done
  fi

  [[ -n $jobs ]] || jobs=$(test_jobs_default)
  [[ $jobs =~ ^[1-9][0-9]*$ ]] || die "--jobs wants a number above zero, not '$jobs'"

  command -v timeout >/dev/null || die "timeout is not installed, and a test that cannot give up would hang"

  if ((${#targets[@]} > 0)); then
    for arg in "${targets[@]}"; do
      mapfile -t -O "${#queue[@]}" queue < <(test_target "$arg")
    done
    ((${#queue[@]} > 0)) || {
      printf '%s nothing to test matches: %s\n' "$(red ERROR)" "${targets[*]}" >&2
      return 2
    }
  else
    while read -r ref; do
      [[ -z $ref ]] && continue
      dir=$(ref_dir "$ref") || continue
      queue+=("$ref"$'\t'"$dir"$'\t')
      while read -r file; do
        [[ -n $file ]] && queue+=("$ref"$'\t'"$dir"$'\t'"$file")
      done < <(ext_files "$dir")
    done < <(all_refs)
  fi

  # Only the manifest lines survive a manifest run, so the extension jobs that
  # would say nothing are dropped rather than started.
  if ! wants_kind manifest; then
    local -a kept=()
    for line in "${queue[@]}"; do
      [[ ${line##*$'\t'} == "" ]] || kept+=("$line")
    done
    queue=(${kept[@]+"${kept[@]}"})
  fi

  # A unit with no extensions under `--only cases` is not a pass, it is a run
  # with nothing in it, and saying so beats a green line nobody earned.
  if ((${#queue[@]} == 0)); then
    ((quiet == 1)) || say "$(dim 'Nothing to check under those kinds.')"
    return 0
  fi

  tmp=$(mktemp -d)

  # Everything in the queue is an independent process, so they go at once and
  # their output is held in a file each. Interleaved lines from a parallel run
  # would be worse than the slow serial one this replaces.
  for ((i = 0; i < ${#queue[@]}; i++)); do
    while (($(jobs -rp | wc -l) >= jobs)); do wait -n; done
    (
      IFS=$'\t' read -r ref dir file <<<"${queue[i]}"
      test_item "$ref" "$dir" "$file" >"$tmp/$i.out" 2>&1
      printf '%s' "$?" >"$tmp/$i.rc"
    ) &
  done
  wait

  for ((i = 0; i < ${#queue[@]}; i++)); do
    ref="${queue[i]%%$'\t'*}"
    rc=$(cat "$tmp/$i.rc" 2>/dev/null || echo 1)
    ((rc == 0)) || failed=1
    ((quiet == 1 && rc == 0)) && continue
    [[ -s "$tmp/$i.out" ]] || continue
    [[ $ref == "$last" ]] || {
      say "$(bold "$ref")"
      last="$ref"
    }
    cat "$tmp/$i.out"
    shown=1
  done

  rm -rf "$tmp"

  ((quiet == 1 && failed == 0)) && return 0

  ((shown == 1)) && say ""
  if ((failed != 0)); then
    say "$(red 'Something above needs fixing.')"
  elif [[ $TEST_KINDS == "$TEST_KINDS_ALL" ]] && ((${#targets[@]} == 0)); then
    say "$(green 'Every extension answered, and every unit.toml holds up.')"
  elif [[ $TEST_KINDS == "$TEST_KINDS_ALL" ]]; then
    say "$(green 'Everything asked for held up.')"
  else
    # A narrowed pass has to say what it did not look at, or a fast run reads
    # like a full one and the checks it skipped go unrun for a week.
    say "$(green 'Everything asked for held up.') $(dim "Left out: $(kinds_as_list "$(kinds_left_out)").")"
  fi
  return $failed
}

cmd_validate() {
  local ref failed=0 dir
  while read -r ref; do
    [[ $(meta "$ref" kind) == plugin ]] || continue
    dir=$(readlink -f "$(ref_dir "$ref")/plugin")
    if omarchy plugin validate "$dir" >/dev/null 2>&1; then
      say "$(green ok) $ref"
    else
      say "$(red fail) $ref"
      omarchy plugin validate "$dir" 2>&1 | sed 's/^/    /'
      failed=1
    fi
  done < <(all_refs)
  return $failed
}

cmd_sync() {
  local live="$CONFIG_HOME/omarchy/shell.json" tracked="$SELF_ROOT/config/shell.json"
  [[ -f $live ]] || die "no $live"
  [[ -d "$SELF_ROOT/units" ]] || die "bo is not running from a marketplace checkout"
  mkdir -p "$(dirname "$tracked")"
  if cmp -s "$live" "$tracked"; then
    say "shell.json unchanged"
  else
    cp "$live" "$tracked"
    say "$(green updated) $tracked"
  fi
}

# ---------------------------------------------------------------- scaffolding
#
# A first unit is boilerplate you would otherwise reverse-engineer out of three
# other units, so bo writes it. Everything scaffolded here is valid as it
# stands: `bo add` links it without an edit, and a scaffolded extension answers
# its keyword the moment the launcher reloads.

# unit.toml is written a line at a time rather than from a template, so the =
# column lands where every other unit in this repo has it.
toml_line() { printf '%-8s = %s\n' "$1" "$2"; }
toml_string() { toml_line "$1" "\"$2\""; }

toml_array() {
  local key="$1" out="" item
  shift
  for item in "$@"; do
    [[ -n $out ]] && out+=", "
    out+="\"$item\""
  done
  toml_line "$key" "[$out]"
}

scaffold_author() {
  local who
  who=$(git -C "$SELF_ROOT" config user.name 2>/dev/null)
  printf '%s' "${who:-${USER:-you}}"
}

# search-files -> Search Files, for the human-facing half of a plugin manifest.
scaffold_title() { printf '%s' "${1//-/ }" | sed -E 's/(^| )([a-z])/\1\u\2/g'; }

# The checks every scaffold shares: this has to be a marketplace checkout, the
# name has to be one `bo add` can resolve, and an existing folder is never
# written into, because the folder is somebody's work.
scaffold_dir() {
  local name="$1" dir
  [[ -n $name ]] || die "no name. Try: bo new unit <name>"
  [[ $name =~ ^[a-z0-9][a-z0-9-]*$ ]] ||
    die "'$name' will not do as a unit name: lowercase letters, digits and dashes"
  [[ -d "$SELF_ROOT/units" ]] || die "bo is not running from a marketplace checkout"

  dir="$SELF_ROOT/units/$name"
  [[ -e $dir ]] && die "units/$name already exists. Pick another name, or edit that one."
  printf '%s' "$dir"
}

scaffold_toml() {
  local name="$1" kind="$2" author
  author=$(scaffold_author)

  toml_string name "$name"
  toml_string summary "What this does, in one line"
  toml_string version "0.1.0"

  case "$kind" in
  plugin)
    toml_string category "System"
    toml_array tags bar
    toml_string author "$author"
    toml_string kind plugin
    toml_string id "bo.$name"
    toml_array needs
    ;;
  setting)
    toml_string category "System"
    toml_array tags system
    toml_string author "$author"
    toml_string kind setting
    toml_array needs omarchy
    ;;
  extension)
    toml_string category "Productivity"
    toml_array tags launcher
    toml_string author "$author"
    toml_string kind hypr
    toml_array needs jq wl-copy
    toml_array requires omacast
    ;;
  *)
    toml_string category "Compositor"
    toml_array tags hyprland
    toml_string author "$author"
    toml_string kind hypr
    toml_array needs
    ;;
  esac

  toml_array keys
}

# Markdown and QML carry $ and backticks of their own, so the text is written
# verbatim and the name substituted after. A name is checked against
# [a-z0-9-] above, so nothing in it can mean anything to sed.
scaffold_fill() { sed "s/@NAME@/$1/g; s/@TITLE@/$(scaffold_title "$1")/g"; }

scaffold_readme() {
  scaffold_fill "$1" <<'TXT'
# @NAME@

One line on what this turns on.

```bash
bo add @NAME@
```

What it changes while it is on, and what comes back when you turn it off.
TXT
}

scaffold_lua() {
  scaffold_fill "$1" <<'LUA'
-- @NAME@: what this changes, and why it is worth changing.
--
-- Linked into ~/.config/hypr/modules.d/ and read by bo's own loader, so this is
-- ordinary Omarchy Lua config. Delete the file if this unit never touches the
-- compositor: bo links whatever .lua it finds here and nothing if there is
-- none.

-- o.bind("SUPER + J", "What it does", "some-command")
-- hl.config({ general = { gaps_in = 4 } })
LUA
}

scaffold_manifest() {
  local name="$1"
  jq -n --arg id "bo.$name" --arg title "$(scaffold_title "$name")" \
    --arg author "$(scaffold_author)" \
    --arg what "What this widget shows, in one line" \
    '{
       schemaVersion: 1, id: $id, name: $title, version: "1.0.0",
       author: $author, description: $what,
       kinds: ["bar-widget"],
       entryPoints: { barWidget: "Widget.qml" },
       barWidget: {
         displayName: $title, description: $what,
         category: "System", allowMultiple: false
       }
     }'
}

scaffold_widget() {
  scaffold_fill "$1" <<'QML'
import QtQuick
import qs.Commons
import qs.Ui

// One bar widget. Omarchy scans ~/.config/omarchy/plugins for a manifest and
// loads whatever entryPoints names, so the file name here and the one in
// manifest.json have to agree.
BarWidget {
  id: root
  moduleName: "bo.@NAME@"

  implicitWidth: button.implicitWidth
  implicitHeight: button.implicitHeight

  BarIconButton {
    id: button
    anchors.fill: parent
    bar: root.bar
    text: "󰋙"
    slotSize: Style.bar.statusSlot
    fontSize: Style.font.caption
    tooltipText: "@TITLE@"
    onPressed: if (root.bar) root.bar.run("omarchy-notification-send '@TITLE@' 'Replace this'")
  }
}
QML
}

# apply.sh and revert.sh take -e, unlike the extension scripts, because bo reads
# their exit status: a setting that half applied has to say so rather than pass.
scaffold_apply() {
  scaffold_fill "$1" <<'SH'
#!/bin/bash
# Run once, by `bo add @NAME@`. bo records that a setting ran, not what it
# did, so this has to be safe to run a second time.

set -euo pipefail

# The change itself goes here, for instance:
#   omarchy toggle idle stay-awake >/dev/null
true
SH
}

scaffold_revert() {
  scaffold_fill "$1" <<'SH'
#!/bin/bash
# Run by `bo remove @NAME@`. It puts back whatever apply.sh changed, which is
# the whole reason a setting unit can be turned off at all.

set -euo pipefail

# The undo goes here, for instance:
#   omarchy toggle idle allow-idle >/dev/null
true
SH
}

scaffold_extension_json() {
  local name="$1"
  jq -n --arg id "$name" --arg title "$(scaffold_title "$name")" \
    --arg search "omacast-$name {query}" \
    '{
       id: $id, title: $title, keyword: $id, aliases: [],
       subtitle: $title, glyph: "", search: $search,
       minChars: 0, debounceMs: 120, maxRows: 8,
       tier: "prefix", view: "list"
     }'
}

# The cases the stub already passes. A scaffold that starts red teaches you to
# ignore the test; one that starts with nothing teaches you tests are optional.
# These three hold against the script beside them, so the first thing you do to
# them is edit them into what your extension actually promises.
scaffold_extension_cases() {
  scaffold_fill "$1" <<'TXT'
[
  { "why": "a bare @NAME@: still answers, with the hint that says what to type",
    "query": "",
    "minRows": 1,
    "row": 0,
    "fields": ["id", "title", "subtitle"],
    "matches": { "id": "^@NAME@-hint$" } },

  { "why": "what was typed comes back as the title of one row, not two and not none",
    "query": "hello",
    "minRows": 1,
    "maxRows": 1,
    "row": 0,
    "fields": ["id", "title", "subtitle"],
    "matches": { "title": "^hello$" } },

  { "why": "the row does something: Enter copies the answer rather than nothing",
    "query": "hello",
    "minRows": 1,
    "row": 0,
    "fields": ["exec"],
    "matches": { "exec": "wl-copy$" } }
]
TXT
}

scaffold_extension_script() {
  scaffold_fill "$1" <<'SH'
#!/bin/bash
# Emits one JSON row per line for OmaCast's `@NAME@:` keyword.
#
#   @NAME@:hello    one row, echoing hello back
#   @NAME@:         the same row, with nothing typed yet
#
# This answers as it stands, so the round trip is visible before any of it is
# yours: add the unit, open the launcher, type `@NAME@:`. Replace the body with
# the real lookup and keep the shape, which is one JSON object per line, each
# { id, title, subtitle, exec }, and a `score` deciding the order among them.

set -uo pipefail

query="${1:-}"

if [[ -z $query ]]; then
  jq -cn --arg t "@TITLE@" --arg s "Type something after @NAME@:" \
    '{id: "@NAME@-hint", title: $t, subtitle: $s, exec: "", score: 90000}'
  exit 0
fi

jq -cn --arg id "@NAME@:$query" --arg t "$query" \
  --arg s "Echoed by omacast-@NAME@" \
  --arg e "printf %s $(printf '%q' "$query") | wl-copy" \
  '{id: $id, title: $t, subtitle: $s, exec: $e, score: 90000}'
SH
}

scaffold_extension_readme() {
  scaffold_fill "$1" <<'TXT'
# @NAME@

Answers `@NAME@:` in the launcher.

```bash
bo add @NAME@
```

Then open the launcher and type `@NAME@:hello`. The rows come from
`bin/omacast-@NAME@`, one JSON object per line; the JSON under
`config/omarchy/omacast/extensions/` is what tells the launcher the keyword
exists and which script answers for it.

`view` in that JSON picks the layout: `list`, `hero`, `cards`, `grid` or
`split`. `minChars` is how much has to be typed before the script runs at all,
and `when` is a test run once on load, so an extension for software you do not
have costs nothing.

```bash
bo test @NAME@
```

That runs the script and reads the answer the way the launcher does, then runs
the cases in `@NAME@.cases.json`: queries, and what the answer to each has to
look like. Three are there already and they pass against the stub, so as you
replace the body, rewrite them into what your extension promises instead.
`units/omacast/EXTENSIONS.md` has the field list.
TXT
}

# What to do next, as the commands themselves. A scaffold that leaves you
# guessing the order has only moved the problem somewhere else.
scaffold_done() {
  local name="$1" dir="$2" edit="$3" try="${4:-}" file
  say "$(green new) units/$name"
  while read -r file; do
    say "  $(dim "${file#"$SELF_ROOT/"}")"
  done < <(find "$dir" -type f | sort)

  printf '\n%s\n' "$(bold Next)"
  say "  \$EDITOR $edit"
  say "  bo add $name"
  # Linking first, because the cases run the script by the name the launcher
  # uses and that name is only on PATH once the unit is on.
  [[ -n $try ]] && say "  bo test $name $(dim '# the answer, and the cases beside it')"
  say "  bo registry $(dim '# before you commit, so bo update sees it')"
  [[ -n $try ]] && printf '\nThen open the launcher and type %s\n' "$(cyan "$try")"
  return 0
}

cmd_new_unit() {
  local name="" kind="hypr" dir edit
  while (($# > 0)); do
    case "$1" in
    --kind)
      shift
      kind="${1:-}"
      ;;
    --kind=*) kind="${1#--kind=}" ;;
    -*) die "unknown option: $1" ;;
    *)
      [[ -z $name ]] || die "one name at a time"
      name="$1"
      ;;
    esac
    shift
  done

  case "$kind" in
  hypr | plugin | setting) ;;
  *) die "kind is hypr, plugin or setting, not '${kind:-<empty>}'" ;;
  esac

  dir=$(scaffold_dir "$name") || exit 1
  mkdir -p "$dir/hypr"
  scaffold_toml "$name" "$kind" >"$dir/unit.toml"
  scaffold_readme "$name" >"$dir/README.md"
  scaffold_lua "$name" >"$dir/hypr/$name.lua"
  edit="units/$name/hypr/$name.lua"

  case "$kind" in
  plugin)
    mkdir -p "$dir/plugin"
    scaffold_manifest "$name" >"$dir/plugin/manifest.json"
    scaffold_widget "$name" >"$dir/plugin/Widget.qml"
    edit="units/$name/plugin/Widget.qml"
    ;;
  setting)
    scaffold_apply "$name" >"$dir/apply.sh"
    scaffold_revert "$name" >"$dir/revert.sh"
    chmod +x "$dir/apply.sh" "$dir/revert.sh"
    edit="units/$name/apply.sh"
    ;;
  esac

  scaffold_done "$name" "$dir" "$edit"
}

cmd_new_extension() {
  local name="" dir
  while (($# > 0)); do
    case "$1" in
    -*) die "unknown option: $1" ;;
    *)
      [[ -z $name ]] || die "one name at a time"
      name="$1"
      ;;
    esac
    shift
  done

  dir=$(scaffold_dir "$name") || exit 1
  mkdir -p "$dir/bin" "$dir/config/omarchy/omacast/extensions"
  scaffold_toml "$name" extension >"$dir/unit.toml"
  scaffold_extension_readme "$name" >"$dir/README.md"
  scaffold_extension_json "$name" >"$dir/config/omarchy/omacast/extensions/$name.json"
  scaffold_extension_cases "$name" >"$dir/config/omarchy/omacast/extensions/$name.cases.json"
  scaffold_extension_script "$name" >"$dir/bin/omacast-$name"
  chmod +x "$dir/bin/omacast-$name"

  scaffold_done "$name" "$dir" "units/$name/bin/omacast-$name" "$name:"
}

new_usage() {
  cat <<'TXT'
  bo new unit <name>       a unit folder, filled in and ready to add
                           (--kind hypr, plugin or setting)
  bo new extension <name>  a unit whose whole job is one launcher keyword
TXT
}

cmd_new() {
  local what="${1:-}"
  shift 2>/dev/null || true
  case "$what" in
  unit) cmd_new_unit "$@" ;;
  extension | ext) cmd_new_extension "$@" ;;
  "" | -h | --help | help) new_usage ;;
  *)
    say "unknown: bo new $what"
    new_usage
    return 1
    ;;
  esac
}

cmd_version() {
  local root
  printf 'bo             %s\n' "$(git -C "$SELF_ROOT" describe --tags --always --dirty 2>/dev/null || echo unknown)"
  printf 'running from   %s\n' "$SELF_ROOT"
  printf 'marketplaces   %s\n' "$(market_names | join_lines)"
  printf 'units          %s available, %s on\n' "$(all_refs | wc -l)" "$(linked_refs | wc -l)"
}

# ---------------------------------------------------------------- interactive
#
# `bo` with no arguments. Everything here is reachable as a command too, and the
# commands stay the interface a script uses: this only saves you remembering
# which one you wanted.
#
# gum does the drawing. It is not a dependency of anything else in bo, so a
# machine without it still has every command, just not this.

tui_available() { command -v gum >/dev/null; }

tui_header() {
  local markets units on
  markets=$(market_names | join_lines)
  units=$(all_refs | wc -l)
  on=$(linked_refs | wc -l)

  gum style --border rounded --padding "0 2" --margin "0" --border-foreground 240 \
    "$(gum style --bold 'better-omarchy')  $(gum style --foreground 240 "$(cd "$SELF_ROOT" && git describe --tags --always 2>/dev/null || echo unknown)")" \
    "$(gum style --foreground 240 "$on of $units units on  ·  $markets")"
}

# One line per unit, marked and aligned, for the picker to show.
tui_unit_line() {
  local ref="$1" mark
  if is_linked "$ref"; then mark="●"; else mark="○"; fi

  printf '%s %-26s %-9s %-13s %s' \
    "$mark" "$(ref_unit "$ref")" "$(meta "$ref" kind)" "$(meta "$ref" category)" "$(meta "$ref" summary)"
}

# The ref a picked line refers to. The line carries the bare unit name, which is
# ambiguous across marketplaces, so the list is rebuilt and matched by position.
tui_ref_for_line() {
  local line="$1" ref
  while read -r ref; do
    [[ "$(tui_unit_line "$ref")" == "$line" ]] && {
      printf '%s' "$ref"
      return 0
    }
  done < <(all_refs)
  return 1
}

tui_units() {
  local lines=() ref picked chosen

  while read -r ref; do
    lines+=("$(tui_unit_line "$ref")")
  done < <(all_refs)

  ((${#lines[@]} > 0)) || {
    say "No units. Add a marketplace first."
    return 0
  }

  picked=$(printf '%s\n' "${lines[@]}" |
    gum filter --no-limit --height 16 --prompt "  " \
      --placeholder "type to filter, tab to mark, enter to act on them" \
      --header "$(printf '  %-26s %-9s %-13s %s   (esc to go back)' UNIT KIND CATEGORY SUMMARY)") || return 0

  [[ -z $picked ]] && return 0

  # Marked units are acted on together, and what to do is asked once. Asking per
  # unit would make turning six things on six questions.
  local refs=() line
  while read -r line; do
    [[ -z $line ]] && continue
    chosen=$(tui_ref_for_line "$line") && refs+=("$chosen")
  done <<<"$picked"

  ((${#refs[@]} > 0)) || return 0

  local action
  action=$(printf 'Turn on\nTurn off\nShow details\nBack\n' |
    gum choose --header "${#refs[@]} selected   (esc to go back)") || return 0

  case "$action" in
  "Turn on")
    for chosen in "${refs[@]}"; do link_unit "$chosen"; done
    tui_pause
    ;;
  "Turn off")
    for chosen in "${refs[@]}"; do unlink_unit "$chosen"; done
    tui_pause
    ;;
  "Show details")
    for chosen in "${refs[@]}"; do
      cmd_info "$chosen"
      say ""
    done
    tui_pause
    ;;
  esac
}

tui_markets() {
  local action name

  cmd_market_list
  say ""

  action=$(printf 'Add a marketplace\nUpdate all\nRemove one\nBack\n' |
    gum choose --header "esc to go back") || return 0

  case "$action" in
  "Add a marketplace")
    local url
    url=$(gum input --placeholder "https://github.com/someone/their-units" \
      --prompt "git url  ") || return 0
    [[ -n $url ]] || return 0
    cmd_market_add "$url"
    tui_pause
    ;;
  "Update all")
    cmd_market_update
    tui_pause
    ;;
  "Remove one")
    name=$(market_names | gum choose --header "Remove which marketplace?") || return 0
    [[ -n $name ]] || return 0
    cmd_market_remove "$name"
    tui_pause
    ;;
  esac
}

tui_checks() {
  local action
  action=$(printf 'Status and key conflicts\nDependencies\nTest every extension\nValidate plugins\nBack\n' |
    gum choose --header "esc to go back") || return 0

  case "$action" in
  "Status and key conflicts") cmd_status ;;
  "Dependencies") cmd_doctor ;;
  "Test every extension") cmd_test ;;
  "Validate plugins") cmd_validate ;;
  *) return 0 ;;
  esac

  tui_pause
}

# Wait for a key, any key. Not `gum input`, which exits non-zero on Escape and
# would take the whole menu down with it: the one thing Escape must never do
# from inside a screen is quit.
tui_pause() {
  say ""
  printf '%s' "$(gum style --foreground 240 '  any key to go back')"
  read -rsn1 </dev/tty
  printf '\r%*s\r' 30 ""
}

cmd_tui() {
  tui_available || {
    usage
    return 0
  }

  # One screen per loop, cleared, so the terminal does not fill with the last
  # five things you looked at.
  while true; do
    clear
    tui_header
    say ""

    local choice
    choice=$(printf 'Units\nMarketplaces\nUpdate everything\nChecks\nVersion\nQuit\n' |
      gum choose --height 8 --header "esc to quit") || return 0

    case "$choice" in
    Units) tui_units ;;
    Marketplaces) tui_markets ;;
    "Update everything")
      cmd_update
      tui_pause
      ;;
    Checks) tui_checks ;;
    Version)
      cmd_version
      tui_pause
      ;;
    Quit | "") return 0 ;;
    esac

  done
}

usage() {
  cat <<'TXT'
bo - Omarchy customizations, from any marketplace

  bo list                 every unit available, and whether it is on
  bo list --json          the same, for a program: adds what is missing,
                          what a conflict blocks, and which toggles reload
                          the shell
  bo search <term>        find a unit by name, summary, category or tag
  bo info <unit>          everything known about one unit
  bo status               what is on, plus keybinding conflicts
  bo diff <unit>          what it changed, against the snapshot from install
  bo snapshots            every snapshot here, including orphaned ones
  bo restore <unit>       replay a snapshot, even if the unit is gone

  bo add [unit...]        turn units on (no argument opens a picker)
  bo remove [unit...]     turn units off (no argument opens a picker)
  bo remove --purge ...   also delete a widget's bar position and settings

  bo new unit <name>      start a unit here, filled in and ready to add
  bo new extension <name> start a unit whose job is one launcher keyword

  bo update               fetch every marketplace, show what changed, apply
  bo outdated             linked units whose marketplace moved on
  bo relink               apply those changes

  bo market ...           add, remove and inspect marketplaces
  bo doctor               check every linked unit's dependencies exist
  bo uninstall            turn everything off and take bo off this machine
  bo test [target...]     run launcher extensions and check what they print
  bo test --fast          only the checks that run nothing (under a second)
  bo validate             run omarchy plugin validate on every plugin unit
  bo registry [name]      rebuild a marketplace's registry.json (authors)
  bo sync                 copy the live shell.json into this checkout
  bo version              what this is and where it lives

Run `bo` with no arguments for the interactive version of all of this.

Nothing that runs code or pulls a change in happens without being asked first.
`--yes` (or `--trust`) answers yes to every question, for scripts. Without a
terminal and without `--yes`, bo does nothing rather than guess.

A `!` in `bo list` is a unit that runs something: a script on your PATH, an
`apply.sh`, or plugin code inside omarchy-shell. `bo info <unit>` says which.

`bo remove` takes back what bo put there and keeps what you arranged by hand, so
a widget's place in the bar and its settings survive to make `bo add` put it
back. `--purge` takes those too, after asking.

`bo update` also refreshes the `bo` link itself, and `bo list` says once a day
when the marketplace it came from has moved on.

A unit is named `marketplace/unit`, and the marketplace half can be left off
when only one marketplace offers that name.
TXT
}

case "${1:-}" in
# The stale check forks a git fetch and writes a stamp. That is right once a day
# in a terminal and wrong on a keystroke, and `--json` is only ever a keystroke.
list | ls) [[ ${2:-} == --json ]] || check_self_stale; shift; cmd_list "$@" ;;
diff) shift; cmd_diff "$@" ;;
restore) shift; cmd_restore "$@" ;;
snapshots) shift; cmd_snapshots "$@" ;;
search | find) shift; cmd_search "$@" ;;
info | show) shift; cmd_info "$@" ;;
status) check_self_stale; cmd_status ;;
add | install) shift; cmd_add "$@" ;;
remove | rm) shift; cmd_remove "$@" ;;
uninstall) shift; cmd_uninstall "$@" ;;
new | create) shift; cmd_new "$@" ;;
update | upgrade) shift; cmd_update "$@" ;;
outdated) cmd_outdated ;;
relink) cmd_relink ;;
market | marketplace) shift; cmd_market "$@" ;;
doctor) cmd_doctor ;;
test) shift; cmd_test "$@" ;;
validate) cmd_validate ;;
registry) shift; cmd_registry "$@" ;;
sync) cmd_sync ;;
version | --version | -V) cmd_version ;;
"") cmd_tui ;;
-h | --help | help) usage ;;
ui | tui) cmd_tui ;;
*) die "unknown command: $1. Try: bo help" ;;
esac

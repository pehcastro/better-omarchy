# ---------------------------------------------------------------- testing
#
# Nothing else looks at what an extension prints. A script that emits malformed
# JSON fails silently in the launcher, because one unparseable line is skipped
# so the rest of a long answer survives, and the result is a keyword that shows
# nothing and says nothing. This runs each one and reads the answer the way the
# launcher would, then says where it stopped making sense.

# The query every extension is asked. Short, harmless, and nothing in
# particular, because this tests the shape of an answer and not its content.
TEST_QUERY="test"

# ok, skipped and fail line up in one column, so one failure in a long run is
# findable rather than buried in a sentence.
test_line() {
  local state="$1" name="$2" mark
  shift 2
  case "$state" in
  ok) mark=$(green "$(printf '%-7s' ok)") ;;
  skipped) mark=$(dim "$(printf '%-7s' skipped)") ;;
  *) mark=$(red "$(printf '%-7s' fail)") ;;
  esac
  printf '  %s %-22s %s\n' "$mark" "$name" "$*"
}

# One extension JSON, read in a single pass: whether it is usable, which command
# it names, how long to wait, that command with its placeholders filled in twice
# over, and its `when` gate. A problem comes back as one line starting with `!`,
# so a caller never has to parse a report to find out whether it is one.
ext_meta() {
  python3 - "$1" "$2" <<'PY'
import json, re, shlex, sys

VIEWS = ("list", "hero", "cards", "grid", "split", "dashboard", "calendar", "player", "answer", "slider", "form", "timegrid", "zones", "gitrepo", "gitbranches", "gitstashes", "agent")
TIERS = ("calc", "forced", "prefix", "substring", "weak", "file", "web")
NUMBERS = ("minChars", "debounceMs", "timeoutMs", "maxRows")

path, sample = sys.argv[1:3]


def fail(message):
    print("!" + message)
    sys.exit(0)


try:
    ext = json.load(open(path, encoding="utf-8"))
except Exception as e:
    fail(f"not JSON: {e}")

if not isinstance(ext, dict):
    fail("the top level is not an object")

# The launcher drops an extension with neither of these and says nothing, so a
# typo in either key costs a keyword with no error anywhere.
if not str(ext.get("id", "")).strip():
    fail("no id, so the launcher ignores the file without a word")
search = str(ext.get("search", "")).strip()
if not search:
    fail("no search, so the launcher ignores the file without a word")

view = ext.get("view")
if view is not None and view not in VIEWS:
    fail(f"view is {view!r}, and it is one of: {', '.join(VIEWS)}")

tier = ext.get("tier")
if tier is not None and tier not in TIERS:
    fail(f"tier is {tier!r}, and it is one of: {', '.join(TIERS)}")

for key in NUMBERS:
    if key not in ext:
        continue
    value = ext[key]
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        fail(f"{key} is {value!r}, which is not a number")

# {query} takes the query, shell quoted; every other placeholder takes an empty
# argument, which is what the launcher passes for a filter nobody typed.
def command(query):
    return re.sub(
        r"\{([A-Za-z0-9_-]+)\}",
        lambda m: shlex.quote(query) if m.group(1).lower() == "query" else "''",
        search,
    )


timeout = ext.get("timeoutMs", 4000)
seconds = max(1, int((timeout + 999) // 1000))

# An extension whose minChars is 0 is the kind that answers a bare `sys:` with
# everything it has and a typed `sys:test` with nothing, so it is asked both
# ways. Testing only the typed form would test almost nothing.
bare = command("") if ext.get("minChars", 1) == 0 else ""

print("ok")
print(search.split()[0])
print(seconds)
print(command(sample))
print(bare)
print(str(ext.get("when", "")).replace("\n", " "))
PY
}

# What came back, checked the way the launcher reads it. Prints how many rows
# there were, or one `!` line naming the first problem with the output that
# caused it under it.
ext_rows() {
  python3 - "$1" <<'PY'
import json, sys

text = open(sys.argv[1], encoding="utf-8", errors="replace").read().strip()


def fail(message, offending=""):
    print("!" + message)
    if offending:
        print(offending[:400])
    sys.exit(0)


def number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool)


if text == "":
    print(0)
    sys.exit(0)

# A whole document first, array or single object, then one object per line. The
# launcher skips a line it cannot parse so that one bad row does not lose the
# other forty; here that silence is the thing being hunted, so a bad line is the
# answer rather than being stepped over.
try:
    whole = json.loads(text)
except ValueError:
    whole = None

rows = None
if isinstance(whole, list):
    rows = whole
elif isinstance(whole, dict):
    rows = [whole]

if rows is None:
    rows = []
    for n, line in enumerate(text.splitlines(), 1):
        line = line.strip()
        if not line:
            continue
        try:
            rows.append(json.loads(line))
        except ValueError as e:
            fail(f"line {n} is not JSON: {e}", line)

for n, row in enumerate(rows, 1):
    dump = json.dumps(row) if not isinstance(row, str) else row
    if not isinstance(row, dict):
        fail(f"row {n} is not an object", dump)

    title = row.get("title")
    if title is None or isinstance(title, bool) or str(title).strip() == "":
        fail(f"row {n} has no title, so the launcher drops it", dump)

    if "exec" in row and not isinstance(row["exec"], str):
        fail(f"row {n}: exec is not a string", dump)

    if "score" in row and not number(row["score"]):
        fail(f"row {n}: score is not a number", dump)

    if "progress" in row:
        progress = row["progress"]
        if not number(progress):
            fail(f"row {n}: progress is not a number", dump)
        if not 0 <= progress <= 1:
            fail(f"row {n}: progress is {progress}, and it is a fraction from 0 to 1", dump)

    actions = row.get("actions")
    if actions is not None:
        if not isinstance(actions, list):
            fail(f"row {n}: actions is not an array", dump)
        for i, action in enumerate(actions, 1):
            if not isinstance(action, dict):
                fail(f"row {n}: action {i} is not an object", dump)
            if str(action.get("title", "")).strip() == "":
                fail(f"row {n}: action {i} has no title", dump)

print(len(rows))
PY
}

# Run one command and read what it printed. Prints a row count, or a `!` line
# and the output that caused it, the same shape ext_rows uses.
ext_answer() {
  local cmd="$1" secs="$2" out err status
  out=$(mktemp)
  err=$(mktemp)

  # stderr is kept apart, because the launcher reads stdout alone: a script that
  # warns and still answers is fine, and one that only warns is not.
  timeout "$secs" bash -lc "$cmd" >"$out" 2>"$err"
  status=$?

  if ((status == 124)); then
    printf '!no answer in %ss\n%s\n' "$secs" "$cmd"
  elif [[ ! -s $out && -s $err ]]; then
    printf '!printed nothing, and wrote to stderr\n'
    head -5 "$err"
  else
    ext_rows "$out"
  fi

  rm -f "$out" "$err"
}

rows_word() { ((${1:-0} == 1)) && printf '1 row' || printf '%s rows' "${1:-0}"; }

test_extension() {
  local file="$1" dir="$2" name binary secs when problem detail cmd
  local -a info result queries counts=()
  name=$(basename "$file" .json)

  mapfile -t info < <(ext_meta "$file" "$TEST_QUERY")
  problem="${info[0]:-!could not be read at all}"
  [[ $problem == ok ]] || {
    test_line fail "$name" "${problem#!}"
    return 1
  }
  binary="${info[1]:-}"
  secs="${info[2]:-4}"
  queries=("${info[3]:-}")
  [[ -n ${info[4]:-} ]] && queries+=("${info[4]}")
  when="${info[5]:-}"

  # A script the unit ships but has not linked is the common case here, and it
  # is worth saying which of the two problems it is: the launcher runs whatever
  # is on PATH and knows nothing about bin/.
  command -v "$binary" >/dev/null || {
    if [[ -e "$dir/bin/$binary" ]]; then
      test_line fail "$name" "search names $binary, which this unit ships and has not linked: bo relink"
    else
      test_line fail "$name" "search names $binary, which is not on PATH"
    fi
    return 1
  }

  # The `when` gate first. An extension for software this machine does not have
  # is not a failure, it is an extension that correctly never runs here.
  if [[ -n $when ]] && ! bash -lc "$when" >/dev/null 2>&1; then
    test_line skipped "$name" "when condition false: $when"
    return 0
  fi

  for cmd in "${queries[@]}"; do
    mapfile -t result < <(ext_answer "$cmd" "$secs")
    problem="${result[0]:-!the output could not be read at all}"
    [[ $problem != '!'* ]] || {
      test_line fail "$name" "${problem#!}"
      ((${#result[@]} > 1)) && printf '%s\n' "${result[@]:1}" | sed 's/^/          /'
      return 1
    }
    counts+=("$problem")
  done

  detail="$(rows_word "${counts[0]}")"
  [[ -n ${counts[1]:-} ]] && detail+=", ${counts[1]} bare"
  test_line ok "$name" "$detail"

  test_actions "$file" "$binary" "$secs" || return 1
  test_cases "$file" "$binary" "$secs" || return 1
}

# Every action on every row has to be able to run.
#
# An action that does nothing is the worst kind of broken: the panel lists it,
# the key works, the row highlights, and then nothing happens and there is
# nothing to see. It happened three times in one evening, and each time the
# cause was mechanical and checkable: a command that is not installed, a script
# the unit ships and has not linked, a `query` pointing at a keyword nobody
# registered.
#
# So every exec is taken apart and its program looked for. This does not run
# anything: it reads the first word out of the command, follows `sh -c` and the
# omarchy launchers to the real program inside, and asks whether that exists.
ACTIONS_PY='
import json, os, re, shutil, subprocess, sys

binary, query, timeout = sys.argv[1], sys.argv[2], float(sys.argv[3])

try:
    out = subprocess.run([binary, query], capture_output=True, text=True, timeout=timeout).stdout
except Exception as exc:
    print("!could not run: %s" % exc)
    sys.exit(0)

rows = []
text = out.strip()
if text.startswith("["):
    try:
        rows = json.loads(text)
    except Exception:
        rows = []
else:
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rows.append(json.loads(line))
        except Exception:
            pass

# Wrappers that take the real program as an argument. Checking the wrapper alone
# would pass an action that runs a program nobody has.
WRAPPERS = {
    "omarchy-launch-tui", "omarchy-launch-browser", "omarchy-launch-editor",
    "uwsm-app", "setsid", "timeout", "env", "nohup",
}
SKIP_ARG = re.compile(r"^(--?[A-Za-z0-9-]+(=.*)?)$")

def program_of(command):
    """The program an exec actually runs, or None when it is a shell fragment
    whose first word is a variable, a builtin, or an assignment."""
    parts = command.strip().split()
    while parts:
        head = parts[0]
        if head in ("sh", "bash") and len(parts) > 2 and parts[1] in ("-c", "-lc"):
            # The command is the quoted string after -c, and its first word is
            # what runs.
            inner = command.split(parts[1], 1)[1].strip().strip("\x27\"")
            return program_of(inner) if inner else None
        if head in WRAPPERS:
            parts = [p for p in parts[1:] if not SKIP_ARG.match(p)]
            # A browser launcher takes a URL, not a program. Unwrapping past it
            # asked whether "https://github.com/tmux/tmux" was installed.
            if parts and re.match(r"^[\x27\"]?[a-z]+://", parts[0]):
                return None
            continue
        if "=" in head and not head.startswith("/"):
            # `out=$(docker stop x)` is an assignment whose program is inside
            # the substitution. Skipping the whole word left "stop" as the head
            # and reported that stop was not installed.
            after = head.split("=", 1)[1]
            if after.startswith("$("):
                return program_of(after[2:] + " " + " ".join(parts[1:]))
            parts = parts[1:]
            continue
        if head in ("true", "false", ":", "printf", "echo", "cd", "exit", "test", "["):
            return None
        return head
    return None

missing = {}
seen_rows = 0
for row in rows:
    seen_rows += 1
    actions = row.get("actions") or []
    for action in actions:
        exec_ = str(action.get("exec") or "")
        if not exec_:
            if action.get("query") is None:
                missing.setdefault("an action with neither exec nor query", set()).add(
                    str(action.get("title") or "?"))
            continue
        program = program_of(exec_)
        if program is None or program.startswith("$") or program.startswith("{"):
            continue
        if program.startswith("/") or program.startswith("~"):
            if not os.path.exists(os.path.expanduser(program)):
                missing.setdefault(program, set()).add(str(action.get("title") or "?"))
            continue
        if shutil.which(program) is None:
            missing.setdefault(program, set()).add(str(action.get("title") or "?"))

print(seen_rows)
for program, titles in sorted(missing.items()):
    print("!%s is not installed, used by: %s" % (program, ", ".join(sorted(titles))))
'

# Checks that every action an extension offers can actually run.
test_actions() {
  local file="$1" binary="$2" secs="$3" name probe
  local -a lines
  name=$(basename "$file" .json)
  probe=$(json_get "$file" testQuery)
  [[ -n $probe ]] || probe=""

  mapfile -t lines < <(python3 -c "$ACTIONS_PY" "$binary" "$probe" "$secs" 2>&1)

  if ((${#lines[@]} <= 1)); then
    return 0
  fi

  test_line fail "$name actions" "$((${#lines[@]} - 1)) cannot run"
  printf '%s\n' "${lines[@]:1}" | sed 's/^!/          /'
  return 1
}

# Cases: what an extension must still answer after somebody changes it.
#
# `bo test` already proves an extension runs and returns valid JSON. That is not
# enough. Moving the clock out of a `tz:` row title into its own field kept every
# row valid and left the hero drawing cities with no times against them, and
# nothing caught it until a screen recording did, two hours later.
#
# So an extension may ship `<name>.cases.json` beside its own JSON: a list of
# queries and what the answer has to look like.
#
#   [
#     { "why": "a city gives a hero with a clock",
#       "query": "tokyo",
#       "minRows": 2,
#       "row": 0,
#       "view": "hero",
#       "fields": ["clock", "title"],
#       "matches": { "clock": "^[0-9]{2}:[0-9]{2}$" } }
#   ]
#
# `fields` must be present and non-empty. `matches` is a regex per field.
# `absent` is the other direction. `row` picks which row to look at, default 0.
# `why` is printed when it fails, because a failing assertion should say what it
# was protecting rather than only which key was wrong.
CASES_PY='
import json, re, subprocess, sys

path, binary, timeout = sys.argv[1], sys.argv[2], float(sys.argv[3])

with open(path) as fh:
    cases = json.load(fh)

failures = []
for case in cases:
    query = case.get("query", "")
    try:
        out = subprocess.run([binary, query], capture_output=True, text=True,
                             timeout=timeout).stdout
    except subprocess.TimeoutExpired:
        failures.append((case, "did not answer in %gs" % timeout))
        continue

    rows = []
    text = out.strip()
    if text.startswith("["):
        try:
            rows = json.loads(text)
        except Exception as exc:
            failures.append((case, "output is not JSON: %s" % exc))
            continue
    else:
        for line in text.splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(json.loads(line))
            except Exception as exc:
                failures.append((case, "a line is not JSON: %s" % exc))
                break

    need = case.get("minRows")
    if need is not None and len(rows) < need:
        failures.append((case, "%d rows, wanted at least %d" % (len(rows), need)))
        continue

    if case.get("maxRows") is not None and len(rows) > case["maxRows"]:
        failures.append((case, "%d rows, wanted at most %d" % (len(rows), case["maxRows"])))
        continue

    if not rows:
        continue

    index = case.get("row", 0)
    if index >= len(rows):
        failures.append((case, "no row %d, there are %d" % (index, len(rows))))
        continue
    row = rows[index]

    want_view = case.get("view")
    if want_view is not None and str(row.get("view", "")) != want_view:
        failures.append((case, "row %d is view %r, wanted %r"
                         % (index, row.get("view", ""), want_view)))
        continue

    bad = False
    for field in case.get("fields", []):
        value = row.get(field)
        if value in (None, "", [], {}):
            failures.append((case, "row %d has no %s" % (index, field)))
            bad = True
    for field in case.get("absent", []):
        if row.get(field) not in (None, "", [], {}):
            failures.append((case, "row %d still carries %s" % (index, field)))
            bad = True
    # How many, when the field is a list. Counting through a regex on the
    # serialised list was the first attempt and it measured exec string length,
    # which is not what "no more than three actions" means.
    for field, limit in (case.get("atMost") or {}).items():
        value = row.get(field)
        if isinstance(value, (list, dict)) and len(value) > limit:
            failures.append((case, "row %d has %d %s, wanted at most %d"
                             % (index, len(value), field, limit)))
            bad = True

    for field, pattern in (case.get("matches") or {}).items():
        value = str(row.get(field, ""))
        if not re.search(pattern, value):
            failures.append((case, "row %d %s is %r, wanted /%s/" % (index, field, value, pattern)))
            bad = True
    if bad:
        continue

print(len(cases))
for case, why in failures:
    print("!%s  (%s)" % (why, case.get("why") or case.get("query", "")))
'

# Runs an extension's cases, if it has any.
test_cases() {
  local file="$1" binary="$2" secs="$3" name cases total
  local -a lines
  name=$(basename "$file" .json)
  cases="${file%.json}.cases.json"
  [[ -f $cases ]] || return 0

  mapfile -t lines < <(python3 -c "$CASES_PY" "$cases" "$binary" "$secs" 2>&1)
  total="${lines[0]:-0}"

  if ((${#lines[@]} <= 1)); then
    test_line ok "$name cases" "$total held"
    return 0
  fi

  test_line fail "$name cases" "$((${#lines[@]} - 1)) of $total broke"
  printf '%s\n' "${lines[@]:1}" | sed 's/^!/          /'
  return 1
}

# A unit.toml that is wrong fails later and further away: bo registry refuses to
# build, or a plugin links under a name Omarchy never enables.
test_unit_toml() {
  local ref="$1" dir kind key id manifest
  local -a missing=()
  dir=$(ref_dir "$ref")

  for key in name summary version kind; do
    [[ -n $(meta "$ref" "$key") ]] || missing+=("$key")
  done
  ((${#missing[@]} == 0)) || {
    test_line fail unit.toml "no $(printf '%s\n' "${missing[@]}" | join_lines)"
    return 1
  }

  [[ $(meta "$ref" name) == "$(ref_unit "$ref")" ]] || {
    test_line fail unit.toml "name is $(meta "$ref" name), and the folder is $(ref_unit "$ref")"
    return 1
  }

  kind=$(meta "$ref" kind)
  case "$kind" in
  plugin | hypr | setting) ;;
  *)
    test_line fail unit.toml "kind is '$kind', and it is one of: plugin, hypr, setting"
    return 1
    ;;
  esac

  if [[ $kind == plugin ]]; then
    id=$(meta "$ref" id)
    manifest="$dir/plugin/manifest.json"
    [[ -n $id ]] || {
      test_line fail unit.toml "kind is plugin and there is no id to link it under"
      return 1
    }
    [[ -f $manifest ]] || {
      test_line fail unit.toml "kind is plugin and there is no plugin/manifest.json"
      return 1
    }
    [[ $(json_get "$manifest" id) == "$id" ]] || {
      test_line fail unit.toml "id is $id, and manifest.json says $(json_get "$manifest" id)"
      return 1
    }
  fi

  test_line ok unit.toml "$kind, $(meta "$ref" version)"
}

test_unit() {
  local ref="$1" dir file bad=0
  dir=$(ref_dir "$ref")

  say "$(bold "$ref")"
  test_unit_toml "$ref" || bad=1

  shopt -s nullglob
  for file in "$dir"/config/omarchy/omacast/extensions/*.json; do
    # `<name>.cases.json` belongs to the extension beside it and is checked as
    # part of it, not loaded as an extension of its own.
    [[ $file == *.cases.json ]] && continue
    test_extension "$file" "$dir" || bad=1
  done
  shopt -u nullglob

  return $bad
}

cmd_test() {
  local ref refs failed=0
  if (($# > 0)); then
    refs=$(resolve_ref "$1")
  else
    refs=$(all_refs)
  fi

  command -v timeout >/dev/null || die "timeout is not installed, and a test that cannot give up would hang"

  while read -r ref; do
    [[ -z $ref ]] && continue
    test_unit "$ref" || failed=1
  done <<<"$refs"

  say ""
  if ((failed == 0)); then
    say "$(green 'Every extension answered, and every unit.toml holds up.')"
  else
    say "$(red 'Something above needs fixing.')"
  fi
  return $failed
}

cmd_validate() {
  local ref failed=0 dir
  while read -r ref; do
    [[ $(meta "$ref" kind) == plugin ]] || continue
    dir=$(readlink -f "$(ref_dir "$ref")/plugin")
    if omarchy plugin validate "$dir" >/dev/null 2>&1; then
      say "$(green ok) $ref"
    else
      say "$(red fail) $ref"
      omarchy plugin validate "$dir" 2>&1 | sed 's/^/    /'
      failed=1
    fi
  done < <(all_refs)
  return $failed
}

cmd_sync() {
  local live="$CONFIG_HOME/omarchy/shell.json" tracked="$SELF_ROOT/config/shell.json"
  [[ -f $live ]] || die "no $live"
  [[ -d "$SELF_ROOT/units" ]] || die "bo is not running from a marketplace checkout"
  mkdir -p "$(dirname "$tracked")"
  if cmp -s "$live" "$tracked"; then
    say "shell.json unchanged"
  else
    cp "$live" "$tracked"
    say "$(green updated) $tracked"
  fi
}

# ---------------------------------------------------------------- scaffolding
#
# A first unit is boilerplate you would otherwise reverse-engineer out of three
# other units, so bo writes it. Everything scaffolded here is valid as it
# stands: `bo add` links it without an edit, and a scaffolded extension answers
# its keyword the moment the launcher reloads.

# unit.toml is written a line at a time rather than from a template, so the =
# column lands where every other unit in this repo has it.
toml_line() { printf '%-8s = %s\n' "$1" "$2"; }
toml_string() { toml_line "$1" "\"$2\""; }

toml_array() {
  local key="$1" out="" item
  shift
  for item in "$@"; do
    [[ -n $out ]] && out+=", "
    out+="\"$item\""
  done
  toml_line "$key" "[$out]"
}

scaffold_author() {
  local who
  who=$(git -C "$SELF_ROOT" config user.name 2>/dev/null)
  printf '%s' "${who:-${USER:-you}}"
}

# search-files -> Search Files, for the human-facing half of a plugin manifest.
scaffold_title() { printf '%s' "${1//-/ }" | sed -E 's/(^| )([a-z])/\1\u\2/g'; }

# The checks every scaffold shares: this has to be a marketplace checkout, the
# name has to be one `bo add` can resolve, and an existing folder is never
# written into, because the folder is somebody's work.
scaffold_dir() {
  local name="$1" dir
  [[ -n $name ]] || die "no name. Try: bo new unit <name>"
  [[ $name =~ ^[a-z0-9][a-z0-9-]*$ ]] ||
    die "'$name' will not do as a unit name: lowercase letters, digits and dashes"
  [[ -d "$SELF_ROOT/units" ]] || die "bo is not running from a marketplace checkout"

  dir="$SELF_ROOT/units/$name"
  [[ -e $dir ]] && die "units/$name already exists. Pick another name, or edit that one."
  printf '%s' "$dir"
}

scaffold_toml() {
  local name="$1" kind="$2" author
  author=$(scaffold_author)

  toml_string name "$name"
  toml_string summary "What this does, in one line"
  toml_string version "0.1.0"

  case "$kind" in
  plugin)
    toml_string category "System"
    toml_array tags bar
    toml_string author "$author"
    toml_string kind plugin
    toml_string id "bo.$name"
    toml_array needs
    ;;
  setting)
    toml_string category "System"
    toml_array tags system
    toml_string author "$author"
    toml_string kind setting
    toml_array needs omarchy
    ;;
  extension)
    toml_string category "Productivity"
    toml_array tags launcher
    toml_string author "$author"
    toml_string kind hypr
    toml_array needs jq wl-copy
    toml_array requires omacast
    ;;
  *)
    toml_string category "Compositor"
    toml_array tags hyprland
    toml_string author "$author"
    toml_string kind hypr
    toml_array needs
    ;;
  esac

  toml_array keys
}

# Markdown and QML carry $ and backticks of their own, so the text is written
# verbatim and the name substituted after. A name is checked against
# [a-z0-9-] above, so nothing in it can mean anything to sed.
scaffold_fill() { sed "s/@NAME@/$1/g; s/@TITLE@/$(scaffold_title "$1")/g"; }

scaffold_readme() {
  scaffold_fill "$1" <<'TXT'
# @NAME@

One line on what this turns on.

```bash
bo add @NAME@
```

What it changes while it is on, and what comes back when you turn it off.
TXT
}

scaffold_lua() {
  scaffold_fill "$1" <<'LUA'
-- @NAME@: what this changes, and why it is worth changing.
--
-- Linked into ~/.config/hypr/modules.d/ and read by bo's own loader, so this is
-- ordinary Omarchy Lua config. Delete the file if this unit never touches the
-- compositor: bo links whatever .lua it finds here and nothing if there is
-- none.

-- o.bind("SUPER + J", "What it does", "some-command")
-- hl.config({ general = { gaps_in = 4 } })
LUA
}

scaffold_manifest() {
  local name="$1"
  jq -n --arg id "bo.$name" --arg title "$(scaffold_title "$name")" \
    --arg author "$(scaffold_author)" \
    --arg what "What this widget shows, in one line" \
    '{
       schemaVersion: 1, id: $id, name: $title, version: "1.0.0",
       author: $author, description: $what,
       kinds: ["bar-widget"],
       entryPoints: { barWidget: "Widget.qml" },
       barWidget: {
         displayName: $title, description: $what,
         category: "System", allowMultiple: false
       }
     }'
}

scaffold_widget() {
  scaffold_fill "$1" <<'QML'
import QtQuick
import qs.Commons
import qs.Ui

// One bar widget. Omarchy scans ~/.config/omarchy/plugins for a manifest and
// loads whatever entryPoints names, so the file name here and the one in
// manifest.json have to agree.
BarWidget {
  id: root
  moduleName: "bo.@NAME@"

  implicitWidth: button.implicitWidth
  implicitHeight: button.implicitHeight

  BarIconButton {
    id: button
    anchors.fill: parent
    bar: root.bar
    text: "󰋙"
    slotSize: Style.bar.statusSlot
    fontSize: Style.font.caption
    tooltipText: "@TITLE@"
    onPressed: if (root.bar) root.bar.run("omarchy-notification-send '@TITLE@' 'Replace this'")
  }
}
QML
}

# apply.sh and revert.sh take -e, unlike the extension scripts, because bo reads
# their exit status: a setting that half applied has to say so rather than pass.
scaffold_apply() {
  scaffold_fill "$1" <<'SH'
#!/bin/bash
# Run once, by `bo add @NAME@`. bo records that a setting ran, not what it
# did, so this has to be safe to run a second time.

set -euo pipefail

# The change itself goes here, for instance:
#   omarchy toggle idle stay-awake >/dev/null
true
SH
}

scaffold_revert() {
  scaffold_fill "$1" <<'SH'
#!/bin/bash
# Run by `bo remove @NAME@`. It puts back whatever apply.sh changed, which is
# the whole reason a setting unit can be turned off at all.

set -euo pipefail

# The undo goes here, for instance:
#   omarchy toggle idle allow-idle >/dev/null
true
SH
}

scaffold_extension_json() {
  local name="$1"
  jq -n --arg id "$name" --arg title "$(scaffold_title "$name")" \
    --arg search "omacast-$name {query}" \
    '{
       id: $id, title: $title, keyword: $id, aliases: [],
       subtitle: $title, glyph: "", search: $search,
       minChars: 0, debounceMs: 120, maxRows: 8,
       tier: "prefix", view: "list"
     }'
}

# The cases the stub already passes. A scaffold that starts red teaches you to
# ignore the test; one that starts with nothing teaches you tests are optional.
# These three hold against the script beside them, so the first thing you do to
# them is edit them into what your extension actually promises.
scaffold_extension_cases() {
  scaffold_fill "$1" <<'TXT'
[
  { "why": "a bare @NAME@: still answers, with the hint that says what to type",
    "query": "",
    "minRows": 1,
    "row": 0,
    "fields": ["id", "title", "subtitle"],
    "matches": { "id": "^@NAME@-hint$" } },

  { "why": "what was typed comes back as the title of one row, not two and not none",
    "query": "hello",
    "minRows": 1,
    "maxRows": 1,
    "row": 0,
    "fields": ["id", "title", "subtitle"],
    "matches": { "title": "^hello$" } },

  { "why": "the row does something: Enter copies the answer rather than nothing",
    "query": "hello",
    "minRows": 1,
    "row": 0,
    "fields": ["exec"],
    "matches": { "exec": "wl-copy$" } }
]
TXT
}

scaffold_extension_script() {
  scaffold_fill "$1" <<'SH'
#!/bin/bash
# Emits one JSON row per line for OmaCast's `@NAME@:` keyword.
#
#   @NAME@:hello    one row, echoing hello back
#   @NAME@:         the same row, with nothing typed yet
#
# This answers as it stands, so the round trip is visible before any of it is
# yours: add the unit, open the launcher, type `@NAME@:`. Replace the body with
# the real lookup and keep the shape, which is one JSON object per line, each
# { id, title, subtitle, exec }, and a `score` deciding the order among them.

set -uo pipefail

query="${1:-}"

if [[ -z $query ]]; then
  jq -cn --arg t "@TITLE@" --arg s "Type something after @NAME@:" \
    '{id: "@NAME@-hint", title: $t, subtitle: $s, exec: "", score: 90000}'
  exit 0
fi

jq -cn --arg id "@NAME@:$query" --arg t "$query" \
  --arg s "Echoed by omacast-@NAME@" \
  --arg e "printf %s $(printf '%q' "$query") | wl-copy" \
  '{id: $id, title: $t, subtitle: $s, exec: $e, score: 90000}'
SH
}

scaffold_extension_readme() {
  scaffold_fill "$1" <<'TXT'
# @NAME@

Answers `@NAME@:` in the launcher.

```bash
bo add @NAME@
```

Then open the launcher and type `@NAME@:hello`. The rows come from
`bin/omacast-@NAME@`, one JSON object per line; the JSON under
`config/omarchy/omacast/extensions/` is what tells the launcher the keyword
exists and which script answers for it.

`view` in that JSON picks the layout: `list`, `hero`, `cards`, `grid` or
`split`. `minChars` is how much has to be typed before the script runs at all,
and `when` is a test run once on load, so an extension for software you do not
have costs nothing.

```bash
bo test @NAME@
```

That runs the script and reads the answer the way the launcher does, then runs
the cases in `@NAME@.cases.json`: queries, and what the answer to each has to
look like. Three are there already and they pass against the stub, so as you
replace the body, rewrite them into what your extension promises instead.
`units/omacast/EXTENSIONS.md` has the field list.
TXT
}

# What to do next, as the commands themselves. A scaffold that leaves you
# guessing the order has only moved the problem somewhere else.
scaffold_done() {
  local name="$1" dir="$2" edit="$3" try="${4:-}" file
  say "$(green new) units/$name"
  while read -r file; do
    say "  $(dim "${file#"$SELF_ROOT/"}")"
  done < <(find "$dir" -type f | sort)

  printf '\n%s\n' "$(bold Next)"
  say "  \$EDITOR $edit"
  say "  bo add $name"
  # Linking first, because the cases run the script by the name the launcher
  # uses and that name is only on PATH once the unit is on.
  [[ -n $try ]] && say "  bo test $name $(dim '# the answer, and the cases beside it')"
  say "  bo registry $(dim '# before you commit, so bo update sees it')"
  [[ -n $try ]] && printf '\nThen open the launcher and type %s\n' "$(cyan "$try")"
  return 0
}

cmd_new_unit() {
  local name="" kind="hypr" dir edit
  while (($# > 0)); do
    case "$1" in
    --kind)
      shift
      kind="${1:-}"
      ;;
    --kind=*) kind="${1#--kind=}" ;;
    -*) die "unknown option: $1" ;;
    *)
      [[ -z $name ]] || die "one name at a time"
      name="$1"
      ;;
    esac
    shift
  done

  case "$kind" in
  hypr | plugin | setting) ;;
  *) die "kind is hypr, plugin or setting, not '${kind:-<empty>}'" ;;
  esac

  dir=$(scaffold_dir "$name") || exit 1
  mkdir -p "$dir/hypr"
  scaffold_toml "$name" "$kind" >"$dir/unit.toml"
  scaffold_readme "$name" >"$dir/README.md"
  scaffold_lua "$name" >"$dir/hypr/$name.lua"
  edit="units/$name/hypr/$name.lua"

  case "$kind" in
  plugin)
    mkdir -p "$dir/plugin"
    scaffold_manifest "$name" >"$dir/plugin/manifest.json"
    scaffold_widget "$name" >"$dir/plugin/Widget.qml"
    edit="units/$name/plugin/Widget.qml"
    ;;
  setting)
    scaffold_apply "$name" >"$dir/apply.sh"
    scaffold_revert "$name" >"$dir/revert.sh"
    chmod +x "$dir/apply.sh" "$dir/revert.sh"
    edit="units/$name/apply.sh"
    ;;
  esac

  scaffold_done "$name" "$dir" "$edit"
}

cmd_new_extension() {
  local name="" dir
  while (($# > 0)); do
    case "$1" in
    -*) die "unknown option: $1" ;;
    *)
      [[ -z $name ]] || die "one name at a time"
      name="$1"
      ;;
    esac
    shift
  done

  dir=$(scaffold_dir "$name") || exit 1
  mkdir -p "$dir/bin" "$dir/config/omarchy/omacast/extensions"
  scaffold_toml "$name" extension >"$dir/unit.toml"
  scaffold_extension_readme "$name" >"$dir/README.md"
  scaffold_extension_json "$name" >"$dir/config/omarchy/omacast/extensions/$name.json"
  scaffold_extension_cases "$name" >"$dir/config/omarchy/omacast/extensions/$name.cases.json"
  scaffold_extension_script "$name" >"$dir/bin/omacast-$name"
  chmod +x "$dir/bin/omacast-$name"

  scaffold_done "$name" "$dir" "units/$name/bin/omacast-$name" "$name:"
}

new_usage() {
  cat <<'TXT'
  bo new unit <name>       a unit folder, filled in and ready to add
                           (--kind hypr, plugin or setting)
  bo new extension <name>  a unit whose whole job is one launcher keyword
TXT
}

cmd_new() {
  local what="${1:-}"
  shift 2>/dev/null || true
  case "$what" in
  unit) cmd_new_unit "$@" ;;
  extension | ext) cmd_new_extension "$@" ;;
  "" | -h | --help | help) new_usage ;;
  *)
    say "unknown: bo new $what"
    new_usage
    return 1
    ;;
  esac
}

cmd_version() {
  local root
  printf 'bo             %s\n' "$(git -C "$SELF_ROOT" describe --tags --always --dirty 2>/dev/null || echo unknown)"
  printf 'running from   %s\n' "$SELF_ROOT"
  printf 'marketplaces   %s\n' "$(market_names | join_lines)"
  printf 'units          %s available, %s on\n' "$(all_refs | wc -l)" "$(linked_refs | wc -l)"
}

# ---------------------------------------------------------------- interactive
#
# `bo` with no arguments. Everything here is reachable as a command too, and the
# commands stay the interface a script uses: this only saves you remembering
# which one you wanted.
#
# gum does the drawing. It is not a dependency of anything else in bo, so a
# machine without it still has every command, just not this.

tui_available() { command -v gum >/dev/null; }

tui_header() {
  local markets units on
  markets=$(market_names | join_lines)
  units=$(all_refs | wc -l)
  on=$(linked_refs | wc -l)

  gum style --border rounded --padding "0 2" --margin "0" --border-foreground 240 \
    "$(gum style --bold 'better-omarchy')  $(gum style --foreground 240 "$(cd "$SELF_ROOT" && git describe --tags --always 2>/dev/null || echo unknown)")" \
    "$(gum style --foreground 240 "$on of $units units on  ·  $markets")"
}

# One line per unit, marked and aligned, for the picker to show.
tui_unit_line() {
  local ref="$1" mark
  if is_linked "$ref"; then mark="●"; else mark="○"; fi

  printf '%s %-26s %-9s %-13s %s' \
    "$mark" "$(ref_unit "$ref")" "$(meta "$ref" kind)" "$(meta "$ref" category)" "$(meta "$ref" summary)"
}

# The ref a picked line refers to. The line carries the bare unit name, which is
# ambiguous across marketplaces, so the list is rebuilt and matched by position.
tui_ref_for_line() {
  local line="$1" ref
  while read -r ref; do
    [[ "$(tui_unit_line "$ref")" == "$line" ]] && {
      printf '%s' "$ref"
      return 0
    }
  done < <(all_refs)
  return 1
}

tui_units() {
  local lines=() ref picked chosen

  while read -r ref; do
    lines+=("$(tui_unit_line "$ref")")
  done < <(all_refs)

  ((${#lines[@]} > 0)) || {
    say "No units. Add a marketplace first."
    return 0
  }

  picked=$(printf '%s\n' "${lines[@]}" |
    gum filter --no-limit --height 16 --prompt "  " \
      --placeholder "type to filter, tab to mark, enter to act on them" \
      --header "$(printf '  %-26s %-9s %-13s %s   (esc to go back)' UNIT KIND CATEGORY SUMMARY)") || return 0

  [[ -z $picked ]] && return 0

  # Marked units are acted on together, and what to do is asked once. Asking per
  # unit would make turning six things on six questions.
  local refs=() line
  while read -r line; do
    [[ -z $line ]] && continue
    chosen=$(tui_ref_for_line "$line") && refs+=("$chosen")
  done <<<"$picked"

  ((${#refs[@]} > 0)) || return 0

  local action
  action=$(printf 'Turn on\nTurn off\nShow details\nBack\n' |
    gum choose --header "${#refs[@]} selected   (esc to go back)") || return 0

  case "$action" in
  "Turn on")
    for chosen in "${refs[@]}"; do link_unit "$chosen"; done
    tui_pause
    ;;
  "Turn off")
    for chosen in "${refs[@]}"; do unlink_unit "$chosen"; done
    tui_pause
    ;;
  "Show details")
    for chosen in "${refs[@]}"; do
      cmd_info "$chosen"
      say ""
    done
    tui_pause
    ;;
  esac
}

tui_markets() {
  local action name

  cmd_market_list
  say ""

  action=$(printf 'Add a marketplace\nUpdate all\nRemove one\nBack\n' |
    gum choose --header "esc to go back") || return 0

  case "$action" in
  "Add a marketplace")
    local url
    url=$(gum input --placeholder "https://github.com/someone/their-units" \
      --prompt "git url  ") || return 0
    [[ -n $url ]] || return 0
    cmd_market_add "$url"
    tui_pause
    ;;
  "Update all")
    cmd_market_update
    tui_pause
    ;;
  "Remove one")
    name=$(market_names | gum choose --header "Remove which marketplace?") || return 0
    [[ -n $name ]] || return 0
    cmd_market_remove "$name"
    tui_pause
    ;;
  esac
}

tui_checks() {
  local action
  action=$(printf 'Status and key conflicts\nDependencies\nTest every extension\nValidate plugins\nBack\n' |
    gum choose --header "esc to go back") || return 0

  case "$action" in
  "Status and key conflicts") cmd_status ;;
  "Dependencies") cmd_doctor ;;
  "Test every extension") cmd_test ;;
  "Validate plugins") cmd_validate ;;
  *) return 0 ;;
  esac

  tui_pause
}

# Wait for a key, any key. Not `gum input`, which exits non-zero on Escape and
# would take the whole menu down with it: the one thing Escape must never do
# from inside a screen is quit.
tui_pause() {
  say ""
  printf '%s' "$(gum style --foreground 240 '  any key to go back')"
  read -rsn1 </dev/tty
  printf '\r%*s\r' 30 ""
}

cmd_tui() {
  tui_available || {
    usage
    return 0
  }

  # One screen per loop, cleared, so the terminal does not fill with the last
  # five things you looked at.
  while true; do
    clear
    tui_header
    say ""

    local choice
    choice=$(printf 'Units\nMarketplaces\nUpdate everything\nChecks\nVersion\nQuit\n' |
      gum choose --height 8 --header "esc to quit") || return 0

    case "$choice" in
    Units) tui_units ;;
    Marketplaces) tui_markets ;;
    "Update everything")
      cmd_update
      tui_pause
      ;;
    Checks) tui_checks ;;
    Version)
      cmd_version
      tui_pause
      ;;
    Quit | "") return 0 ;;
    esac

  done
}

usage() {
  cat <<'TXT'
bo - Omarchy customizations, from any marketplace

  bo list                 every unit available, and whether it is on
  bo search <term>        find a unit by name, summary, category or tag
  bo info <unit>          everything known about one unit
  bo status               what is on, plus keybinding conflicts

  bo add [unit...]        turn units on (no argument opens a picker)
  bo remove [unit...]     turn units off (no argument opens a picker)

  bo new unit <name>      start a unit here, filled in and ready to add
  bo new extension <name> start a unit whose job is one launcher keyword

  bo update               fetch every marketplace, show what changed, apply
  bo outdated             linked units whose marketplace moved on
  bo relink               apply those changes

  bo market ...           add, remove and inspect marketplaces
  bo doctor               check every linked unit's dependencies exist
  bo test [unit]          run each launcher extension and check what it prints
  bo validate             run omarchy plugin validate on every plugin unit
  bo registry [name]      rebuild a marketplace's registry.json (authors)
  bo sync                 copy the live shell.json into this checkout
  bo version              what this is and where it lives

Run `bo` with no arguments for the interactive version of all of this.

`bo update` also refreshes the `bo` link itself, and `bo list` says once a day
when the marketplace it came from has moved on.

A unit is named `marketplace/unit`, and the marketplace half can be left off
when only one marketplace offers that name.
TXT
}

case "${1:-}" in
list | ls) check_self_stale; shift; cmd_list "$@" ;;
search | find) shift; cmd_search "$@" ;;
info | show) shift; cmd_info "$@" ;;
status) check_self_stale; cmd_status ;;
add | install) shift; cmd_add "$@" ;;
remove | rm | uninstall) shift; cmd_remove "$@" ;;
new | create) shift; cmd_new "$@" ;;
update | upgrade) cmd_update ;;
outdated) cmd_outdated ;;
relink) cmd_relink ;;
market | marketplace) shift; cmd_market "$@" ;;
doctor) cmd_doctor ;;
test) shift; cmd_test "$@" ;;
validate) cmd_validate ;;
registry) shift; cmd_registry "$@" ;;
sync) cmd_sync ;;
version | --version | -V) cmd_version ;;
"") cmd_tui ;;
-h | --help | help) usage ;;
ui | tui) cmd_tui ;;
*) die "unknown command: $1. Try: bo help" ;;
esac

#!/usr/bin/env python3
"""Regenerate registry.json from units/*/unit.toml plus git history.

The registry is what `bo` reads to answer "what changed" without walking the
tree, and what a client can fetch on its own from raw.githubusercontent to see
the catalogue before cloning anything.

Two fields come from git rather than the unit: `commit` and `updated` are the
last commit that touched the unit folder. `hash` is content, not git: it is the
sha256 of every tracked file in the unit, so a rebuild after an unrelated commit
produces the same value and `bo update` can tell a real change from a reshuffle.
"""

import hashlib
import json
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
UNITS = ROOT / "units"
OUT = ROOT / "registry.json"

SCALAR = re.compile(r'^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*"(.*)"\s*$')
ARRAY = re.compile(r"^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*\[(.*)\]\s*$")

# The strict subset of TOML the unit files use, and that bo's sed can also read.
def parse_unit(path):
    out = {}
    for line in path.read_text().splitlines():
        if m := SCALAR.match(line):
            out[m.group(1)] = m.group(2)
        elif m := ARRAY.match(line):
            items = [i.strip().strip('"') for i in m.group(2).split(",")]
            out[m.group(1)] = [i for i in items if i]
    return out


def git(*args):
    return subprocess.run(
        ["git", "-C", str(ROOT), *args], capture_output=True, text=True
    ).stdout.strip()


def tracked_files(unit_dir):
    rel = unit_dir.relative_to(ROOT)
    listed = git("ls-files", "-z", "--", str(rel))
    names = [n for n in listed.split("\0") if n]
    if names:
        return sorted(names)
    # A unit added but not yet staged has no tracked files. Fall back to the
    # working tree so `bo` can still describe it before the first commit.
    return sorted(
        str(p.relative_to(ROOT)) for p in unit_dir.rglob("*") if p.is_file()
    )


def content_hash(files):
    h = hashlib.sha256()
    for name in files:
        h.update(name.encode())
        h.update(b"\0")
        h.update((ROOT / name).read_bytes())
        h.update(b"\0")
    return h.hexdigest()


def main():
    units = {}
    for unit_toml in sorted(UNITS.glob("*/unit.toml")):
        unit_dir = unit_toml.parent
        name = unit_dir.name
        meta = parse_unit(unit_toml)

        missing = [k for k in ("name", "summary", "version", "kind") if k not in meta]
        if missing:
            print(f"{name}: missing {', '.join(missing)}", file=sys.stderr)
            return 1
        if meta["name"] != name:
            print(f"{name}: unit.toml says name = {meta['name']!r}", file=sys.stderr)
            return 1

        files = tracked_files(unit_dir)
        rel = str(unit_dir.relative_to(ROOT))

        units[name] = {
            "name": name,
            "summary": meta["summary"],
            "version": meta["version"],
            "kind": meta["kind"],
            "category": meta.get("category", "Other"),
            "tags": meta.get("tags", []),
            "author": meta.get("author", ""),
            "needs": meta.get("needs", []),
            "keys": meta.get("keys", []),
            "pluginId": meta.get("id", ""),
            "path": rel,
            "files": len(files),
            "hash": content_hash(files),
            "commit": git("log", "-1", "--format=%H", "--", rel),
            "updated": git("log", "-1", "--format=%cI", "--", rel),
            "author_last": git("log", "-1", "--format=%an", "--", rel),
        }

    marketplace = json.loads((ROOT / "marketplace.json").read_text())
    registry = {
        "schema": 1,
        "name": marketplace["name"],
        "title": marketplace.get("title", marketplace["name"]),
        "description": marketplace.get("description", ""),
        "homepage": marketplace.get("homepage", ""),
        "maintainer": marketplace.get("maintainer", ""),
        "generated_at_commit": git("rev-parse", "HEAD"),
        "units": units,
    }

    OUT.write_text(json.dumps(registry, indent=2, sort_keys=False) + "\n")
    print(f"registry.json: {len(units)} units")
    return 0


if __name__ == "__main__":
    sys.exit(main())

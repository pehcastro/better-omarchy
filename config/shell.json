{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "bo.workspace-names",
          "names": {
            "1": {
              "label": "desktop",
              "keepNumber": false
            },
            "2": {
              "label": "coding",
              "keepNumber": true
            },
            "3": {
              "label": "spotify",
              "keepNumber": false
            },
            "4": {
              "label": "browser",
              "keepNumber": false
            },
            "9": {
              "label": "claude workshop",
              "keepNumber": false
            }
          }
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "bo.cpu-meter"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    "bo.workspace-names",
    "bo.cpu-meter",
    {
      "id": "bo.omarchycast"
    },
    {
      "id": "bo.omacast"
    }
  ],
  "version": 1
}

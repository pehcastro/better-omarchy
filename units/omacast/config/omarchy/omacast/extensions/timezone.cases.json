    "fields": [
      "zoneid"
    ],
    "matches": {
      "zoneid": "^Asia/Tokyo$"
    }
  },
  {
    "why": "with the question mark still on it",
    "query": "what time is it in tokyo?",
    "minRows": 1,
    "fields": [
      "zoneid"
    ],
    "matches": {
      "zoneid": "^Asia/Tokyo$"
    }
  },
  {
    "why": "`time:in tokyo` answered 'No timezone matches time'",
    "query": "time in tokyo",
    "minRows": 1,
    "fields": [
      "zoneid"
    ],
    "matches": {
      "zoneid": "^Asia/Tokyo$"
    }
  },
  {
    "why": "and the same query as the alias leaves it",
    "query": "in tokyo",
    "minRows": 1,
    "fields": [
      "zoneid"
    ],
    "matches": {
      "zoneid": "^Asia/Tokyo$"
    }
  },
  {
    "why": "only wrapping and no question is not a question",
    "query": "time",
    "maxRows": 0,
    "fields": []
  },
  {

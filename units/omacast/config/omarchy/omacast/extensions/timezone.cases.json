[
  {
    "why": "a city gives a hero, and the hero carries a clock",
    "query": "tokyo",
    "minRows": 2,
    "row": 0,
    "view": "hero",
    "fields": [
      "clock",
      "title"
    ],
    "matches": {
      "clock": "^[0-9]{2}:[0-9]{2}$"
    }
  },
  {
    "why": "the zones under the hero carry their own clocks, not just names",
    "query": "tokyo",
    "row": 1,
    "fields": [
      "clock",
      "title",
      "zoneid"
    ],
    "matches": {
      "clock": "^[0-9]{2}:[0-9]{2}$"
    }
  },
  {
    "why": "a bare query lists the configured zones in the zones view",
    "query": "",
    "minRows": 4,
    "view": "zones",
    "fields": [
      "clock",
      "title",
      "zoneid",
      "subtitle"
    ]
  },
  {
    "why": "UTC is not in the default set: it is a reference, not a place",
    "query": "",
    "minRows": 4,
    "matches": {
      "zoneid": "^(?!UTC$)"
    }
  },

[
  {
    "why": "a city gives a hero, and the hero carries a clock",
    "query": "tokyo",
    "minRows": 2,
    "row": 0,
    "view": "hero",
    "fields": [
      "clock",
      "title"
    ],
    "matches": {
      "clock": "^[0-9]{2}:[0-9]{2}$"
    }
  },
  {
    "why": "the zones under the hero carry their own clocks, not just names",
    "query": "tokyo",
    "row": 1,
    "fields": [
      "clock",
      "title",
      "zoneid"
    ],
    "matches": {
      "clock": "^[0-9]{2}:[0-9]{2}$"
    }
  },
  {
    "why": "a bare query lists the configured zones in the zones view",
    "query": "",
    "minRows": 4,
    "view": "zones",
    "fields": [
      "clock",
      "title",
      "zoneid",
      "subtitle"
    ]
  },
  {
    "why": "UTC is not in the default set: it is a reference, not a place",
    "query": "",
    "minRows": 4,
    "matches": {
      "zoneid": "^(?!UTC$)"
    }
  },
  {
    "why": "two people is a meeting, and draws the grid rather than a list",
    "query": "john:tokyo maria:spain",
    "minRows": 1,
    "view": "timegrid",
    "fields": [
      "people",
      "title",
      "detail"
    ]
  },
  {
    "why": "me: puts you in the grid",
    "query": "me: john:tokyo",
    "view": "timegrid",
    "fields": [
      "people"
    ]
  },
  {
    "why": "a country resolves to the city people in it mean",
    "query": "spain",
    "row": 0,
    "matches": {
      "detail": "Madrid"
    }
  },
  {
    "why": "accents and spacing do not change what a place is",
    "query": "sao paulo",
    "row": 0,
    "matches": {
      "detail": "Sao_Paulo"
    }
  },
  {
    "why": "a Discord timestamp reads as an instant, not as a search",
    "query": "<t:1735689600:F>",
    "minRows": 3,
    "view": "zones"
  },
  {
    "why": "nonsense answers, and says so, rather than staying silent",
    "query": "zzznotazone",
    "minRows": 1,
    "matches": {
      "title": "No timezone matches"
    }
  },
  {
    "why": "a half-typed Discord paste is not yet a question",
    "query": "<t:17356",
    "maxRows": 0
  },
  {
    "why": "one name is a person, not a place: maria:saopaulo answered 'no timezone matches'",
    "query": "maria:saopaulo",
    "minRows": 1,
    "view": "timegrid",
    "fields": [
      "people"
    ]
  },
  {
    "why": "one person somewhere else is compared against you, so you are a row",
    "query": "maria:tokyo",
    "view": "timegrid",
    "matches": {
      "people": "'name': 'you'"
    }
  },
  {
    "why": "four people still draw one grid, which is what the recording needs",
    "query": "john:tokyo maria:spain ana:saopaulo ronaldo:washington",
    "minRows": 1,
    "view": "timegrid",
    "fields": [
      "people",
      "startsAt"
    ]
  },
  {
    "why": "typing the next name must not break the grid: 'john:tokyo m' flashed an error mid-sentence",
    "query": "john:tokyo m",
    "view": "timegrid",
    "fields": [
      "people"
    ]
  },
  {
    "why": "a place with a space survives a half-typed word after it",
    "query": "john:new york m",
    "view": "timegrid",
    "matches": {
      "people": "New York"
    }
  },
  {
    "why": "a place that is genuinely wrong still says so",
    "query": "maria:zzznope",
    "minRows": 1,
    "matches": {
      "title": "No timezone matches"
    }
  },
  {
    "why": "Etc/GMT+2 is two hours behind UTC: `tz:gmt+2` answered with UTC-2 under a row headed GMT+2",
    "query": "gmt+2",
    "minRows": 1,
    "view": "hero",
    "fields": [
      "title",
      "detail",
      "zoneid"
    ],
    "matches": {
      "title": "^[0-9]{2}:[0-9]{2}$",
      "detail": "^UTC\\+2"
    }
  },
  {
    "why": "an offset written with utc reads the same way",
    "query": "utc+5",
    "minRows": 1,
    "fields": [
      "detail"
    ],
    "matches": {
      "detail": "^UTC\\+5"
    }
  },
  {
    "why": "and a negative one",
    "query": "gmt-3",
    "minRows": 1,
    "fields": [
      "detail"
    ],
    "matches": {
      "detail": "^UTC-3"
    }
  },
  {
    "why": "zero is UTC rather than a zone named Etc/GMT-0 that does not exist",
    "query": "utc+0",
    "minRows": 1,
    "fields": [
      "zoneid"
    ],
    "matches": {
      "zoneid": "^UTC$"
    }
  },
  {
    "why": "a half-hour offset has no Etc zone, so it says so rather than rounding to the wrong hour",
    "query": "+05:30",
    "minRows": 1,
    "fields": [
      "title",
      "detail"
    ],
    "matches": {
      "title": "^No zone is exactly",
      "detail": "whole hours"
    }
  },
  {
    "why": "two letters inside a city name is not a match: `tz:of` answered with Sofia",
    "query": "of",
    "minRows": 1,
    "fields": [
      "title"
    ],
    "matches": {
      "title": "^No timezone matches"
    }
  },
  {
    "why": "two places is a comparison, and the grid is what a comparison looks like",
    "query": "tokyo vs london",
    "minRows": 1,
    "view": "timegrid",
    "fields": [
      "people",
      "title"
    ],
    "matches": {
      "people": "Tokyo"
    }
  },
  {
    "why": "'and' joins them the same way",
    "query": "tokyo and london",
    "minRows": 1,
    "view": "timegrid",
    "fields": [
      "people"
    ],
    "matches": {
      "people": "London"
    }
  },
  {
    "why": "so does nothing at all between them",
    "query": "tokyo london",
    "minRows": 1,
    "view": "timegrid",
    "fields": [
      "people"
    ],
    "matches": {
      "people": "London"
    }
  },
  {
    "why": "`tz:tokyo to london` showed London's clock and never mentioned Tokyo",
    "query": "tokyo to london",
    "minRows": 1,
    "view": "timegrid",
    "fields": [
      "people"
    ],
    "matches": {
      "people": "Tokyo"
    }
  },
  {
    "why": "three places, one of them two words, still one grid",
    "query": "london new york tokyo",
    "minRows": 1,
    "view": "timegrid",
    "fields": [
      "people"
    ],
    "matches": {
      "people": "New York"
    }
  },
  {
    "why": "'me' puts you into a comparison of places, as it does into one of people",
    "query": "me tokyo",
    "minRows": 1,
    "view": "timegrid",
    "fields": [
      "people"
    ],
    "matches": {
      "people": "Tokyo"
    }
  },
  {

  { "why": "cool used to find 🆒 the button",
    "query": "cool",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^😎$" } },

  { "why": "an idea is a bulb whatever the data calls it",
    "query": "idea",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^💡$" } },

  { "why": "a feeling with no emoji named for it",
    "query": "annoyed",
    "minRows": 1,
    "row": 0,
    "fields": ["glyph"] },

  { "why": "shipping something is a rocket",
    "query": "deploy",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^🚀$" } },

  { "why": "the plain name still ranks over the compound one",
    "query": "fire",
    "minRows": 2,
    "row": 0,

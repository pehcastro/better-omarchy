    "maxRows": 0 },

  { "why": "the grid is capped at what fits on a screen",
    "query": "face",
    "minRows": 20,
    "maxRows": 60 },

  { "why": "every row carries the character to copy and a way to copy it",
    "query": "rocket",
    "minRows": 1,

  { "why": "and the plain star over the dizzy one",
    "query": "star",
    "minRows": 2,
    "row": 0,
    "matches": { "glyph": "^⭐$" } },

  { "why": "the empty query is a starting set rather than all 1800 of them",
    "query": "",
    "minRows": 20,
    "row": 0,
    "fields": ["glyph", "title"] },

  { "why": "a keyboard mash matches nothing and says nothing",
    "query": "qwertyuiop",
    "maxRows": 0 },

  { "why": "and so does a longer one",
    "query": "zzzzzzzz",
    "maxRows": 0 },

  { "why": "punctuation on its own is not a search",

[
  { "why": "the name people type, which is not the name in the data",
    "query": "thumbs up",
    "minRows": 1,
    "row": 0,
    "fields": ["glyph", "title"],
    "matches": { "glyph": "^👍$" } },

  { "why": "the same name run together",
    "query": "thumbsup",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^👍$" } },

  { "why": "the way it is written in a code review",
    "query": "+1",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^👍$" } },

  { "why": "and the other way",
    "query": "-1",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^👎$" } },

  { "why": "case is not a search term",
    "query": "THUMBS UP",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^👍$" } },

  { "why": "nor is a stray capital in the middle",
    "query": "ThUmBs uP",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^👍$" } },

  { "why": "two words that are never next to each other in the data: this used to answer nothing",
    "query": "crying laughing",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^😂$" } },

  { "why": "the same, with the word for the category on the end",
    "query": "crying laughing face",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^😂$" } },

  { "why": "an underscore in the data is a space to a reader: raised_hands used to be one word",
    "query": "raised hands",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^🙌$" } },

  { "why": "the words in the order nobody indexed them in",
    "query": "arrow right",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^➡" } },

  { "why": "and in the order they are indexed in",
    "query": "right arrow",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^➡" } },

  { "why": "a hand pointing, in two words",
    "query": "point right",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^👉$" } },

  { "why": "a feeling, not a name: love used to find 🏩 the love hotel",
    "query": "love",
    "minRows": 2,
    "row": 0,
    "matches": { "glyph": "^❤" } },

  { "why": "the heart people mean by heart",
    "query": "heart",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^❤" } },

  { "why": "party used to find 🎂 the birthday cake",
    "query": "party",
    "minRows": 2,
    "row": 0,
    "matches": { "glyph": "^🎉$" } },

  { "why": "congrats used to answer nothing at all",
    "query": "congrats",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^🎉$" } },

  { "why": "no used to find 🚭 no smoking",
    "query": "no",
    "minRows": 2,
    "row": 0,
    "matches": { "glyph": "^❌$" } },

  { "why": "yes is a tick",
    "query": "yes",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^✅$" } },

  { "why": "the British word for a tick, which used to find 🎫 the ticket",
    "query": "tick",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^✅$" } },

  { "why": "one letter, and it is the cross rather than the x-ray",
    "query": "x",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^❌$" } },

  { "why": "thanks used to find 🙇 the bow",
    "query": "thanks",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^🙏$" } },

  { "why": "the Portuguese spelling of the country, which used to answer nothing",
    "query": "brasil",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^🇧🇷$" } },

  { "why": "the English spelling still answers the same flag",
    "query": "brazil",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^🇧🇷$" } },

  { "why": "usa used to answer nothing: the data calls it flag us united america",
    "query": "usa",
    "minRows": 1,
    "row": 0,

  { "why": "a hand gesture nobody knows the official name of",
    "query": "fingers crossed",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^🤞$" } },

  { "why": "and the same one the other way round",
    "query": "crossed fingers",
    "minRows": 1,
    "row": 0,
    "matches": { "glyph": "^🤞$" } }

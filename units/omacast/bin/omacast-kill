#!/bin/bash
# Emits JSON rows for OmaCast's `kill:` keyword: find something that is
# running, see what it is costing, and end it.
#
#   kill:           everything of yours that is running, dearest first
#   kill:chrome     any process whose name, command line or window matches,
#                   yours or anybody's
#
# A bare `kill:` used to answer with nothing at all, on the argument that a
# list with SIGTERM one keypress away is a way to lose a session by leaning on
# the return key. That argument was about the wrong list. `ps aux` is four
# hundred rows of kernel threads and session plumbing, and a launcher offering
# to kill any of them is indeed dangerous. But the reason a person types
# `kill:` is that something is spinning the fan and they do not know its name:
# refusing to answer until they type that name is refusing the question.
#
# So the bare list is a different list, not a shorter one:
#
#   * only your own uid, because a row that needs sudo to work is a row that
#     silently does nothing. A typed query drops this: if you went looking for
#     `dockerd` you meant root's.
#   * never the process tree this script is standing on. Every ancestor of
#     this pid is excluded by walking ppid up, which removes bash, quickshell,
#     Hyprland and `systemd --user` in one rule rather than by name, and that
#     rule is exactly "everything whose death takes the launcher with it".
#   * no kernel threads and no zombies. Neither can be signalled.
#   * one row per program, not per process. Chrome is forty processes running
#     the same binary, so a process folds into its parent when the parent is
#     that same binary, and the row carries the whole family's CPU and memory
#     with a count to say so. Without this the top ten is ten renderers.
#
# Ordering is cost, not pid and not memory alone:
#
#   cost = cpu% + megabytes / 64
#
# so a gigabyte weighs about as much as 16% of a core. Memory decides the order
# while nothing is busy, and anything actually spinning goes straight to the
# top, which is the case this was opened for.
#
# The CPU figure is a real one. `ps -o pcpu` is the average over a process's
# whole life, so a thing that has been pinned for a minute after a week idle
# reads as 0.1% and the one number the user came for is a lie. Instead the CPU
# ticks of every candidate are snapshotted to $XDG_RUNTIME_DIR each run and
# differenced against the previous run, which the launcher supplies for free by
# re-running this on a timer while the rows are on screen. A first run after a
# long gap has no usable window and falls back to the lifetime average, and
# says so in `cpuLive` so the view can stay quiet about a number it does not
# yet trust.
#
# Memory is summed RSS across the family. Shared pages are therefore counted
# more than once and a browser reads high; PSS would be honest but costs a
# smaps_rollup read per process and needs privileges for anything not yours.
#
# Cost: three execs past this script's own shell, whatever the answer is.
# `ps` once, `hyprctl` once, and one awk that does the parsing, the folding,
# the /proc reads and the JSON. Measured at 19-23ms wall for a bare list on a
# 426-process machine. The previous version forked `jq` once per row.

set -uo pipefail

# awk -v mangles backslashes in a value, so the query travels in the
# environment instead. It is matched with index(), never as a regex, so
# `kill:[` is a search for a bracket and not a broken character class.
export OKQ="${1:-}"
export OKSELF=$$
export OKUID="${UID:-$(id -u)}"
export OKSNAP="${XDG_RUNTIME_DIR:-/tmp}/omacast-kill.cpu"

# pid ppid uid pcpu rss etimes stat, then the command line as the remainder.
# Every field before args is free of whitespace, which is what makes that split
# safe. `comm` is deliberately absent: it can contain a space ("UVM deferred
# release queue", "systemctl <defunct>"), so a middle column holding it cannot
# be parsed at all. The name comes from /proc/PID/stat instead, where it is
# bracketed and unambiguous.
ps -eo pid=,ppid=,uid=,pcpu=,rss=,etimes=,stat=,args= 2>/dev/null | awk '
function jstr(s) {
  gsub(/\\/, "\\\\", s)
  gsub(/"/, "\\\"", s)
  gsub(/\t/, " ", s)
  gsub(/[\001-\037\177]/, "", s)
  return "\"" s "\""
}

function base(path) { sub(/.*\//, "", path); return path }

# Undo the only two escapes hyprctl puts in a string; it passes UTF-8 through
# untouched. Doing it here keeps one escaping regime in this program instead of
# a JSON one for the compositor and another for everything else.
function unesc(s) {
  gsub(/\\"/, "\"", s)
  gsub(/\\\\/, "\\", s)
  return s
}

# Read a file fully into a[1..n] and close it. Leaving /proc handles open runs
# into the fd limit a few hundred processes in, and the rest of the table then
# silently reads as empty.
function slurp(path, out,   count, buf) {
  count = 0
  while ((getline buf < path) > 0) out[++count] = buf
  close(path)
  return count
}

# Every ancestor of this script, and this script. Walking ppid is what makes
# the exclusion structural: nothing here is named, so a rename upstream cannot
# quietly put Hyprland back in the list.
function markSelf(   p, hops) {
  p = SELF
  for (hops = 0; hops < 64 && p > 1; hops++) { forbidden[p] = 1; p = pp[p] }
  forbidden[1] = 1
}

# A process folds into its parent only when the parent runs the same executable
# and is itself a candidate. Contiguous and nothing more: a chrome renderer
# under a chrome zygote under chrome main collapses to one row, while a node
# script under a shell under a terminal stays three, which is right, because
# those are three different things to kill.
function leaderOf(p, depth,   par) {
  if (p in lead) return lead[p]
  if (depth > 48) return p
  lead[p] = p
  par = pp[p]
  if ((par in cand) && par != p && exek[par] == exek[p]) lead[p] = leaderOf(par, depth + 1)
  return lead[p]
}

# uid to name, from /etc/passwd, read once. getpwuid would be a fork per row.
function unameOf(u,   count, idx, fld) {
  if (!pwloaded) {
    pwloaded = 1
    count = slurp("/etc/passwd", pw)
    for (idx = 1; idx <= count; idx++) {
      split(pw[idx], fld, ":")
      if (fld[3] != "") unames[fld[3] + 0] = fld[1]
    }
  }
  return (u in unames) ? unames[u] : ("uid " u)
}

BEGIN {
  Q = tolower(ENVIRON["OKQ"])
  SELF = ENVIRON["OKSELF"] + 0
  MYUID = ENVIRON["OKUID"] + 0
  SNAP = ENVIRON["OKSNAP"]
  HOME = ENVIRON["HOME"]
  BARE = (Q == "")
  # A single quote cannot be written inside this program, because the program
  # is itself single-quoted for the shell. Building it from its code point is
  # cheaper than the alternative, which is six backslashes per occurrence.
  SQ = sprintf("%c", 39)
  # /proc reports CPU time in USER_HZ, which is 100 on Linux whatever the
  # kernel tick rate is, so this is a constant and not worth a getconf fork.
  HZ = 100
  # More than any sane maxRows, so raising that in omacast.json actually gets
  # more rows rather than silently stopping here.
  MAXROWS = 20

  n = slurp("/proc/uptime", up)
  if (n > 0) { split(up[1], f, " "); NOW = f[1] + 0 }

  n = slurp("/proc/meminfo", mi)
  for (i = 1; i <= n; i++) {
    if (mi[i] ~ /^MemTotal:/)     { split(mi[i], f, " "); MEMTOTAL = f[2] + 0 }
    if (mi[i] ~ /^MemAvailable:/) { split(mi[i], f, " "); MEMAVAIL = f[2] + 0 }
  }

  n = slurp("/proc/stat", cs)
  for (i = 1; i <= n; i++) {
    if (cs[i] ~ /^cpu /) {
      split(cs[i], f, " ")
      for (j = 2; j <= 11; j++) CPUALL += f[j] + 0
      CPUIDLE = f[5] + f[6]
      break
    }
  }

  # The previous run. Keyed by pid and guarded by the process start time, so a
  # recycled pid cannot inherit a stranger CPU reading.
  while ((getline line < SNAP) > 0) {
    if (split(line, f, " ") < 3) continue
    if (f[1] == "#") { PNOW = f[2] + 0; PCPUALL = f[3] + 0; PCPUIDLE = f[4] + 0; continue }
    prevStart[f[1]] = f[2]; prevTicks[f[1]] = f[3] + 0
  }
  close(SNAP)

  DT = NOW - PNOW
  # Under 50ms the tick counter has not moved enough to divide by; over two
  # minutes the answer is to a different question. Either way, fall back.
  USEDELTA = (PNOW > 0 && DT > 0.05 && DT < 120)

  SYSCPU = -1
  if (USEDELTA && CPUALL > PCPUALL) {
    SYSCPU = 100 * (1 - (CPUIDLE - PCPUIDLE) / (CPUALL - PCPUALL))
    if (SYSCPU < 0) SYSCPU = 0
  }

  # Windows, straight from the compositor. hyprctl prints one key per line and
  # JSON cannot hold a raw newline inside a string, so a key match anchored to
  # the start of a line is safe even against a window titled `"pid": 1`.
  cmd = "hyprctl clients -j 2>/dev/null"
  while ((cmd | getline line) > 0) {
    if (line ~ /^[ \t]*"address":/) {
      v = line; sub(/^[ \t]*"address": "/, "", v); sub(/",?[ \t]*$/, "", v)
      curaddr = v; curclass = ""; curtitle = ""; curws = ""; curmapped = 0
      continue
    }
    if (line ~ /^[ \t]*"workspace": \{/) { inws = 1; continue }
    if (inws && line ~ /^[ \t]*"name":/) {
      v = line; sub(/^[ \t]*"name": "?/, "", v); sub(/"?,?[ \t]*$/, "", v)
      curws = unesc(v); inws = 0; continue
    }
    if (line ~ /^[ \t]*"mapped":/) { curmapped = (line ~ /true/); continue }
    if (line ~ /^[ \t]*"class":/) {
      v = line; sub(/^[ \t]*"class": "/, "", v); sub(/",?[ \t]*$/, "", v)
      curclass = unesc(v); continue
    }
    if (line ~ /^[ \t]*"title":/) {
      v = line; sub(/^[ \t]*"title": "/, "", v); sub(/",?[ \t]*$/, "", v)
      curtitle = unesc(v); continue
    }
    if (line ~ /^[ \t]*"pid":/) {
      v = line; sub(/^[ \t]*"pid": /, "", v); sub(/,?[ \t]*$/, "", v)
      # pid arrives after class and title, so the record is complete here and
      # nothing has to wait for the closing brace.
      if (v + 0 > 0 && curmapped) {
        # First window wins. One pid can own several, and the oldest is the one
        # the user thinks of as the app; taking the newest would also make the
        # title jump about under a refresh.
        if (!((v + 0) in waddr)) {
          waddr[v + 0] = curaddr; wclass[v + 0] = curclass
          wtitle[v + 0] = curtitle; wws[v + 0] = curws
        }
        wcount[v + 0]++
      }
      continue
    }
  }
  close(cmd)
}

{
  pid = $1 + 0
  if (pid <= 0) next
  args = ""
  for (i = 8; i <= NF; i++) args = args (i > 8 ? " " : "") $i

  pp[pid] = $2 + 0
  uid[pid] = $3 + 0
  lifecpu[pid] = $4 + 0
  rss[pid] = $5 + 0
  age[pid] = $6 + 0
  st[pid] = $7
  cmdline[pid] = args
  order[++total] = pid
}

END {
  markSelf()

  for (i = 1; i <= total; i++) {
    p = order[i]
    a = cmdline[p]

    # A kernel thread has a bracketed command line and cannot be signalled; a
    # zombie is already dead and only its parent can reap it. Either would be a
    # row that does nothing when pressed.
    if (a == "" || a ~ /^\[/) continue
    if (st[p] ~ /^Z/) continue
    if (p in forbidden) continue

    # The ancestor walk covers these when this runs under the launcher and
    # misses them entirely when it runs from a terminal, which is exactly when
    # a row offering to kill the shell would be most tempting to press.
    if (a ~ /quickshell/ || a ~ /omarchy.*shell/ || a ~ /omacast/) continue

    if (BARE && uid[p] != MYUID) continue

    cand[p] = 1
    e = a; sub(/ .*/, "", e)
    exek[p] = e
  }

  # Name, CPU ticks and start time: one small read each, candidates only, so a
  # bare query here opens about a hundred files rather than four hundred.
  for (p in cand) {
    sf = "/proc/" p "/stat"
    if ((getline line < sf) <= 0) { close(sf); delete cand[p]; continue }
    close(sf)

    # comm is parenthesised and may itself contain spaces and parentheses, so
    # the split point is the last close paren, not the first.
    o = index(line, "(")
    for (k = length(line); k > 0; k--) if (substr(line, k, 1) == ")") break
    if (o > 0 && k > o) name[p] = substr(line, o + 1, k - o - 1)
    else name[p] = base(exek[p])

    m = split(substr(line, k + 2), g, " ")
    ticks[p] = (m >= 13) ? g[12] + g[13] : 0
    start[p] = (m >= 20) ? g[20] : "0"

    # The kernel keeps fifteen characters of a name, so anything that long is
    # probably cut off. The binary finishes the word when the two agree.
    if (length(name[p]) >= 15) {
      b = base(exek[p])
      if (index(b, name[p]) == 1) name[p] = b
    }

    if (USEDELTA && (p in prevTicks) && prevStart[p] == start[p] && ticks[p] >= prevTicks[p]) {
      cpu[p] = 100 * ((ticks[p] - prevTicks[p]) / HZ) / DT
    } else {
      cpu[p] = lifecpu[p]
    }
    if (cpu[p] < 0) cpu[p] = 0
  }

  for (p in cand) leaderOf(p, 0)

  for (p in cand) {
    L = lead[p]
    if (!(L in seen)) { seen[L] = 1; leaders[++nl] = L }
    scpu[L] += cpu[p]
    srss[L] += rss[p]
    members[L]++

    # A window belongs to the family, not only to the pid that registered it.
    # A row that knows about a window is the row that can offer to go and look
    # at the thing instead of ending it.
    if (!(L in hasWin) && (p in waddr)) {
      hasWin[L] = 1; laddr[L] = waddr[p]; lclass[L] = wclass[p]
      ltitle[L] = wtitle[p]; lws[L] = wws[p]
    }
    if (p in wcount) lwins[L] += wcount[p]

    if (BARE) { hit[L] = 1; continue }
    hay = tolower(name[p] " " cmdline[p] " " wclass[p] " " wtitle[p])
    if (index(hay, Q) > 0) hit[L] = 1
  }

  nrows = 0
  for (i = 1; i <= nl; i++) {
    L = leaders[i]
    if (!(L in hit)) continue
    cost[L] = scpu[L] + (srss[L] / 1024) / 64
    rank[++nrows] = L
  }

  # Insertion sort: a couple of hundred leaders at worst, and it keeps this to
  # one awk with no gawk-only asort.
  for (i = 2; i <= nrows; i++) {
    v = rank[i]; j = i - 1
    while (j >= 1 && cost[rank[j]] < cost[v]) { rank[j + 1] = rank[j]; j-- }
    rank[j + 1] = v
  }

  shown = (nrows < MAXROWS) ? nrows : MAXROWS
  for (i = 1; i <= shown; i++) {
    L = rank[i]
    win = (L in hasWin)

    line = cmdline[L]
    if (HOME != "" && index(line, HOME "/") == 1) line = "~/" substr(line, length(HOME) + 2)
    if (length(line) > 96) line = substr(line, 1, 95) "…"

    # A window title says what the thing is; a command line says what it was
    # started as. For something the user opened, the first is the answer.
    second = win && ltitle[L] != "" ? ltitle[L] : line

    kt = "kill -TERM " L
    kk = "kill -KILL " L
    kc = "printf %s " L " | wl-copy"

    acts = ""
    if (win) {
      # Under a Lua config `dispatch focuswindow` returns ok and does nothing,
      # so focus goes through the dispatcher the same way `win:` does. Focus is
      # first because "I could not find it" is half of why anyone types this,
      # and because a panel whose default row is harmless is a kinder panel.
      fx = "hyprctl dispatch " SQ "hl.dsp.focus({ window = \"address:" laddr[L] "\" })" SQ
      acts = acts "{\"title\":\"Focus Window\",\"exec\":" jstr(fx) "},"
    }
    acts = acts "{\"title\":\"Terminate\",\"shortcut\":\"↵\",\"exec\":" jstr(kt) "},"
    acts = acts "{\"title\":\"Force Kill\",\"exec\":" jstr(kk) "},"
    acts = acts "{\"title\":\"Copy PID\",\"exec\":" jstr(kc) "}"

    printf "{"
    printf "\"id\":\"%d\",", L
    printf "\"title\":%s,", jstr(name[L])
    printf "\"subtitle\":%s,", jstr(second)
    printf "\"view\":\"processes\","
    printf "\"exec\":%s,", jstr(kt)
    printf "\"score\":%d,", 90000 - (i - 1) * 100
    printf "\"pid\":%d,", L
    printf "\"user\":%s,", jstr(unameOf(uid[L]))
    printf "\"own\":%s,", (uid[L] == MYUID ? "true" : "false")
    printf "\"cpu\":%.1f,", scpu[L]
    printf "\"cpuLive\":%s,", (USEDELTA ? "true" : "false")
    printf "\"mem\":%d,", srss[L] * 1024
    printf "\"memShare\":%.5f,", (MEMTOTAL > 0 ? srss[L] / MEMTOTAL : 0)
    printf "\"age\":%d,", age[L]
    printf "\"count\":%d,", members[L]
    printf "\"stopped\":%s,", (st[L] ~ /^[Tt]/ ? "true" : "false")
    printf "\"windowed\":%s,", (win ? "true" : "false")
    printf "\"cmd\":%s,", jstr(line)
    if (win) {
      printf "\"winTitle\":%s,", jstr(ltitle[L])
      printf "\"winClass\":%s,", jstr(lclass[L])
      printf "\"workspace\":%s,", jstr(lws[L])
      printf "\"windows\":%d,", lwins[L]
    }
    # The machine rides on the first row, the way `git:` carries its repo.
    # Per-row numbers mean little without it: 1.4G is either most of the box or
    # a rounding error, and only the total says which.
    if (i == 1) {
      printf "\"machine\":{\"cpu\":%.1f,\"memUsed\":%d,\"memTotal\":%d,\"procs\":%d,\"matched\":%d,\"bare\":%s},",
        SYSCPU, (MEMTOTAL - MEMAVAIL) * 1024, MEMTOTAL * 1024, total, nrows,
        (BARE ? "true" : "false")
    }
    printf "\"actions\":[%s]", acts
    printf "}\n"
  }

  # The snapshot for whoever runs next, written for every candidate rather than
  # only the rows shown, so typing a query does not blind the next bare list.
  #
  # Not rewritten while it is still fresh. Someone typing quickly runs this
  # every 120ms, and differencing over 120ms means twelve ticks of resolution:
  # a process is either 0% or 8% and the column flickers between them on every
  # keystroke. Letting the base age to at least seven tenths of a second gives
  # the numbers something to be steady about.
  if (PNOW == 0 || NOW - PNOW >= 0.7) {
    printf "# %.2f %d %d\n", NOW, CPUALL, CPUIDLE > SNAP
    for (p in cand) printf "%d %s %d\n", p, start[p], ticks[p] > SNAP
    close(SNAP)
  }
}
' 2>/dev/null

exit 0

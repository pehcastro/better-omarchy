#!/bin/bash
# Emits one JSON row per line for Omacast's `sp:` keyword, from the Spotify
# Web API, and runs the playback its own rows ask for.
#
#   sp:kind of blue                tracks first, then albums, then artists
#   sp:kind of blue type:album     albums only
#   sp:miles davis type:artist     artists only
#
# The launcher invokes it as `omacast-spotify search {query} {type}`. Rows
# invoke it back as `omacast-spotify play <uri>` and `... queue <uri>`.
#
# Credentials live in ~/.local/state/omarchy/omacast-spotify.json, written
# once by omacast-spotify-auth. They are deliberately not in
# ~/.config/omarchy/omacast.json: that file is meant to be committed and
# shared between machines, and this one is a live Spotify session for whoever
# can read it.

set -uo pipefail

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/omacast-spotify.json"
API="https://api.spotify.com/v1"
TOKEN_URL="https://accounts.spotify.com/api/token"

command -v curl >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0
[[ -r $STATE_FILE ]] || exit 0

client_id=""
access_token=""
refresh_token=""
expires_at=0
scope=""
devfile=""

enc() { jq -rn --arg v "${1:-}" '$v|@uri'; }

notify() {
  command -v notify-send >/dev/null 2>&1 && notify-send "Spotify" "$1"
  return 0
}

load_state() {
  local raw
  raw=$(jq -r '[.client_id // "", .access_token // "", .refresh_token // "",
                ((.expires_at // 0) | tostring), .scope // ""] | @tsv' \
        "$STATE_FILE" 2>/dev/null) || return 1
  [[ -n $raw ]] || return 1

  IFS=$'\t' read -r client_id access_token refresh_token expires_at scope <<<"$raw"
  [[ $expires_at =~ ^[0-9]+$ ]] || expires_at=0
  [[ -n $client_id && -n $refresh_token ]]
}

save_state() {
  local dir tmp
  dir=$(dirname "$STATE_FILE")
  mkdir -p "$dir" 2>/dev/null || return 1

  tmp=$(mktemp "$STATE_FILE.XXXXXX") || return 1
  # Stated rather than inherited: mktemp honours a umask this script does not
  # control, and a token file that is group readable is a token file that leaks.
  chmod 600 "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }

  jq -n --arg cid "$client_id" --arg at "$access_token" --arg rt "$refresh_token" \
        --arg sc "$scope" --argjson exp "$expires_at" \
        '{client_id: $cid, access_token: $at, refresh_token: $rt,
          expires_at: $exp, scope: $sc}' >"$tmp" 2>/dev/null ||
    { rm -f "$tmp"; return 1; }

  mv -f "$tmp" "$STATE_FILE" 2>/dev/null || { rm -f "$tmp"; return 1; }
}

# Every call to Spotify goes through here, and every call hands curl its options
# on stdin rather than on a command line. A bearer token in argv is readable by
# `ps` from any account on the box for as long as the request runs, and a config
# file on disk only moves the same secret somewhere it persists.
api() {
  local method=$1 url=$2 body=${3:-} escaped
  {
    printf 'silent\n'
    printf 'request = "%s"\n' "$method"
    printf 'url = "%s"\n' "$url"
    printf 'header = "Authorization: Bearer %s"\n' "$access_token"
    if [[ -n $body ]]; then
      escaped=${body//\\/\\\\}
      escaped=${escaped//\"/\\\"}
      printf 'header = "Content-Type: application/json"\n'
      printf 'data = "%s"\n' "$escaped"
    fi
  } | curl -K - --max-time 10 -w '\n%{http_code}' 2>/dev/null
}

# The refresh token is a longer lived secret than the access token, so it takes
# the same stdin route.
refresh_tokens() {
  local out status body new_access new_refresh new_scope expires_in
  out=$( {
      printf 'silent\n'
      printf 'request = "POST"\n'
      printf 'url = "%s"\n' "$TOKEN_URL"
      printf 'header = "Content-Type: application/x-www-form-urlencoded"\n'
      printf 'data = "grant_type=refresh_token&refresh_token=%s&client_id=%s"\n' \
        "$(enc "$refresh_token")" "$(enc "$client_id")"
    } | curl -K - --max-time 10 -w '\n%{http_code}' 2>/dev/null )

  status=${out##*$'\n'}
  body=${out%$'\n'*}
  [[ $status == 200 ]] || return 1

  new_access=$(printf '%s' "$body" | jq -r '.access_token // ""' 2>/dev/null)
  [[ -n $new_access ]] || return 1

  new_refresh=$(printf '%s' "$body" | jq -r '.refresh_token // ""' 2>/dev/null)
  new_scope=$(printf '%s' "$body" | jq -r '.scope // ""' 2>/dev/null)
  expires_in=$(printf '%s' "$body" | jq -r '.expires_in // 3600' 2>/dev/null)
  [[ $expires_in =~ ^[0-9]+$ ]] || expires_in=3600

  access_token=$new_access
  # PKCE usually returns a rotated refresh token but is not required to. Keeping
  # the old one when the field is absent is the difference between a session
  # that survives and one that silently ends at the next refresh.
  [[ -n $new_refresh ]] && refresh_token=$new_refresh
  [[ -n $new_scope ]] && scope=$new_scope
  expires_at=$(( $(date +%s) + expires_in ))

  save_state
}

fresh_enough() {
  [[ -n $access_token ]] && (( $(date +%s) + 60 < expires_at ))
}

ensure_token() {
  fresh_enough && return 0

  # Typing `sp:blue` fires several searches, and Spotify retires a refresh token
  # the moment it is spent, so two unserialised refreshes race and the loser
  # writes a token that is already dead. flock comes with util-linux and is
  # always present, but its absence must not take search down with it.
  if command -v flock >/dev/null 2>&1 && exec 9>"$STATE_FILE.lock" 2>/dev/null; then
    flock -w 8 9 2>/dev/null
    load_state || return 1
    fresh_enough && return 0
  fi

  refresh_tokens
}

# The id of the device to aim playback at: the active one, or any known one.
# Spotify answers a bare play call with 404 when nothing is active, but naming
# an idle device in the request wakes it, which is what a person means when they
# hit enter on a track with Spotify sitting open and paused.
target_device() {
  local out status body
  out=$(api GET "$API/me/player/devices")
  status=${out##*$'\n'}
  body=${out%$'\n'*}
  [[ $status == 200 ]] || return 1

  printf '%s' "$body" | jq -r '
    (.devices // []) as $d
    | (($d | map(select(.is_active)) | .[0].id) // ($d | .[0].id) // "")' 2>/dev/null
}

report() {
  local status=$1 body=$2 message
  case $status in
    200|202|204) return 0 ;;
    404) notify "No Spotify device is active. Open Spotify anywhere, then try again." ;;
    403) notify "Spotify refused the request. Controlling playback needs Premium." ;;
    401) notify "Spotify login expired. Run omacast-spotify-auth again." ;;
    429) notify "Spotify is rate limiting. Try again in a moment." ;;
    *)
      message=$(printf '%s' "$body" | jq -r '.error.message // ""' 2>/dev/null)
      notify "${message:-Spotify request failed ($status)}"
      ;;
  esac
  return 0
}

do_search() {
  local query=${1:-} kind=${2:-} types url out status body note="" devout devstatus devbody count devpid

  [[ -n ${query//[[:space:]]/} ]] || exit 0

  # No type: filter searches all three and leads with tracks, because that is
  # what a bare `sp:` is asking for nine times out of ten.
  case ${kind,,} in
    album|albums)   types="album" ;;
    artist|artists) types="artist" ;;
    track|tracks|song|songs) types="track" ;;
    *)              types="track,album,artist" ;;
  esac

  devfile=$(mktemp "${TMPDIR:-/tmp}/omacast-spotify.XXXXXX") || exit 0
  trap 'rm -f "$devfile"' EXIT

  # Device state and search are two independent round trips, so they overlap
  # rather than adding up. Both have to be in hand before a row can be printed.
  api GET "$API/me/player/devices" >"$devfile" 2>/dev/null &
  devpid=$!

  url="$API/search?q=$(enc "$query")&type=$types&limit=8"
  out=$(api GET "$url")
  wait "$devpid" 2>/dev/null

  status=${out##*$'\n'}
  body=${out%$'\n'*}
  [[ $status == 200 ]] || exit 0

  devout=$(cat "$devfile" 2>/dev/null)
  if [[ -n $devout ]]; then
    devstatus=${devout##*$'\n'}
    devbody=${devout%$'\n'*}
    if [[ $devstatus == 200 ]]; then
      count=$(printf '%s' "$devbody" | jq -r '(.devices // []) | length' 2>/dev/null)
      # Zero devices is the one case playback cannot recover from, so the row
      # says so before it is pressed instead of failing quietly afterwards.
      [[ $count == 0 ]] && note="  ·  no Spotify device to play on"
    fi
  fi

  printf '%s' "$body" | jq -c \
    --arg note "$note" \
    --argjson ntrack "$( [[ $types == *,* ]] && echo 4 || echo 8 )" \
    --argjson nalbum "$( [[ $types == *,* ]] && echo 3 || echo 8 )" \
    --argjson nartist "$( [[ $types == *,* ]] && echo 2 || echo 8 )" '
    def pickart:
      ( . // [] ) as $imgs
      # Cards draw art at 44px, so the smallest image at or above 64px is sharp
      # on a hidpi panel without pulling a 640px jpeg per row.
      | ( ( [ $imgs[] | select((.width // 0) >= 64) ] | sort_by(.width) | .[0] )
          // ( $imgs | sort_by(.width // 0) | .[-1] ) )
      | (.url // "");

    def duration:
      ( ( . // 0 ) / 1000 | floor ) as $s
      | "\($s / 60 | floor):\(if ($s % 60) < 10 then "0" else "" end)\($s % 60)";

    def followers:
      ( . // 0 ) as $n
      | if $n >= 1000000 then "\(($n / 100000 | floor) / 10)M followers"
        elif $n >= 1000 then "\(($n / 100 | floor) / 10)K followers"
        else "\($n) followers" end;

    def year: if ((. // "") | length) >= 4 then .[0:4] else "" end;

    def titlecase: (.[0:1] | ascii_upcase) + .[1:];

    def play($uri): "omacast-spotify play " + ($uri | @sh);
    def openin($uri): "xdg-open " + ($uri | @sh);
    def copylink($url): "printf %s " + ($url | @sh) + " | wl-copy";

    ( (.tracks.items // []) | .[0:$ntrack] | to_entries[]
      | .key as $i | .value as $t
      | ($t.uri // "") as $uri
      | ($t.album.release_date // "" | year) as $y
      | {
          id: ("track:" + ($t.id // "\($i)")),
          title: ($t.name // ""),
          subtitle: (([ ($t.artists // [])[].name ] | join(", ")) + $note),
          detail: (($t.album.name // "") + (if $y == "" then "" else "  ·  " + $y end)),
          accessory: ($t.duration_ms | duration),
          art: ($t.album.images | pickart),
          view: "cards",
          group: "Tracks",
          score: (90000 - $i * 100),
          exec: play($uri),
          actions: [
            { title: "Play", shortcut: "↵", exec: play($uri) },
            { title: "Add to Queue", exec: ("omacast-spotify queue " + ($uri | @sh)) },
            { title: "Open in Spotify", exec: openin($uri) },
            { title: "Copy Link", exec: copylink($t.external_urls.spotify // "") }
          ]
        } ),

    ( (.albums.items // []) | .[0:$nalbum] | to_entries[]
      | .key as $i | .value as $a
      | ($a.uri // "") as $uri
      | {
          id: ("album:" + ($a.id // "\($i)")),
          title: ($a.name // ""),
          subtitle: ([ ($a.artists // [])[].name ] | join(", ")),
          detail: ((($a.album_type // "album") | titlecase) + "  ·  \($a.total_tracks // 0) tracks"),
          accessory: ($a.release_date // "" | year),
          art: ($a.images | pickart),
          view: "cards",
          group: "Albums",
          score: (60000 - $i * 100),
          exec: play($uri),
          actions: [
            { title: "Play", shortcut: "↵", exec: play($uri) },
            { title: "Open in Spotify", exec: openin($uri) },
            { title: "Copy Link", exec: copylink($a.external_urls.spotify // "") }
          ]
        } ),

    ( (.artists.items // []) | .[0:$nartist] | to_entries[]
      | .key as $i | .value as $r
      | ($r.uri // "") as $uri
      | {
          id: ("artist:" + ($r.id // "\($i)")),
          title: ($r.name // ""),
          subtitle: (if (($r.genres // []) | length) > 0
                     then ($r.genres | .[0:2] | join(", "))
                     else "Artist" end),
          detail: ($r.followers.total | followers),
          art: ($r.images | pickart),
          view: "cards",
          group: "Artists",
          score: (40000 - $i * 100),
          exec: play($uri),
          actions: [
            { title: "Play", shortcut: "↵", exec: play($uri) },
            { title: "Open in Spotify", exec: openin($uri) },
            { title: "Copy Link", exec: copylink($r.external_urls.spotify // "") }
          ]
        } )
  ' 2>/dev/null
}

do_play() {
  local uri=${1:-} device body out status
  [[ -n $uri ]] || exit 0

  device=$(target_device) || device=""
  if [[ -z $device ]]; then
    notify "No Spotify device is available. Open Spotify on this machine or your phone, then try again."
    exit 0
  fi

  if [[ $uri == spotify:track:* ]]; then
    body=$(jq -cn --arg u "$uri" '{uris: [$u]}')
  else
    body=$(jq -cn --arg u "$uri" '{context_uri: $u}')
  fi

  out=$(api PUT "$API/me/player/play?device_id=$(enc "$device")" "$body")
  status=${out##*$'\n'}
  report "$status" "${out%$'\n'*}"
}

do_queue() {
  local uri=${1:-} device out status
  # Only a track or an episode can be queued; an album uri returns 400.
  [[ $uri == spotify:track:* ]] || exit 0

  device=$(target_device) || device=""
  if [[ -z $device ]]; then
    notify "No Spotify device is available. Open Spotify on this machine or your phone, then try again."
    exit 0
  fi

  out=$(api POST "$API/me/player/queue?uri=$(enc "$uri")&device_id=$(enc "$device")")
  status=${out##*$'\n'}
  if [[ $status == 200 || $status == 202 || $status == 204 ]]; then
    notify "Queued."
  else
    report "$status" "${out%$'\n'*}"
  fi
}

case "${1:-}" in
  search)
    shift
    load_state || exit 0
    ensure_token || exit 0
    do_search "${1:-}" "${2:-}"
    ;;
  play)
    shift
    load_state || exit 0
    ensure_token || exit 0
    do_play "${1:-}"
    ;;
  queue)
    shift
    load_state || exit 0
    ensure_token || exit 0
    do_queue "${1:-}"
    ;;
esac

exit 0

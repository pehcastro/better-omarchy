#!/bin/bash
# Emits JSON rows for OmaCast's `git:` keyword: the state of the repo you are
# in, without opening a terminal to ask.
#
#   git:            status, branch, recent commits, branches, stashes, remote
#   git:feature     the same, narrowed to rows matching that text
#
# The repo is resolved by `omacast-repo --current`, which is where the choice of
# what "the repo I am in" means for a launcher with no working directory is
# written down. Everything below is one pass of cheap git plumbing over that one
# repo, so the cost does not depend on how many repos exist.
#
# Rows carry a group, so the list view labels each section rather than running
# six different kinds of thing together.

set -uo pipefail

query="${1:-}"

# Trimmed. `git:tmux ` with the space you type before the next word is the same
# question as `git:tmux`, and an untrimmed needle matched no repo, fell back to
# the current one, and then filtered its commits by "tmux " which matches
# nothing: the answer vanished as soon as you reached for the space bar.
query="${query#"${query%%[![:space:]]*}"}"
query="${query%"${query##*[![:space:]]}"}"
needle="${query,,}"

command -v git >/dev/null 2>&1 || exit 0

# Which repo. Naming one is how you say so: `git:omarchy` is the repo called
# omarchy, wherever it is. Naming nothing means the one you are in.
#
# There was a "Pin for git:" action that wrote the answer to a state file. It
# was hidden, it had to be found, and it solved in two steps and a file what
# typing the name solves in four characters.
#
# This used to run the whole `repo:` listing and read the first row out of it,
# which is a git status per candidate repo just to work out what a word meant:
# `git:o` cost 227ms on every keystroke. `--resolve` is the same matching with
# no git calls at all, and it is shared with `branch:` and `stash:` so all three
# read a query the same way.
IFS=$'\t' read -r repo needle < <(omacast-repo --resolve "$query" 2>/dev/null)
[[ -n ${repo:-} && -e $repo/.git ]] || exit 0
needle="${needle,,}"

quoted=$(printf '%q' "$repo")
name="${repo##*/}"
display="${repo/#$HOME/\~}"
now=$(date +%s)

short_age() {
  local d=$1
  ((d < 0)) && d=0
  if ((d < 3600)); then
    printf '%dm' $((d / 60))
  elif ((d < 86400)); then
    printf '%dh' $((d / 3600))
  elif ((d < 2592000)); then
    printf '%dd' $((d / 86400))
  elif ((d < 31536000)); then
    printf '%dmo' $((d / 2592000))
  else
    printf '%dy' $((d / 31536000))
  fi
}

# The filter reads what the row says rather than being pushed down into any one
# git query, because the six sections have nothing in common to filter on.
keep() {
  [[ -z $needle ]] && return 0
  local hay="${1,,} ${2,,} ${3,,}"
  [[ $hay == *"$needle"* ]]
}

score=90000
# A tenth argument makes the primary a step rather than a command: the row goes
# somewhere else in the launcher instead of starting a program. That is how the
# branch row reaches `branch:`, and it is the same mechanism the panel uses.
emit() {
  local id="$1" title="$2" detail="$3" subtitle="$4" accessory="$5" group="$6"
  local primary="$7" exec="$8" extra="${9:-[]}" goto="${10:-}"
  # Nonzero when the filter dropped this row, so a caller can count what was
  # actually printed rather than what it offered.
  keep "$title" "$detail" "$group" || return 1
  jq -cn --arg id "$id" --arg t "$title" --arg d "$detail" --arg s "$subtitle" \
    --arg a "$accessory" --arg g "$group" --arg p "$primary" --arg e "$exec" \
    --arg goto "$goto" \
    --argjson sc "$score" --argjson extra "$extra" \
    '{ id: $id, title: $t, detail: $d, subtitle: $s, accessory: $a,
       group: $g, exec: (if $goto == "" then $e else "" end), score: $sc,
       actions: ([if $goto == "" then { title: $p, shortcut: "↵", exec: $e }
                  else { title: $p, shortcut: "↵", query: $goto } end] + $extra) }'
  score=$((score - 100))
}

# The panel
# ------------------------------------------------------------------
#
# A bare `git:` is not a search, it is "show me this repo", and answering it
# with a list of unrelated rows makes the reader assemble the picture. So the
# first row carries the whole picture and its own view draws it: the repo and
# its branch, what is uncommitted, what happened lately, and what is open
# against it.
#
# Typing anything after `git:` goes back to rows, because then it is a search
# again and a panel cannot be filtered.

# Status and branch, in one call
# ------------------------------------------------------------------

branch="" upstream="" ab="" staged=0 changed=0 conflicted=0
while IFS= read -r line; do
  case $line in
  "# branch.head "*) branch="${line#\# branch.head }" ;;
  "# branch.upstream "*) upstream="${line#\# branch.upstream }" ;;
  "# branch.ab "*) ab="${line#\# branch.ab }" ;;
  "#"*) ;;
  "u "*) conflicted=$((conflicted + 1)) ;;
  "1 "* | "2 "*)
    # Field two of a v2 entry is the XY state: X staged, Y in the worktree.
    # Sliced rather than cut, so a repo with a thousand changes is still no
    # forks at all.
    rest="${line#* }"
    xy="${rest%% *}"
    [[ ${xy:0:1} != "." ]] && staged=$((staged + 1))
    [[ ${xy:1:1} != "." ]] && changed=$((changed + 1))
    ;;
  "? "*) changed=$((changed + 1)) ;;
  esac
done < <(git -C "$repo" --no-optional-locks status --porcelain=v2 --branch 2>/dev/null)

[[ -n $branch ]] || exit 0
[[ $branch == "(detached)" ]] && branch="detached"

remote_url=$(git -C "$repo" --no-optional-locks remote get-url origin 2>/dev/null)

# A bare query gets the panel: everything about this repo in one row, drawn by
# a view that knows what a repo is. Anything typed after `git:` is a search, and
# a panel cannot be filtered, so the rows below take over.
if [[ -z $needle ]]; then
  ahead_n=0 behind_n=0
  if [[ -n $ab ]]; then
    a="${ab%% *}"; b="${ab##* }"
    ahead_n="${a#+}"; behind_n="${b#-}"
  fi

  # How many stashes, because "did I stash that" is asked from here and the
  # answer is either a number you can ignore or the reason you type `stash:`.
  stashes=$(git -C "$repo" --no-optional-locks stash list 2>/dev/null | wc -l)

  commits_json=$(git -C "$repo" --no-optional-locks log -6 --format=$'%h\t%s\t%an\t%ct' 2>/dev/null |
    jq -Rn --argjson now "$now" '
      [inputs | split("\t") | select(length >= 4)
       | { hash: .[0], subject: .[1], author: .[2], age: ($now - (.[3] | tonumber)) }]')
  [[ -n ${commits_json:-} ]] || commits_json="[]"

  jq -cn \
    --arg name "$name" --arg path "$display" --arg branch "$branch" \
    --arg upstream "${upstream:-}" --arg quoted "$quoted" \
    --argjson ahead "${ahead_n:-0}" --argjson behind "${behind_n:-0}" \
    --argjson staged "$staged" --argjson changed "$changed" --argjson conflicted "$conflicted" \
    --argjson stashes "${stashes:-0}" \
    --argjson commits "$commits_json" \
    --arg remote "${remote_url:-}" \
    '{ id: "git-panel", view: "gitrepo", score: 99000,
       title: $name, subtitle: $branch, detail: $path,
       repo: { name: $name, path: $path, branch: $branch, upstream: $upstream,
               ahead: $ahead, behind: $behind,
               staged: $staged, changed: $changed, conflicted: $conflicted,
               stashes: $stashes, remote: $remote },
       commits: $commits,
       # A clean repo has no diff, and `git diff` on a clean repo opens a
       # terminal that closes before you have read it. Pressing Enter has to do
       # something, so on a clean repo it shows the log instead of nothing.
       exec: (if ($staged + $changed + $conflicted) > 0
              then "omarchy-launch-tui --app-id=org.omarchy.git git -C " + $quoted + " diff"
              else "omarchy-launch-tui --app-id=org.omarchy.git git -C " + $quoted + " log --stat -20" end),
       actions: [
         (if ($staged + $changed + $conflicted) > 0
          then { title: "Show Diff", shortcut: "↵",
                 exec: ("omarchy-launch-tui --app-id=org.omarchy.git git -C " + $quoted + " diff") }
          else { title: "Show Log", shortcut: "↵",
                 exec: ("omarchy-launch-tui --app-id=org.omarchy.git git -C " + $quoted + " log --stat -20") } end),
         # The depth, reachable by pressing a key rather than by knowing a
         # syntax. Both land on a keyword you can also type, so finding it once
         # here teaches the shorter way in.
         { title: "Branches", query: ("branch:" + $name) },
         { title: "Stashes", query: ("stash:" + $name) },
         # Reading the state is the smaller half. The reason you asked is almost
         # always that you are about to do something, so the things you would
         # have opened anyway are one key away rather than a terminal and a cd.
         { title: "Open in Lazygit",
           exec: ("omarchy-launch-tui --app-id=org.omarchy.lazygit lazygit -p " + $quoted) },
         { title: "Open in Herdr",
           exec: ("omarchy-launch-tui --app-id=org.omarchy.herdr herdr " + $quoted) },
         { title: "Open in Editor",
           exec: ("omarchy-launch-editor " + $quoted) },
         { title: "Open Terminal Here",
           exec: ("setsid uwsm-app -- xdg-terminal-exec --dir=" + $quoted) }
       ] }'
  exit 0
fi

parts=()
((staged)) && parts+=("$staged staged")
((changed)) && parts+=("$changed changed")
((conflicted)) && parts+=("$conflicted conflicted")
((${#parts[@]})) || parts=("clean")
summary=$(
  IFS=", "
  printf '%s' "${parts[*]}"
)

# The row says what changed, so Enter shows what changed. Opening a terminal was
# the primary here, which answers a question nobody asked by typing `git:`.
if ((staged + changed + conflicted)); then
  primary_title="Show Diff"
  primary_exec="omarchy-launch-tui --app-id=org.omarchy.git git -C $quoted diff"
else
  primary_title="Show Log"
  primary_exec="omarchy-launch-tui --app-id=org.omarchy.git git -C $quoted log --stat -20"
fi
emit "status" "$summary" "$display" "$name" "" "Status" "$primary_title" \
  "$primary_exec" \
  "$(jq -cn --arg q "$quoted" '[
       { title: "Open Terminal Here", exec: ("setsid uwsm-app -- xdg-terminal-exec --dir=" + $q) },
       { title: "Full Status", exec: ("omarchy-launch-tui --app-id=org.omarchy.git git -C " + $q + " status") }
     ]')"

track="${upstream:-no upstream}"
if [[ -n $ab ]]; then
  ahead="${ab%% *}"
  behind="${ab##* }"
  ((${ahead#+} > 0)) && track="$track ↑${ahead#+}"
  ((${behind#-} > 0)) && track="$track ↓${behind#-}"
fi

emit "branch" "$branch" "$track" "$name" "" "Branch" "Every Branch" \
  "true" \
  "$(jq -cn --arg q "$quoted" --arg n "$name" --arg b "$branch" '[
       { title: "Copy Branch Name", exec: ("printf %s " + ($b | @sh) + " | wl-copy") },
       { title: "Fetch", exec: ("out=$(git -C " + $q + " fetch --all --prune 2>&1) && omarchy-notification-send \"Fetched\" \"$out\" || omarchy-notification-send -u normal \"git fetch failed\" \"$out\"") }
     ]')" \
  "branch:$name"

# Recent commits
# ------------------------------------------------------------------
#
# Forty rather than eight. With a word typed after `git:` this is no longer a
# recent-activity list, it is somebody asking when they did a thing, and eight
# commits does not reach back far enough to answer that.
#
# Read forty, show sixteen. Every row printed here is two jq processes, and a
# one-letter needle matches nearly every subject: forty rows is eighty forks for
# a card that shows a dozen.

shown=0
while IFS=$'\t' read -r hash subject author ts; do
  [[ -n $hash ]] || continue
  # Asked here as well as inside emit, because the action list below is built by
  # a jq of its own and that fork is paid before emit ever sees the row.
  keep "$subject" "$author" "Recent Commits" || continue
  ((shown < 16)) || break
  shown=$((shown + 1))
  # Reading the commit is why you looked at it. Copying the hash is what you do
  # after deciding, so it comes second.
  emit "commit:$hash" "$subject" "$author" "$hash" "$(short_age $((now - ts)))" \
    "Recent Commits" "Show Commit" \
    "omarchy-launch-tui --app-id=org.omarchy.git git -C $quoted show $hash" \
    "$(jq -cn --arg h "$hash" '[
         { title: "Copy Hash", exec: ("printf %s " + ($h | @sh) + " | wl-copy") }
       ]')"
done < <(git -C "$repo" --no-optional-locks log -40 --format=$'%h\t%s\t%an\t%ct' 2>/dev/null)

# Branches and stashes used to be two more sections down here, as rows carrying
# a name and nothing else: which one is checked out, how far each had drifted
# and what was in a stash were all missing, so the only thing you could do with
# one was read it. They are `branch:` and `stash:` now, each with a view that
# shows those facts and actions that switch and apply. Leaving a weaker copy
# here would only be the version people found first.
#
# GitHub is not this keyword's business either. `repo:` and `git:` are the local
# machine; `gh:` and `github:` are the remote. Open pull requests lived here for
# an hour and blurred that line: one keyword that answers from disk and from
# somebody else's API is two keywords wearing one name.

exit 0

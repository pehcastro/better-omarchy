#!/usr/bin/env python3
"""Every Omarchy setting, searchable, from Omarchy's own menu definition.

`omarchy:` used to be a hand-copied list of routes inside the launcher, which is
a list that goes stale the first time Omarchy adds a setting. This reads the
same file the menu itself reads, so a route that exists in the menu exists here,
and one that does not cannot.

The tree is flattened. The menu is something you walk, four keystrokes deep, and
a launcher is something you type into, so the path becomes context on one row:
"Theme" under "Style" reads as `Theme · Style`, and typing either word finds it.

A row that opens a submenu is kept as well as its children. Sometimes the thing
you want is the submenu.

The path, the icon and whether a route acts or opens all go across as their own
fields, because the `menutree` view draws them rather than reading them out of
a sentence. Joining the path into "Style  ·  Theme" here and splitting it there
would make a separator string into a wire format.

A bare `omarchy:` is not a search, it is browsing, and the answer to browsing is
the menu's own root in the menu's own order. Answering it with ten top-level
rows plus whatever four second-level routes sorted alphabetically first was a
list assembled by the ranking rules for a query nobody typed.
"""

import json
import os
import re
import subprocess
import sys

DEFAULT = "/usr/share/omarchy/default/omarchy/omarchy-menu.jsonc"
USER = os.path.expanduser("~/.config/omarchy/extensions/omarchy-menu.jsonc")


def strip_jsonc(raw):
    """Comments and trailing commas, the same two things the shell strips.

    Deliberately the same crude rules rather than a real JSONC parser: matching
    the menu's own leniency matters more than being correct about a file the
    menu would also reject.
    """
    raw = re.sub(r"^\s*//[^\n]*(\n|$)", "", raw, flags=re.M)
    raw = re.sub(r",(\s*[}\]])", r"\1", raw)
    return raw


def load(path):
    try:
        with open(path) as handle:
            raw = strip_jsonc(handle.read())
    except OSError:
        return {}
    if not raw.strip():
        return {}
    try:
        parsed = json.loads(raw)
    except ValueError:
        return {}
    if not isinstance(parsed, dict):
        return {}
    items = parsed.get("items")
    return items if isinstance(items, dict) else parsed


# Bar panels. These are Omarchy settings by any reasonable definition and the
# menu file does not contain them, because the menu is not how you reach them.
# Leaving them out meant `omarchy:wifi` answered with a QR code generator.
#
# `run` is the command, not a menu route. Every other row here is reached with
# `omarchy menu summon <id>`, and these ids are ours: there is no `panel.network`
# node for the menu to find, so summoning one opened the menu at its root and
# `omarchy:wifi` quietly did nothing useful.
PANELS = {
    "panel.network": {"icon": "\udb81\uddf3", "label": "Wi-Fi",
                      "aliases": ["wifi", "wireless", "network", "internet"],
                      "action": "omarchy-shell shell summon omarchy.network",
                      "run": "omarchy-shell shell summon omarchy.network"},
    "panel.bluetooth": {"icon": "\udb80\udcaf", "label": "Bluetooth",
                        "aliases": ["bluetooth", "pair", "headphones"],
                        "action": "omarchy-shell shell summon omarchy.bluetooth",
                        "run": "omarchy-shell shell summon omarchy.bluetooth"},
    "panel.audio": {"icon": "\udb81\udd7e", "label": "Audio",
                    "aliases": ["audio", "sound", "volume", "output"],
                    "action": "omarchy-shell shell summon omarchy.audio",
                    "run": "omarchy-shell shell summon omarchy.audio"},
    "panel.display": {"icon": "\udb80\udf79", "label": "Display",
                      "aliases": ["display", "monitor", "scale", "resolution"],
                      "action": "omarchy-shell shell summon omarchy.display",
                      "run": "omarchy-shell shell summon omarchy.display"},
    "panel.battery": {"icon": "\udb80\udc79", "label": "Battery",
                      "aliases": ["battery", "power"],
                      "action": "omarchy-shell shell summon omarchy.battery",
                      "run": "omarchy-shell shell summon omarchy.battery"},
}


def items():
    """The default menu, with the user's extension layered on top.

    Same precedence as the shell: a user entry with an existing id replaces it,
    which is how somebody removes a route they do not want.
    """
    merged = {}
    merged.update(PANELS)
    for path in (DEFAULT, USER):
        for key, value in load(path).items():
            if isinstance(value, dict):
                merged[key] = value
    return merged


def passes(when):
    """A row the menu would hide, hidden here too.

    `when` is a shell condition and the menu runs it. Running it per row would
    mean a subprocess per route on every keystroke, so this only runs the ones
    that survive the text match, and there are never many.
    """
    if not when:
        return True
    try:
        return subprocess.run(["bash", "-lc", when], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=2).returncode == 0
    except Exception:
        return False


def label_of(entry, node_id):
    return entry.get("label") or node_id.split(".")[-1].replace("-", " ").title()


def main():
    query = " ".join(sys.argv[1:]).strip().lower()
    tree = items()
    if not tree:
        return 0

    rows = []
    for node_id, entry in tree.items():
        if node_id == "root":
            continue

        label = label_of(entry, node_id)
        parts = node_id.split(".")
        # The path, as words, so "Change Theme" is findable by typing "style".
        trail = [label_of(tree.get(".".join(parts[:i + 1]), {}), ".".join(parts[:i + 1]))
                 for i in range(len(parts) - 1)]

        aliases = [str(a).lower() for a in (entry.get("aliases") or [])]
        label_low = label.lower()
        trail_low = " ".join(trail).lower()
        haystack = " ".join([label_low, node_id.lower(), trail_low] + aliases)

        # Where the words matched decides the order. Ranking on depth alone put
        # "Extra Themes" above "Theme" for `theme`, because both sit two levels
        # down and E sorts before T, which is not what anyone typing four
        # letters meant. Every word must appear somewhere, in any order, so
        # "theme change" still finds "Change Theme".
        rank = 0
        missed = 0
        if query:
            words = query.split()
            # Words that match nothing anywhere are dropped rather than fatal:
            # "change theme" is how people ask for the theme setting, and the
            # menu calls it "Theme", so requiring both words found nothing at
            # all. At least one word still has to land.
            asked = len(words)
            words = [w for w in words if w in haystack]
            if not words:
                continue
            # How much of what was asked actually landed, ahead of where it
            # landed: "set volume" matching only "set" on Setup should lose to
            # Audio, which matches "volume" and is what the words together mean.
            missed = asked - len(words)

            effective = " ".join(words)
            if label_low == query or label_low == effective:
                rank = 0
            elif label_low.startswith(query) or label_low.startswith(effective):
                rank = 1
            elif any(a == query or a == effective or a.startswith(query) or a.startswith(effective) for a in aliases):
                rank = 2
            elif query in label_low:
                rank = 3
            elif all(w in label_low for w in words):
                rank = 4
            else:
                rank = 5

        kind = "action" if entry.get("action") else ("link" if entry.get("target") else "menu")

        rows.append({
            "node_id": node_id,
            "label": label,
            "trail": trail,
            "kind": kind,
            "rank": rank,
            "missed": missed if query else 0,
            "when": entry.get("when") or "",
            "icon": entry.get("icon") or "",
            "description": entry.get("description") or "",
            # How much is behind this route. Only worth saying on a tile, where
            # "Style" and "About" are the same size and one of them holds
            # eighteen settings.
            "children": sum(1 for other in tree if other.startswith(node_id + ".")),
            "exec": entry.get("run") or ("omarchy menu summon " + node_id),
        })

    browsing = not query

    if browsing:
        # The root, in the order the menu file writes it. Not sorted: the menu's
        # order is the one the user has already learned from opening the menu,
        # and alphabetising it here would make the same ten things sit somewhere
        # else depending on which surface they came from.
        rows = [r for r in rows if "." not in r["node_id"]]
    else:
        # Then a shorter path, because a top-level route is almost always what
        # someone typing two letters meant.
        rows.sort(key=lambda r: (r["missed"], r["rank"],
                                 len(r["node_id"].split(".")), r["label"].lower()))

    shown = 0
    for row in rows:
        if shown >= 16:
            break
        if not passes(row["when"]):
            continue
        shown += 1

        # Still written out, because a row that ends up in the plain list view
        # for any reason should not lose its context. The view ignores it.
        subtitle = "  ·  ".join(row["trail"]) if row["trail"] else "Omarchy"
        if row["kind"] == "menu":
            subtitle += "  ·  opens a submenu"

        print(json.dumps({
            "id": "omarchy-" + row["node_id"],
            "title": row["label"],
            "subtitle": subtitle,
            "detail": row["description"],
            "accessory": row["node_id"],
            "glyph": row["icon"],
            "exec": row["exec"],
            "score": 95000 - shown * 100,
            "view": "menutree",
            # Browsing and searching are two different pictures of the same
            # tree, and only this script knows which one was asked for.
            "mode": "browse" if browsing else "search",
            "trail": row["trail"],
            "kind": row["kind"],
            "node": row["node_id"],
            "depth": len(row["node_id"].split(".")),
            "children": row["children"],
            "actions": [
                {"title": "Open", "shortcut": "↵", "exec": row["exec"]},
                {"title": "Copy the Route",
                 "exec": "printf %s " + json.dumps(row["node_id"]) + " | wl-copy"},
            ],
        }))

    return 0


if __name__ == "__main__":
    sys.exit(main())

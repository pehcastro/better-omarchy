#!/usr/bin/env python3
"""OmaCast's `do:` keyword: a sentence in the search box, done by a local agent.

    do: open a new workspace and split the terminal into four
    do: find every TODO in this repo and list them
    do:@codex explain what changed on this branch

Four things about the shape of this, because none of them is arbitrary.

**Typing never runs anything.** A typed instruction is answered with a preview
row: which agent would take it, in which directory, under which policy. Only
Enter starts a process. That is the confirmation, and it is the only one a
launcher can honestly offer: a modal on top of an overlay that already holds
the keyboard exclusively is a dialog nobody can answer.

**Enter carries a token, not the sentence.** `search` records what it previewed
in a small store, keyed by a hash of the instruction. The row's `exec` is
`omacast-agent run <token>`, so no prose the user typed ever reaches a shell,
and nothing can be run that was not first shown on screen.

**The run is read-only by construction.** The agent CLI is invoked in its
default non-interactive permission mode, which refuses anything that writes and
reports each refusal in the stream. Nothing here ever passes
`--dangerously-skip-permissions` or a permissive `--permission-mode`, and there
is no setting that turns that off: write access is not something a search box
gets to grant. What the agent *is* pre-approved for is one command, `omacast-agent
desk`, whose verbs are enumerated below; `hyprctl` itself is on the deny list
precisely because `hyprctl dispatch exec` would hand back everything the rest of
the policy takes away.

**The run lives exactly as long as you are watching it.** The launcher re-asks
this extension while its rows are on screen (`refreshMs`), so those questions
are a heartbeat. Escape clears the box, the rows go, the heartbeat stops, and
the daemon kills the process group. The same happens when the launcher closes.
An agent running commands on your machine with nowhere to show you what it is
doing is the state this avoids, and the way out for genuinely long work is the
Ctrl+K action that hands the same instruction to a real terminal.

Subcommands:

    search <query>     one JSON row, for the launcher (cheap: never runs an agent)
    serve              the daemon: owns the agent process, answers the socket
    run <token>        start the instruction behind that token (called by Enter)
    stop               stop whatever is running
    term <token>       hand the instruction to an interactive agent in a terminal
    desk <verb> ...    the only shell command the agent is pre-approved to run
"""

import errno
import hashlib
import json
import os
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import time

STATE = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "omarchy")
SOCKET = os.path.join(STATE, "omacast-agent.sock")
PREVIEWS = os.path.join(STATE, "omacast-agent-previews.json")

# How long a run survives with nobody watching. The launcher's refresh interval
# is 800ms, so five seconds is six missed heartbeats: long enough that a slow
# frame or a redraw never kills a run, short enough that Escape feels like a
# stop rather than a suggestion.
GRACE = 5.0
# The daemon exists to hold one agent process. With no run and nobody asking, it
# is a few megabytes of nothing, so it leaves.
IDLE_EXIT = 600.0

MAX_STEPS = 60
MAX_ANSWER = 8000


# --------------------------------------------------------------- the agents

# Only agents whose read-only mode is a flag rather than a hope. opencode and
# crush are deliberately absent: an agent that cannot be told "look, do not
# touch" is not one this should be starting without a human at the prompt.
#
#   stream  how its output is read: "claude" is the parsed step stream,
#           "plain" is prose only, with no step list to show.
AGENTS = [
    {"id": "claude", "title": "Claude", "bin": "claude", "stream": "claude"},
    {"id": "codex", "title": "Codex", "bin": "codex", "stream": "plain"},
    {"id": "gemini", "title": "Gemini", "bin": "gemini", "stream": "plain"},
]

# Pre-approved. Everything here is either a read or the one desktop helper whose
# verbs are a closed set. Nothing on this list can write a file.
ALLOWED = [
    "Read", "Glob", "Grep", "WebFetch", "WebSearch", "TodoWrite",
    "Bash(omacast-agent desk:*)",
]

# Denied outright, on top of the CLI's own refusal to write in its default
# non-interactive mode. `hyprctl` is here because `hyprctl dispatch exec` is a
# shell by another name, and `omacast-agent desk` exists so the agent never
# needs it.
DENIED = [
    "Write", "Edit", "MultiEdit", "NotebookEdit",
    "Bash(sudo:*)", "Bash(rm:*)", "Bash(rmdir:*)", "Bash(mv:*)", "Bash(dd:*)",
    "Bash(mkfs:*)", "Bash(shred:*)", "Bash(truncate:*)", "Bash(chmod:*)",
    "Bash(chown:*)", "Bash(ln:*)", "Bash(tee:*)", "Bash(install:*)",
    "Bash(systemctl:*)", "Bash(loginctl:*)", "Bash(pacman:*)", "Bash(yay:*)",
    "Bash(paru:*)", "Bash(pip:*)", "Bash(npm:*)", "Bash(cargo:*)",
    "Bash(hyprctl:*)", "Bash(omarchy:*)",
    "Bash(git push:*)", "Bash(git commit:*)", "Bash(git reset:*)",
    "Bash(git checkout:*)", "Bash(gh:*)", "Bash(ssh:*)", "Bash(scp:*)",
    "Bash(curl:*)", "Bash(wget:*)", "Bash(kill:*)", "Bash(pkill:*)",
]

BRIEF = (
    "You are answering inside a desktop launcher. The reply is drawn in a card "
    "about twelve lines tall, so answer in a few short lines with no preamble "
    "and no markdown headings. You cannot write, move or delete files and you "
    "cannot install anything; say so plainly if the task needs it rather than "
    "trying. To change windows or workspaces, or to launch an application, run "
    "`omacast-agent desk` (run `omacast-agent desk help` to see its verbs). Do "
    "not call hyprctl directly, it is blocked."
)

EXAMPLES = [
    "open a new workspace and split the terminal into four",
    "find every TODO in this repo and list them",
    "what is taking up space in my downloads folder",
]


def which(name):
    return shutil.which(name)


def agents_present():
    return [a for a in AGENTS if which(a["bin"])]


def pick_agent(named):
    """The agent for this query. A named one that is missing is an answer in its
    own right, not a silent fall back to another: asking Codex and being
    answered by Claude is worse than being told Codex is not here."""
    if named:
        for a in AGENTS:
            if a["id"] == named.lower():
                return a if which(a["bin"]) else {"missing": named, **a}
        return {"missing": named, "id": named, "title": named, "bin": named,
                "stream": "plain"}
    here = agents_present()
    return here[0] if here else None


AT = re.compile(r"^@([A-Za-z0-9_.-]+)\s*")


def split_query(text):
    """`@codex do the thing` -> ("codex", "do the thing")."""
    text = (text or "").strip()
    m = AT.match(text)
    if not m:
        return "", text
    return m.group(1), text[m.end():].strip()


_WORKDIR = []


def workdir():
    """Where a run happens. `omacast-repo --current` is where this launcher has
    already written down what "the repo I am in" means for a window with no
    working directory, so the agent inherits that answer rather than inventing a
    second one. Asked once per process, because the daemon answers a question
    every refresh tick and a fork per tick is what the socket exists to avoid."""
    if _WORKDIR:
        return _WORKDIR[0]
    _WORKDIR.append(os.path.expanduser("~"))
    try:
        out = subprocess.run(["omacast-repo", "--current"], capture_output=True,
                             text=True, timeout=3).stdout.strip()
        if out and os.path.isdir(out):
            _WORKDIR[0] = out
    except Exception:
        pass
    return _WORKDIR[0]


def token_for(agent_id, instruction, cwd):
    raw = "\x00".join([agent_id, instruction, cwd]).encode("utf-8")
    return hashlib.sha256(raw).hexdigest()[:16]


def tilde(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path.startswith(home) else path


# ------------------------------------------------------------ preview store

def read_previews():
    try:
        with open(PREVIEWS, "r") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def remember_preview(token, entry):
    """What the user has been shown, so `run <token>` can only start something
    that was previewed. Bounded, because this is a record of the last few
    things typed and not a history anybody asked to keep."""
    data = read_previews()
    if token in data:
        return
    data[token] = entry
    if len(data) > 32:
        oldest = sorted(data.items(), key=lambda kv: kv[1].get("at", 0))
        for k, _ in oldest[:len(data) - 32]:
            data.pop(k, None)
    os.makedirs(STATE, exist_ok=True)
    tmp = PREVIEWS + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh)
    os.chmod(tmp, 0o600)
    os.replace(tmp, PREVIEWS)


# -------------------------------------------------------------------- rows

def policy_line(agent):
    return "%s · reads and looks, never writes" % agent["title"]


def base_row(**kw):
    row = {
        "id": "agent",
        "view": "agent",
        "group": "Agent",
        "steps": [],
        "answer": "",
        "blocked": [],
        "hints": [],
    }
    row.update(kw)
    return row


def hint_row(agent):
    if agent is None:
        return missing_row("")
    return base_row(
        state="hint",
        title="Say what you want done",
        subtitle=policy_line(agent),
        agentName=agent["title"],
        cwd=tilde(workdir()),
        hints=EXAMPLES,
    )


def missing_row(named):
    """The honest answer when there is no agent to hand this to. A `when` that
    hid the keyword instead would make typing `do:` produce nothing at all,
    which reads as the launcher being broken rather than as the CLI being
    absent."""
    here = ", ".join(a["title"] for a in agents_present())
    if named:
        title = "%s is not installed" % named
        subtitle = ("Installed here: " + here) if here else \
            "No agent CLI found. Install claude, codex or gemini."
    else:
        title = "No agent CLI found"
        subtitle = "Install claude, codex or gemini and this keyword works."
    return base_row(state="missing", title=title, subtitle=subtitle,
                    agentName=named or "", hints=[])


def ready_row(agent, instruction, cwd, token):
    return base_row(
        state="ready",
        title=instruction,
        subtitle=policy_line(agent),
        agentName=agent["title"],
        cwd=tilde(cwd),
        exec="omacast-agent run " + token + " " + instruction,
        keepOpen=True,
        actions=[
            {"title": "Run in a terminal, where you answer the prompts",
             "subtitle": "Write access lives there, not here",
             "exec": "omacast-agent term " + token},
            {"title": "Copy the instruction",
             "exec": "printf %s " + shlex.quote(instruction) + " | wl-copy"},
        ],
    )


# ------------------------------------------------------------- the run itself

class Run:
    """One agent process and everything read out of its stream so far."""

    def __init__(self, agent, instruction, cwd, token):
        self.agent = agent
        self.instruction = instruction
        self.cwd = cwd
        self.token = token
        self.state = "running"
        self.steps = []
        self.answer = ""
        self.blocked = []
        self.started = time.time()
        self.finished = 0.0
        self.error = ""
        self.seen = time.time()
        self.buf = b""
        self.proc = None
        self.pending = {}

    # ----- starting and stopping

    def command(self):
        a = self.agent
        if a["id"] == "claude":
            cmd = ["claude", "-p", "--output-format", "stream-json", "--verbose",
                   "--append-system-prompt", BRIEF]
            for t in ALLOWED:
                cmd += ["--allowedTools", t]
            for t in DENIED:
                cmd += ["--disallowedTools", t]
            return cmd + [self.instruction]
        if a["id"] == "codex":
            return ["codex", "exec", "--sandbox", "read-only",
                    "--skip-git-repo-check", "--color", "never",
                    self.instruction + "\n\n" + BRIEF]
        if a["id"] == "gemini":
            return ["gemini", "--approval-mode", "plan", "-p",
                    self.instruction + "\n\n" + BRIEF]
        return [a["bin"], self.instruction]

    def start(self):
        devnull = os.open(os.devnull, os.O_RDONLY)
        try:
            self.proc = subprocess.Popen(
                self.command(), cwd=self.cwd, stdin=devnull,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                # Its own process group, which is the whole of the cancellation
                # story: an agent forks compilers and greps, and killing the
                # one pid it told us about leaves those running.
                start_new_session=True)
        finally:
            os.close(devnull)
        os.set_blocking(self.proc.stdout.fileno(), False)

    def kill(self, why):
        if self.proc and self.proc.poll() is None:
            try:
                os.killpg(os.getpgid(self.proc.pid), signal.SIGTERM)
            except (ProcessLookupError, PermissionError, OSError):
                pass
            # A SIGTERM an agent chooses to ignore is not a stop, so the group
            # gets a second, unignorable one shortly after.
            deadline = time.time() + 1.5
            while self.proc.poll() is None and time.time() < deadline:
                time.sleep(0.05)
            if self.proc.poll() is None:
                try:
                    os.killpg(os.getpgid(self.proc.pid), signal.SIGKILL)
                except (ProcessLookupError, PermissionError, OSError):
                    pass
        if self.state == "running":
            self.state = "stopped"
            self.error = why
            self.finished = time.time()

    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    # ----- reading the stream

    def drain(self):
        """Everything readable right now. Returns True if anything changed."""
        changed = False
        while True:
            try:
                chunk = self.proc.stdout.read(65536)
            except (BlockingIOError, InterruptedError):
                break
            except (ValueError, OSError):
                break
            if not chunk:
                break
            self.buf += chunk
            changed = True
        while b"\n" in self.buf:
            line, self.buf = self.buf.split(b"\n", 1)
            self.absorb(line.decode("utf-8", "replace"))
        if not self.alive() and self.state == "running":
            if self.buf:
                self.absorb(self.buf.decode("utf-8", "replace"))
                self.buf = b""
            code = self.proc.poll()
            self.finished = time.time()
            if code == 0:
                self.state = "done"
            else:
                self.state = "failed"
                if not self.error:
                    self.error = "%s exited %s" % (self.agent["title"], code)
            changed = True
        return changed

    def absorb(self, line):
        if self.agent["stream"] == "claude":
            self.absorb_claude(line)
        else:
            self.absorb_plain(line)

    def absorb_plain(self, line):
        """No step list, because these CLIs do not publish one this can read.
        Their prose streams and the view says so, which is a smaller promise
        honestly kept rather than a step list invented from log decoration."""
        text = ANSI.sub("", line).rstrip()
        if not text.strip():
            return
        self.answer = (self.answer + "\n" + text)[-MAX_ANSWER:]

    def absorb_claude(self, line):
        line = line.strip()
        if not line:
            return
        try:
            ev = json.loads(line)
        except ValueError:
            return
        if not isinstance(ev, dict):
            return
        kind = ev.get("type")

        if kind == "assistant":
            for part in (ev.get("message") or {}).get("content") or []:
                if part.get("type") == "tool_use":
                    self.step(part)
                elif part.get("type") == "text" and part.get("text"):
                    self.answer = (self.answer + part["text"])[-MAX_ANSWER:]
            return

        if kind == "system" and ev.get("subtype") == "permission_denied":
            # The refusals are the half of the transcript that has to be shown.
            # An agent that quietly could not do the thing, and then wrote a
            # paragraph about what it would have done, is how somebody comes to
            # believe the launcher did something it did not.
            step = self.pending.pop(ev.get("tool_use_id"), None)
            what = step["text"] if step else str(ev.get("tool_name") or "a tool")
            if step:
                step["kind"] = "blocked"
            self.blocked.append({"text": what,
                                 "why": short(str(ev.get("message") or ""), 200)})
            return

        if kind == "user":
            for part in (ev.get("message") or {}).get("content") or []:
                if part.get("type") != "tool_result":
                    continue
                step = self.pending.pop(part.get("tool_use_id"), None)
                if step and part.get("is_error") and step["kind"] != "blocked":
                    step["kind"] = "failed"
            return

        if kind == "result":
            text = ev.get("result")
            if isinstance(text, str) and text.strip():
                self.answer = text[-MAX_ANSWER:]
            if ev.get("subtype") not in (None, "success"):
                self.error = str(ev.get("subtype"))

    def step(self, part):
        name = str(part.get("name") or "")
        inp = part.get("input") or {}
        kind, text = describe(name, inp)
        entry = {"kind": kind, "text": text}
        self.steps.append(entry)
        del self.steps[:-MAX_STEPS]
        if part.get("id"):
            self.pending[part["id"]] = entry

    # ----- what the launcher draws

    def row(self):
        return base_row(
            state=self.state,
            title=self.instruction,
            subtitle=policy_line(self.agent),
            agentName=self.agent["title"],
            cwd=tilde(self.cwd),
            startedAt=int(self.started),
            elapsed=int((self.finished or time.time()) - self.started),
            steps=self.steps[-MAX_STEPS:],
            answer=self.answer.strip(),
            blocked=self.blocked,
            note=self.error,
            exec=("omacast-agent stop" if self.state == "running"
                  else "omacast-agent run " + self.token),
            keepOpen=True,
            actions=[
                {"title": "Run in a terminal, where you answer the prompts",
                 "subtitle": "Write access lives there, not here",
                 "exec": "omacast-agent term " + self.token},
                {"title": "Copy the answer",
                 "exec": "printf %s " + shlex.quote(self.answer.strip() or
                                                    self.instruction) +
                         " | wl-copy"},
            ],
        )


ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")


def short(text, n):
    text = " ".join(str(text).split())
    return text if len(text) <= n else text[:n - 1] + "…"


def describe(name, inp):
    """One tool call as one line somebody can read. A step list is only worth
    drawing if each line says what happened to something nameable; "Bash" over
    and over is a progress bar with extra steps."""
    if name == "Read":
        return "read", "Read " + tilde(str(inp.get("file_path") or ""))
    if name == "Glob":
        return "find", "Find " + short(inp.get("pattern") or "", 60)
    if name == "Grep":
        return "find", "Search " + short(inp.get("pattern") or "", 60)
    if name in ("Write", "Edit", "MultiEdit", "NotebookEdit"):
        return "write", "Edit " + tilde(str(inp.get("file_path") or ""))
    if name == "Bash":
        cmd = short(inp.get("command") or "", 90)
        if cmd.startswith("omacast-agent desk "):
            return "desk", cmd[len("omacast-agent desk "):]
        return "shell", cmd
    if name == "WebFetch":
        return "web", "Fetch " + short(inp.get("url") or "", 70)
    if name == "WebSearch":
        return "web", "Search the web for " + short(inp.get("query") or "", 60)
    if name == "Task":
        return "think", short(inp.get("description") or "Subagent", 70)
    if name == "TodoWrite":
        return "think", "Plan"
    return "think", name or "step"


# ------------------------------------------------------------------ daemon

class Daemon:
    def __init__(self):
        self.run = None
        self.clients = {}          # conn -> {"buf":bytes,"epoch":int,"query":str}
        self.last_touch = time.time()
        self.listener = None

    def listen(self):
        os.makedirs(STATE, exist_ok=True)
        try:
            os.unlink(SOCKET)
        except OSError as e:
            if e.errno != errno.ENOENT:
                raise
        self.listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.listener.bind(SOCKET)
        os.chmod(SOCKET, 0o600)
        self.listener.listen(8)
        self.listener.setblocking(False)

    def loop(self):
        import select
        while True:
            rlist = [self.listener] + list(self.clients)
            streaming = (self.run and self.run.proc
                         and self.run.state == "running")
            if streaming:
                rlist.append(self.run.proc.stdout)
            try:
                ready, _, _ = select.select(rlist, [], [], 0.4)
            except (InterruptedError, OSError):
                ready = []

            for r in ready:
                if r is self.listener:
                    self.accept()
                elif streaming and r is self.run.proc.stdout:
                    if self.run.drain():
                        self.push()
                else:
                    self.read(r)

            if self.run and self.run.state == "running":
                if self.run.drain():
                    self.push()
                # Nobody is watching. The launcher asks this extension again
                # every refresh tick while its rows are on screen, so silence
                # here means the rows are gone: Escape, a new query, or the
                # launcher closed. Either way there is no window left to show
                # what this is doing, so it stops.
                if time.time() - self.run.seen > GRACE:
                    self.run.kill("stopped: nothing was watching it")
                    self.push()

            if not self.clients and not (self.run and self.run.state == "running") \
                    and time.time() - self.last_touch > IDLE_EXIT:
                return

    def accept(self):
        try:
            conn, _ = self.listener.accept()
        except OSError:
            return
        conn.setblocking(False)
        self.clients[conn] = {"buf": b"", "epoch": -1, "query": ""}
        self.last_touch = time.time()

    def drop(self, conn):
        self.clients.pop(conn, None)
        try:
            conn.close()
        except OSError:
            pass

    def read(self, conn):
        state = self.clients.get(conn)
        if state is None:
            return
        try:
            chunk = conn.recv(65536)
        except (BlockingIOError, InterruptedError):
            return
        except OSError:
            return self.drop(conn)
        if not chunk:
            return self.drop(conn)
        self.last_touch = time.time()
        state["buf"] += chunk
        while b"\n" in state["buf"]:
            line, state["buf"] = state["buf"].split(b"\n", 1)
            self.handle(conn, state, line.decode("utf-8", "replace"))

    def send(self, conn, payload):
        try:
            conn.sendall((json.dumps(payload) + "\n").encode("utf-8"))
        except OSError:
            self.drop(conn)

    def handle(self, conn, state, line):
        line = line.strip()
        if not line:
            return
        try:
            msg = json.loads(line)
        except ValueError:
            return
        if not isinstance(msg, dict):
            return

        control = msg.get("control")
        if control == "run":
            return self.send(conn, {"ok": self.start(msg.get("token"))})
        if control == "stop":
            if self.run:
                self.run.kill("stopped")
                self.push()
            return self.send(conn, {"ok": True})
        if control == "ping":
            return self.send(conn, {"ok": True})

        epoch = msg.get("epoch")
        query = str(msg.get("query") or "")
        if not isinstance(epoch, int):
            return
        state["epoch"] = epoch
        state["query"] = query
        # This question is also the heartbeat, but only for the run it is
        # actually about: typing something else is walking away from the old
        # one, and must not keep it alive.
        rows = self.rows(query)
        self.send(conn, {"epoch": epoch, "query": query, "rows": rows})

    def rows(self, query):
        named, instruction = split_query(query)
        agent = pick_agent(named)

        if agent is None or agent.get("missing"):
            return [missing_row(named or "")]
        if not instruction:
            return [hint_row(agent)]

        cwd = workdir()
        token = token_for(agent["id"], instruction, cwd)

        if self.run and self.run.token == token:
            self.run.seen = time.time()
            return [self.run.row()]

        remember_preview(token, {"agent": agent["id"], "instruction": instruction,
                                 "cwd": cwd, "at": int(time.time())})
        return [ready_row(agent, instruction, cwd, token)]

    def push(self):
        """Rows go out without being asked for, which is what makes this stream
        rather than poll. The epoch each client last sent is echoed back
        unchanged, so an answer that arrives after the user moved on is dropped
        by the launcher instead of repopulating the card."""
        for conn, state in list(self.clients.items()):
            if state["epoch"] < 0:
                continue
            self.send(conn, {"epoch": state["epoch"], "query": state["query"],
                             "rows": self.rows(state["query"])})

    def start(self, token):
        entry = read_previews().get(str(token or ""))
        if not entry:
            # A token nobody previewed. This is the one place the "Enter runs
            # what you were shown" promise is enforced, so it fails closed.
            return False
        agent = pick_agent(entry.get("agent"))
        if agent is None or agent.get("missing"):
            return False
        if self.run:
            self.run.kill("replaced")
        self.run = Run(agent, entry["instruction"], entry["cwd"], str(token))
        try:
            self.run.start()
        except OSError as e:
            self.run.state = "failed"
            self.run.error = str(e)
        self.push()
        return True


# ----------------------------------------------------------------- clients

def socket_alive():
    if not os.path.exists(SOCKET):
        return False
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.4)
        s.connect(SOCKET)
        s.close()
        return True
    except OSError:
        return False


def talk(payload, timeout=2.0):
    """One request, one line back. Used by `search` when the daemon happens to
    be up, and by `run`/`stop`, which need it to be."""
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(SOCKET)
        s.sendall((json.dumps(payload) + "\n").encode("utf-8"))
        buf = b""
        while b"\n" not in buf:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        s.close()
        return json.loads(buf.split(b"\n", 1)[0].decode("utf-8"))
    except (OSError, ValueError):
        return None


def ensure_daemon():
    if socket_alive():
        return True
    devnull = open(os.devnull, "r+b")
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "serve"],
                     stdin=devnull, stdout=devnull, stderr=devnull,
                     start_new_session=True)
    deadline = time.time() + 4
    while time.time() < deadline:
        if socket_alive():
            return True
        time.sleep(0.08)
    return False


def cmd_search(query):
    """The launcher's cheap path. It never starts an agent and never starts the
    daemon: the whole cost of typing here is one preview row computed locally,
    or one round trip if a run is already going."""
    if socket_alive():
        reply = talk({"epoch": 0, "query": query})
        if reply and isinstance(reply.get("rows"), list):
            print(json.dumps(reply["rows"]))
            return 0

    named, instruction = split_query(query)
    agent = pick_agent(named)
    if agent is None or agent.get("missing"):
        rows = [missing_row(named or "")]
    elif not instruction:
        rows = [hint_row(agent)]
    else:
        cwd = workdir()
        token = token_for(agent["id"], instruction, cwd)
        remember_preview(token, {"agent": agent["id"], "instruction": instruction,
                                 "cwd": cwd, "at": int(time.time())})
        rows = [ready_row(agent, instruction, cwd, token)]
    print(json.dumps(rows))
    return 0


def cmd_run(token):
    if not re.fullmatch(r"[0-9a-f]{16}", str(token or "")):
        return 2
    if not read_previews().get(token):
        return 2
    if not ensure_daemon():
        return 1
    reply = talk({"control": "run", "token": token}, timeout=6.0)
    return 0 if (reply or {}).get("ok") else 1


def cmd_stop():
    if socket_alive():
        talk({"control": "stop"})
    return 0


def cmd_term(token):
    """The way out. Anything this refuses to do without a human is a thing a
    human should be looking at, so it goes to a terminal where the agent's own
    permission prompts exist and somebody answers them."""
    entry = read_previews().get(str(token or ""))
    if not entry:
        return 2
    agent = pick_agent(entry.get("agent"))
    if agent is None or agent.get("missing"):
        return 2
    inner = {
        "claude": ["claude", entry["instruction"]],
        "codex": ["codex", entry["instruction"]],
        "gemini": ["gemini", "-i", entry["instruction"]],
    }.get(agent["id"], [agent["bin"], entry["instruction"]])
    term = os.environ.get("TERMINAL") or which("alacritty") or which("ghostty") \
        or which("foot") or which("kitty") or "xterm"
    subprocess.Popen([term, "--working-directory", entry["cwd"], "-e"] + inner,
                     start_new_session=True)
    return 0


# ------------------------------------------------------- the desktop helper

# The only shell command the agent is pre-approved to run, and the reason
# `hyprctl` is on the deny list. Every verb below takes arguments matched
# against a pattern, so there is no argument the model can write that turns one
# of these into a command line of its own choosing. `dispatch exec` is not here
# and will not be: launching an arbitrary argv is the thing the rest of this
# policy exists to prevent, which is why `open` takes an application, not a
# command.
DIRECTIONS = r"[lrud]"
DESK = {
    "workspace": (r"[A-Za-z0-9_+-]{1,32}", "workspace"),
    "move": (r"[A-Za-z0-9_+-]{1,32}", "movetoworkspace"),
    "focus": (DIRECTIONS, "movefocus"),
    "swap": (DIRECTIONS, "swapwindow"),
    "preselect": (DIRECTIONS, None),
    "ratio": (r"[+-]?(0(\.[0-9]{1,3})?|1(\.0{1,3})?)", "splitratio"),
    "float": (r"", "togglefloating"),
    "fullscreen": (r"[01]?", "fullscreen"),
    "split": (r"", None),
    "close": (r"", "killactive"),
}

DESK_HELP = """omacast-agent desk <verb> [argument]

  list                  every window, workspace and monitor, as JSON
  workspace <name>      go to a workspace: a number, a name, +1, -1, empty
  move <name>           move the focused window to one
  open <app>            launch an installed application by name
  focus <l|r|u|d>       move focus
  swap <l|r|u|d>        swap the focused window with its neighbour
  preselect <l|r|u|d>   put the next window on that side of this one
  split                 flip the current split between rows and columns
  ratio <-1..1>         resize the split
  float                 float or tile the focused window
  fullscreen [0|1]      fullscreen the focused window
  close                 close the focused window

Nothing else reaches Hyprland from here. `hyprctl` itself is blocked."""


def hypr(*args):
    p = subprocess.run(["hyprctl"] + list(args), capture_output=True, text=True)
    sys.stdout.write(p.stdout)
    if p.returncode != 0:
        sys.stderr.write(p.stderr)
    return p.returncode


def desktop_entry(name):
    """An application, resolved to an installed .desktop file. Taking a name
    rather than a command line is the point: `open` is not a way to run
    something, it is a way to start something already installed."""
    name = name.strip().lower()
    if name in ("terminal", "term", "console", "shell"):
        for cand in ("alacritty", "ghostty", "foot", "kitty", "wezterm"):
            hit = desktop_entry(cand)
            if hit:
                return hit
        return None
    if not re.fullmatch(r"[A-Za-z0-9._+-]{1,64}", name):
        return None
    roots = [os.path.expanduser("~/.local/share/applications")] + [
        os.path.join(d, "applications")
        for d in (os.environ.get("XDG_DATA_DIRS")
                  or "/usr/local/share:/usr/share").split(":")]
    for root in roots:
        for suffix in (".desktop",):
            path = os.path.join(root, name + suffix)
            if os.path.isfile(path):
                return path
    for root in roots:
        if not os.path.isdir(root):
            continue
        for f in sorted(os.listdir(root)):
            if f.endswith(".desktop") and name in f.lower():
                return os.path.join(root, f)
    return None


def cmd_desk(args):
    if not args or args[0] in ("help", "-h", "--help"):
        print(DESK_HELP)
        return 0
    verb, rest = args[0], args[1:]

    if verb == "list":
        out = {}
        for what in ("clients", "workspaces", "monitors", "activewindow"):
            p = subprocess.run(["hyprctl", "-j", what], capture_output=True,
                               text=True)
            try:
                out[what] = json.loads(p.stdout)
            except ValueError:
                out[what] = None
        print(json.dumps(out, indent=1)[:20000])
        return 0

    if verb == "open":
        entry = desktop_entry(" ".join(rest))
        if not entry:
            print("no installed application called %r" % " ".join(rest),
                  file=sys.stderr)
            return 2
        launcher = which("gtk-launch")
        if launcher:
            subprocess.Popen([launcher, os.path.basename(entry)],
                             start_new_session=True)
        else:
            subprocess.Popen(["gio", "launch", entry], start_new_session=True)
        print("launched " + os.path.basename(entry))
        return 0

    if verb not in DESK:
        print("no such verb %r. `omacast-agent desk help`" % verb,
              file=sys.stderr)
        return 2

    pattern, dispatch = DESK[verb]
    arg = " ".join(rest).strip()
    if not re.fullmatch(pattern, arg):
        print("%r is not a %s argument" % (arg, verb), file=sys.stderr)
        return 2

    if verb == "preselect":
        return hypr("dispatch", "layoutmsg", "preselect " + arg)
    if verb == "split":
        return hypr("dispatch", "layoutmsg", "togglesplit")
    if arg:
        return hypr("dispatch", dispatch, arg)
    return hypr("dispatch", dispatch)


# -------------------------------------------------------------------- main

def main(argv):
    if len(argv) < 2:
        return cmd_search("")
    verb = argv[1]
    if verb == "search":
        return cmd_search(" ".join(argv[2:]))
    if verb == "serve":
        d = Daemon()
        d.listen()
        try:
            d.loop()
        finally:
            if d.run:
                d.run.kill("daemon exiting")
            try:
                os.unlink(SOCKET)
            except OSError:
                pass
        return 0
    if verb == "run":
        return cmd_run(argv[2] if len(argv) > 2 else "")
    if verb == "stop":
        return cmd_stop()
    if verb == "term":
        return cmd_term(argv[2] if len(argv) > 2 else "")
    if verb == "desk":
        return cmd_desk(argv[2:])
    if verb == "agents":
        for a in AGENTS:
            print("%-8s %s" % (a["id"], which(a["bin"]) or "not installed"))
        return 0
    return cmd_search(" ".join(argv[1:]))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)

#!/bin/bash
# Emits one JSON row per open window for OmaCast's `win:` keyword.
#
#   win:            every window
#   win:chrome      by class or title
#
# Focus and close both go through the Lua dispatcher, not `dispatch
# focuswindow` or `dispatch closewindow`: under a Lua config the old string
# form returns ok and does nothing.

set -uo pipefail

query="${1:-}"

hyprctl clients -j 2>/dev/null | jq -c --arg q "${query,,}" '
  [ .[]
    | select(.mapped and .workspace.id > 0)
    | { class: (.class // ""), title: (.title // ""), address: .address,
        workspace: (.workspace.name // (.workspace.id | tostring)) }
    | select($q == "" or ((.class + " " + .title) | ascii_downcase | contains($q)))
  ]
  | to_entries[]
  | .key as $i
  | .value
  | ("address:" + .address) as $target
  | ("hyprctl dispatch " +
     ("hl.dsp.focus({ window = \"" + $target + "\" })" | @sh)) as $focus
  | ("hyprctl dispatch " +
     ("hl.dsp.window.close({ window = \"" + $target + "\" })" | @sh)) as $close
  | {
      id: .address,
      title: (if .title == "" then .class else .title end),
      subtitle: (.class + "  ·  " + .workspace),
      exec: $focus,
      score: (90000 - ($i * 500)),
      actions: [
        { title: "Focus", shortcut: "↵", exec: $focus },
        { title: "Close Window", exec: $close }
      ]
    }'

#!/bin/bash
# GitHub, as far as a launcher can honestly go.
#
#   gh:                       your repos, most recently pushed first
#   gh:owner/repo             that repository, drawn as a repository
#   gh:owner/repo#123         that pull request, drawn as a pull request
#   gh:<a github url>         the same, from something you pasted
#   gh:some words             find a repository by name
#
#   pr:                       your open pull requests, and the ones waiting on you
#   pr:owner/repo             that repository's open pull requests
#   pr:owner/repo#123         one pull request: its checks, its review, its size
#   pr:123                    the one numbered 123, among yours
#
#   issue:                    assigned to you, and mentioning you
#   issue:owner/repo#123      open that issue
#
#   ci:owner/repo             recent workflow runs, failures first
#
# One binary, four names. `bo test` runs an extension's cases by calling the
# first word of `search` with the query as its single argument, so a script that
# dispatched on argv[1] could never be tested at all: `omacast-gh tokyo` read
# "tokyo" as a mode and exited. That is why `gh:` and `github:` were untested.
# The mode now comes from the environment and each keyword has its own name on
# PATH, so the cases beside each extension actually run the thing they name.
#
# ---------------------------------------------------------------- the network
#
# Everything here reaches GitHub, and a launcher that stalls on a keystroke is
# worse than one that answers a little less. Two rules, and they divide the
# whole file:
#
#   When the typed text already says something true, say it now. `gh:owner/repo`
#   is a URL before any request is made, so the row is drawn and pressable
#   immediately and the request is warmed in a detached process. The extension's
#   `refreshMs` re-asks a second later, the warmed answer is on disk by then,
#   and the rows are replaced under the selection with no spinner and no jump.
#
#   When it does not, wait. A bare `pr:` cannot be answered from the text at
#   all, and inventing a row for it is worse than the skeleton the launcher
#   already draws while an extension is slow.
#
# A stale cache entry is served while its replacement is fetched, so the second
# time you ask a question you never wait even once.
#
# ------------------------------------------------------------------ the cost
#
# Every answer here is one request. The three panels are single GraphQL
# documents rather than a REST call per fact, which is also what keeps a panel
# from being half-drawn: `gh api graphql` costs 1 point of 5000 an hour. The one
# query that costs two is `gh:` with three or more characters typed, which
# filters your own repos from cache and searches GitHub for the rest.
#
# ---------------------------------------------------------------- degradation
#
# Not signed in, no network, or a request that failed: never silence. A slug
# still draws its repository and still opens it, because a URL is knowable from
# the text. `!offline` at the front of a query forces that path, which is the
# only way a case can reach it: `bo test` calls this script with exactly one
# argument and cannot set an environment.

set -uo pipefail

MODE="${OMACAST_GH_MODE:-repo}"
query="${1:-}"

command -v gh >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
CACHE_DIR="$STATE/omacast-gh"
GH_TIMEOUT=8

BROWSER="omarchy-launch-browser"
TUI="omarchy-launch-tui --app-id=org.omarchy.git"

# ------------------------------------------------------------------ offline

# OFFLINE: make no requests. COLD: and read nothing that an earlier request
# left behind.
#
# The two are separate because they answer different questions. A real network
# failure should still serve you the repository you looked at ten minutes ago,
# which is OFFLINE alone. A case has to see the same answer on a machine that
# has never run this and on the one it was written on, which is both: a case
# that passes only because a cache file happens to be there is not a case.
OFFLINE=0
COLD=0
[[ -n ${OMACAST_GH_OFFLINE:-} ]] && OFFLINE=1
if [[ $query == "!offline" || $query == "!offline "* ]]; then
  OFFLINE=1
  COLD=1
  query="${query#!offline}"
  query="${query# }"
fi

# `gh auth token`, not `gh auth status`. status asks GitHub whether the token is
# still good, which is a network round trip, and putting one in front of every
# keystroke cost four seconds before a single row was drawn. token reads the
# keyring and answers instantly. A token that has been revoked since is caught
# where it should be, by the request that fails.
authed() {
  ((OFFLINE)) && return 1
  timeout 3 gh auth token >/dev/null 2>&1
}

# --------------------------------------------------------------------- cache
#
# Keyed by a fingerprint of the gh credentials, so a logout or a token swap can
# never serve somebody else's repositories. Anything written under another
# fingerprint is deleted rather than aged out.

auth_fingerprint() {
  local hosts="${GH_CONFIG_DIR:-$HOME/.config/gh}/hosts.yml" stamp=""
  [[ -f $hosts ]] && stamp=$(stat -c '%Y:%s' "$hosts" 2>/dev/null)
  printf '%s|%s|%s' "$stamp" "${GH_TOKEN:-}" "${GITHUB_TOKEN:-}" | md5sum | cut -c1-12
}

FP=$(auth_fingerprint)
mkdir -p "$CACHE_DIR" 2>/dev/null

for stale in "$CACHE_DIR"/*.json; do
  [[ -e $stale ]] || continue
  [[ ${stale##*/} == "$FP-"* ]] || rm -f -- "$stale" "$stale.lock"
done

key_for() { printf '%s' "$*" | md5sum | cut -c1-16; }
cache_file() { printf '%s/%s-%s.json' "$CACHE_DIR" "$FP" "$1"; }

fresh() {
  local file="$1" ttl="$2" age
  [[ -s $file ]] || return 1
  age=$(($(date +%s) - $(stat -c %Y "$file" 2>/dev/null || echo 0)))
  ((age >= 0 && age < ttl))
}

# A body worth keeping. A GraphQL NOT_FOUND is an answer and is cached; a
# timeout, an empty pipe or a torn response is not, and must not overwrite an
# older answer that still reads correctly.
usable() {
  [[ -n $1 ]] || return 1
  printf '%s' "$1" | jq -e . >/dev/null 2>&1
}

# Everything from the first line that starts a JSON document, and nothing
# before it.
#
# The launcher runs an extension through `bash -lc`, which is a login shell,
# which on this machine wakes mise, which announces itself on stdout the first
# time a shimmed binary is called: `mise ~/.config/mise/config.toml tools:
# gh@2.97.0`, one line, in front of an otherwise perfect answer. It cost every
# request made here until it was found, and nothing about it was gh's fault. A
# version manager, a shell greeting, a deprecation notice: none of them are
# worth a silent extension, and none of them start a line with a brace.
json_only() { sed -n '/^[[{]/,$p'; }

# Fetch in a process that outlives this one. The launcher kills the shell it
# started at timeoutMs and would take an ordinary background job with it, so the
# warm gets its own session. The lock is what stops `refreshMs` from firing a
# second request every second while the first is still out.
warm() {
  local file="$1"
  shift
  setsid --fork bash -c '
    file=$1; shift
    exec 9>"$file.lock" 2>/dev/null || exit 0
    flock -n 9 || exit 0
    out=$("$@" 2>/dev/null | sed -n "/^[[{]/,\$p")
    [[ -n $out ]] || exit 0
    printf "%s" "$out" | jq -e . >/dev/null 2>&1 || exit 0
    printf "%s" "$out" >"$file.new" && mv -f "$file.new" "$file"
  ' _ "$file" timeout "$GH_TIMEOUT" "$@" >/dev/null 2>&1 </dev/null
}

# When the last warm for this question started. Opening the lock for writing
# stamps it, so this is free.
#
# It is the backstop on the one runaway this design can have: `refreshMs` asks
# again every 900ms, and a request that keeps failing is never cached, so
# without this a panel left on screen against a broken network would fire a
# request a second for as long as somebody looked at it.
tried_recently() {
  local f="$1.lock" age
  [[ -e $f ]] || return 1
  age=$(($(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0)))
  ((age >= 0 && age < 5))
}

# The non-blocking read. Fresh is served, stale is served and replaced behind
# your back, and a cold miss draws nothing here so the caller can say whatever
# the typed text already told it.
peek() {
  local key="$1" ttl="$2" file
  shift 2
  ((COLD)) && return 1
  file=$(cache_file "$key")
  if fresh "$file" "$ttl"; then
    cat "$file"
    return 0
  fi
  ((OFFLINE)) && { [[ -s $file ]] && { cat "$file"; return 0; }; return 1; }
  tried_recently "$file" || warm "$file" "$@"
  [[ -s $file ]] && { cat "$file"; return 0; }
  return 1
}

# The blocking read, for the questions the text cannot answer at all. The
# extension's timeoutMs is the real ceiling and the launcher draws its skeleton
# over the wait, which is the whole reason that skeleton exists.
pull() {
  local key="$1" ttl="$2" file out
  shift 2
  ((COLD)) && return 1
  file=$(cache_file "$key")
  if fresh "$file" "$ttl"; then
    cat "$file"
    return 0
  fi
  ((OFFLINE)) && { [[ -s $file ]] && { cat "$file"; return 0; }; return 1; }

  out=$(timeout "$GH_TIMEOUT" "$@" 2>/dev/null | json_only)
  if usable "$out"; then
    printf '%s' "$out" >"$file.new" 2>/dev/null && mv -f "$file.new" "$file" 2>/dev/null
    printf '%s' "$out"
    return 0
  fi
  [[ -s $file ]] && { cat "$file"; return 0; }
  return 1
}

# ------------------------------------------------------------------ grammar
#
# The launcher hands over one string and it has to mean one thing. The rule is
# that a slug names a repository, a number after it names one thing inside it,
# and anything else is words to search with. A pasted URL is the same three
# facts with a hostname in front, so it is stripped down and read the same way.

T_SLUG=""; T_NUM=""; T_KIND=""; T_TEXT=""

parse_target() {
  local q="${1# }" rest owner name
  T_SLUG=""; T_NUM=""; T_KIND="text"; T_TEXT="$q"
  [[ -n $q ]] || { T_KIND="empty"; T_TEXT=""; return; }

  # A URL is a slug wearing a hostname.
  q="${q#<}"; q="${q%>}"
  q="${q#http://}"; q="${q#https://}"
  q="${q#www.}"
  if [[ $q == github.com/* ]]; then
    q="${q#github.com/}"
    q="${q%%\?*}"
    q="${q%%#*}"
  fi
  q="${q%%/}"

  # owner/name, and whatever came after it.
  [[ $q == */* ]] || return
  owner="${q%%/*}"
  rest="${q#*/}"
  name="${rest%%[/ #]*}"
  name="${name%.git}"
  [[ -n $owner && -n $name ]] || return
  [[ $owner =~ ^[A-Za-z0-9._-]+$ && $name =~ ^[A-Za-z0-9._-]+$ ]] || return

  T_SLUG="$owner/$name"
  T_KIND="repo"
  rest="${rest#"$name"}"
  rest="${rest#.git}"

  case "$rest" in
    /pull/*|/pulls/*)   T_NUM="${rest##*/}"; T_KIND="pr" ;;
    /issues/*)          T_NUM="${rest##*/}"; T_KIND="issue" ;;
    "#"*)               T_NUM="${rest#\#}"; T_NUM="${T_NUM%% *}"; T_KIND="number" ;;
    " "*)
      local word="${rest# }"
      word="${word%% *}"
      if [[ $word == \#* ]]; then
        T_NUM="${word#\#}"; T_KIND="number"
      elif [[ $word =~ ^[0-9]+$ ]]; then
        T_NUM="$word"; T_KIND="number"
      fi
      T_TEXT="${rest# }"
      [[ -n $T_NUM ]] && T_TEXT=""
      return
      ;;
  esac

  T_NUM="${T_NUM%%[!0-9]*}"
  [[ $T_NUM =~ ^[0-9]+$ ]] || { T_NUM=""; [[ $T_KIND != repo ]] && T_KIND="repo"; }
  T_TEXT=""
}

# ----------------------------------------------------------------- jq shared

JQ='
def ago($iso; $now):
  ($iso | if . == null or . == "" then null else (fromdateiso8601? // null) end) as $t
  | if $t == null then "" else
      (($now - $t) | floor) as $d
      | if $d < 60 then "now"
        elif $d < 3600 then "\(($d / 60) | floor)m"
        elif $d < 86400 then "\(($d / 3600) | floor)h"
        elif $d < 2592000 then "\(($d / 86400) | floor)d"
        elif $d < 31536000 then "\(($d / 2592000) | floor)mo"
        else "\(($d / 31536000) | floor)y" end
    end;

def mark:
  (. // "" | ascii_upcase) as $s
  | if $s == "SUCCESS" then "✓"
    elif $s == "FAILURE" or $s == "ERROR" or $s == "TIMED_OUT" or $s == "STARTUP_FAILURE" or $s == "ACTION_REQUIRED" then "✗"
    elif $s == "CANCELLED" or $s == "STALE" then "⊘"
    elif $s == "NEUTRAL" or $s == "SKIPPED" then "–"
    elif $s == "" or $s == "NULL" then ""
    else "●" end;

def revword:
  (. // "") as $d
  | if $d == "APPROVED" then "approved"
    elif $d == "CHANGES_REQUESTED" then "changes requested"
    elif $d == "REVIEW_REQUIRED" then "review needed"
    else "" end;

def prstate: (.commits.nodes[0].commit.statusCheckRollup.state // "");

def openurl($u): "'"$BROWSER"' " + ($u | @sh);
def copyurl($u): "printf %s " + ($u | @sh) + " | wl-copy";
'

NOW=$(date +%s)

emit() { jq -c --argjson now "$NOW" "$@" 2>/dev/null; }

# One row, written in bash, for the things that have no JSON behind them.
row() {
  jq -nc --arg title "$1" --arg subtitle "$2" --arg detail "$3" \
    --arg exec "$4" --arg id "$5" --argjson score "${6:-90000}" \
    '{ id: $id, title: $title, subtitle: $subtitle, detail: $detail,
       exec: $exec, score: $score }'
}

# Two different failures, and telling them apart matters: one is fixed by
# logging in and the other by waiting. `gh auth token` reads the keyring and
# never leaves the machine, so it separates them without a request.
signin_row() {
  if ((OFFLINE == 0)) && timeout 3 gh auth token >/dev/null 2>&1; then
    row "GitHub is not answering" "signed in, no reply" \
      "the network, or GitHub itself" "" "gh-unreachable" 99000
  else
    row "Not signed in to GitHub" "gh auth login" \
      "everything under gh: needs an account" \
      "$TUI gh auth login" "gh-signin" 99000
  fi
}

# ---------------------------------------------------------------- graphql

GQL_REPO='
query($owner:String!, $name:String!) {
  repository(owner:$owner, name:$name) {
    nameWithOwner description url isPrivate isArchived isFork
    stargazerCount forkCount pushedAt
    primaryLanguage { name }
    defaultBranchRef { name target { ... on Commit {
      abbreviatedOid messageHeadline committedDate statusCheckRollup { state } } } }
    pullRequests(states: OPEN) { totalCount }
    issues(states: OPEN) { totalCount }
    latestRelease { tagName publishedAt }
    openPrs: pullRequests(states: OPEN, first: 8, orderBy: {field: UPDATED_AT, direction: DESC}) {
      nodes { number title url isDraft updatedAt author { login } reviewDecision
        commits(last:1){ nodes { commit { statusCheckRollup { state } } } } } }
  }
}'

GQL_PR='
query($owner:String!, $name:String!, $number:Int!) {
  repository(owner:$owner, name:$name) {
    nameWithOwner
    issueOrPullRequest(number:$number) {
      __typename
      ... on Issue { number title url state createdAt updatedAt author { login }
        comments { totalCount } labels(first:8){ nodes { name } } }
      ... on PullRequest {
        number title url state isDraft createdAt updatedAt
        additions deletions changedFiles headRefName baseRefName mergeable
        author { login } reviewDecision comments { totalCount }
        reviews(last: 10) { nodes { state submittedAt author { login } } }
        commits(last: 1) { nodes { commit { statusCheckRollup {
          state contexts(first: 30) { nodes {
            __typename
            ... on CheckRun { name conclusion status startedAt completedAt detailsUrl }
            ... on StatusContext { context state targetUrl createdAt } } } } } } }
      }
    }
  }
}'

GQL_MINE='
query {
  mine: search(query: "is:pr is:open author:@me archived:false", type: ISSUE, first: 20) {
    nodes { ... on PullRequest {
      number title url isDraft updatedAt additions deletions changedFiles
      repository { nameWithOwner } headRefName reviewDecision author { login }
      commits(last:1){ nodes { commit { statusCheckRollup { state } } } } } } }
  review: search(query: "is:pr is:open review-requested:@me archived:false", type: ISSUE, first: 15) {
    nodes { ... on PullRequest {
      number title url isDraft updatedAt additions deletions changedFiles
      repository { nameWithOwner } headRefName reviewDecision author { login }
      commits(last:1){ nodes { commit { statusCheckRollup { state } } } } } } }
}'

GQL_REPO_PRS='
query($owner:String!, $name:String!) {
  repository(owner:$owner, name:$name) {
    nameWithOwner
    pullRequests(states: OPEN, first: 30, orderBy: {field: UPDATED_AT, direction: DESC}) {
      nodes { number title url isDraft updatedAt additions deletions changedFiles
        repository { nameWithOwner } headRefName reviewDecision author { login }
        commits(last:1){ nodes { commit { statusCheckRollup { state } } } } } }
  }
}'

GQL_REPO_ISSUES='
query($owner:String!, $name:String!) {
  repository(owner:$owner, name:$name) {
    nameWithOwner
    issues(states: OPEN, first: 30, orderBy: {field: UPDATED_AT, direction: DESC}) {
      nodes { number title url updatedAt repository { nameWithOwner }
        author { login } comments { totalCount } labels(first:5){ nodes { name } } } }
  }
}'

GQL_ISSUES='
query {
  assigned: search(query: "is:issue is:open assignee:@me archived:false", type: ISSUE, first: 20) {
    nodes { ... on Issue { number title url updatedAt repository { nameWithOwner }
      author { login } comments { totalCount } labels(first:5){ nodes { name } } } } }
  mentioned: search(query: "is:issue is:open mentions:@me archived:false", type: ISSUE, first: 15) {
    nodes { ... on Issue { number title url updatedAt repository { nameWithOwner }
      author { login } comments { totalCount } labels(first:5){ nodes { name } } } } }
}'

# There is no helper wrapping these calls. Both readers below run their command
# under `timeout`, which is a program and not a shell, and a program cannot call
# a shell function: the wrapper failed with "No such file or directory" and left
# every panel a skeleton that never filled in, which looks exactly like a slow
# network. So every call site names gh itself.

# --------------------------------------------------------------- renderers

# The rows a list of pull requests turns into, wherever they came from. The
# accessory is the whole point: a check mark and an age, which together are the
# answer to "is it green yet" without opening anything.
JQ_PR_ROWS='
  def prrow($group; $base):
    . as $p
    | ($p.repository.nameWithOwner // $slug) as $repo
    | ($p | prstate) as $st
    | {
        id: ("pr:" + $repo + "#" + ($p.number | tostring)),
        title: ((if $p.isDraft then "draft  " else "" end) + $p.title),
        detail: ([ $repo, ("#" + ($p.number | tostring)), ($p.author.login // ""),
                   ($p.headRefName // "") ]
                 | map(select(. != "")) | join("  ")),
        subtitle: ([ ($p.reviewDecision | revword),
                     (if ($p.changedFiles // 0) > 0
                      then "+\($p.additions) −\($p.deletions)  \($p.changedFiles) files" else "" end) ]
                   | map(select(. != "")) | join("   ")),
        accessory: ((($st | mark) + " " + ago($p.updatedAt; $now)) | ltrimstr(" ")),
        group: $group,
        exec: openurl($p.url),
        score: $base,
        actions: [
          { title: "Open in Browser", shortcut: "↵", exec: openurl($p.url) },
          { title: "This Pull Request", exec: "true",
            query: ("pr:" + $repo + "#" + ($p.number | tostring)) },
          { title: "Show Diff", exec: ("'"$TUI"' gh pr diff --repo " + ($repo | @sh) + " " + ($p.number | tostring)) },
          { title: "Check Out Locally", exec: ("'"$TUI"' gh pr checkout --repo " + ($repo | @sh) + " " + ($p.number | tostring)) },
          { title: "Copy URL", exec: copyurl($p.url) }
        ]
      };
'

# One pull request, drawn as one. A row that says "#111, 2h ago" is a title and
# a number; what you came for is which check is red, whether anyone has looked
# at it, and how big it is.
render_pr_panel() {
  local slug="$1"
  emit --arg slug "$slug" "$JQ$JQ_PR_ROWS"'
    (.data.repository.issueOrPullRequest // null) as $t
    | if $t == null then
        { id: ("gh:" + $slug), title: ($slug + " has no such number"),
          subtitle: "not found, or no access", score: 90000,
          exec: openurl("https://github.com/" + $slug) }
      elif $t.__typename == "Issue" then
        { id: ("issue:" + $slug + "#" + ($t.number | tostring)),
          title: $t.title,
          subtitle: ([ ($t.labels.nodes // [])[].name ] | join(", ")),
          detail: ($slug + "  #" + ($t.number | tostring) + "  " + ($t.author.login // "")),
          accessory: ((if ($t.comments.totalCount // 0) > 0 then "\($t.comments.totalCount) 󰆉  " else "" end)
                      + ago($t.updatedAt; $now)),
          group: "Issue",
          exec: openurl($t.url),
          score: 90000,
          actions: [ { title: "Open in Browser", shortcut: "↵", exec: openurl($t.url) },
                     { title: "Copy URL", exec: copyurl($t.url) } ] }
      else
        ($t.commits.nodes[0].commit.statusCheckRollup // null) as $roll
        | [ ($roll.contexts.nodes // [])[]
            | if .__typename == "CheckRun"
              then { name: .name,
                     state: (.conclusion // .status // ""),
                     url: (.detailsUrl // ""),
                     took: (if .completedAt != null and .startedAt != null
                            then (((.completedAt | fromdateiso8601?) // 0) - ((.startedAt | fromdateiso8601?) // 0))
                            else 0 end) }
              else { name: .context, state: (.state // ""), url: (.targetUrl // ""), took: 0 } end
            | . + { mark: (.state | mark) } ] as $checks
        | [ $checks[] | select(.mark == "✗") ] as $bad
        | [ $checks[] | select(.mark == "●") ] as $running
        | ($checks | sort_by(if .mark == "✗" then 0 elif .mark == "●" then 1 else 2 end)) as $checks
        | {
            id: ("pr:" + $slug + "#" + ($t.number | tostring)),
            view: "ghpr",
            title: $t.title,
            subtitle: ($slug + " #" + ($t.number | tostring)),
            exec: openurl($t.url),
            score: 90000,
            pr: {
              repo: $slug,
              number: $t.number,
              title: $t.title,
              author: ($t.author.login // ""),
              head: ($t.headRefName // ""),
              base: ($t.baseRefName // ""),
              draft: ($t.isDraft == true),
              state: ($t.state // ""),
              mergeable: ($t.mergeable // ""),
              review: ($t.reviewDecision | revword),
              additions: ($t.additions // 0),
              deletions: ($t.deletions // 0),
              files: ($t.changedFiles // 0),
              comments: ($t.comments.totalCount // 0),
              age: ago($t.updatedAt; $now),
              opened: ago($t.createdAt; $now),
              rollup: ($roll.state // ""),
              mark: (($roll.state // "") | mark),
              failing: ($bad | length),
              running: ($running | length),
              total: ($checks | length),
              url: $t.url
            },
            checks: [ $checks[] | { name: .name, mark: .mark, state: (.state | ascii_downcase),
                                    took: (if .took > 0 then (if .took < 60 then "\(.took | floor)s" else "\((.took / 60) | floor)m" end) else "" end) } ],
            reviews: [ ($t.reviews.nodes // [])[]
                       | { who: (.author.login // ""), state: (.state // ""),
                           mark: (if .state == "APPROVED" then "✓"
                                  elif .state == "CHANGES_REQUESTED" then "✗" else "" end),
                           age: ago(.submittedAt; $now) }
                       | select(.who != "") ],
            actions: [
              { title: "Open in Browser", shortcut: "↵", exec: openurl($t.url) },
              { title: "Show Diff", exec: ("'"$TUI"' gh pr diff --repo " + ($slug | @sh) + " " + ($t.number | tostring)) },
              { title: "Watch Checks", exec: ("'"$TUI"' gh pr checks --repo " + ($slug | @sh) + " " + ($t.number | tostring) + " --watch") },
              { title: "Check Out Locally", exec: ("'"$TUI"' gh pr checkout --repo " + ($slug | @sh) + " " + ($t.number | tostring)) },
              { title: "Workflow Runs", exec: "true", query: ("ci:" + $slug) },
              { title: "Copy URL", exec: copyurl($t.url) }
            ]
          }
      end'
}

# The same panel with everything the network would have filled in left out. It
# is drawn from the slug and the number alone, which is enough to open it.
pr_skeleton() {
  local slug="$1" num="$2"
  jq -nc --arg slug "$slug" --argjson num "$num" --arg br "$BROWSER" '
    ("https://github.com/" + $slug + "/pull/" + ($num | tostring)) as $url
    | { id: ("pr:" + $slug + "#" + ($num | tostring)),
        view: "ghpr",
        title: ("#" + ($num | tostring)),
        subtitle: ($slug + " #" + ($num | tostring)),
        exec: ($br + " " + ($url | @sh)),
        score: 90000,
        waiting: true,
        pr: { repo: $slug, number: $num, title: "", url: $url },
        checks: [], reviews: [],
        actions: [ { title: "Open in Browser", shortcut: "↵", exec: ($br + " " + ($url | @sh)) },
                   { title: "Copy URL", exec: ("printf %s " + ($url | @sh) + " | wl-copy") } ] }'
}

# One repository. The counts and the default branch's check state are what you
# would otherwise open three tabs to learn, and the open pull requests under
# them are what makes it a picture of the repository rather than a badge.
render_repo_panel() {
  local slug="$1"
  emit --arg slug "$slug" "$JQ"'
    (.data.repository // null) as $r
    | if $r == null then
        { id: ("gh:" + $slug), title: $slug, subtitle: "not found, or no access",
          detail: "a private repository needs the repo scope", score: 90000,
          exec: openurl("https://github.com/" + $slug) }
      else
        ($r.defaultBranchRef // {}) as $br
        | ($br.target // {}) as $head
        | {
            id: ("gh:" + $r.nameWithOwner),
            view: "ghrepo",
            title: $r.nameWithOwner,
            subtitle: ($r.description // ""),
            exec: openurl($r.url),
            score: 90000,
            repo: {
              slug: $r.nameWithOwner,
              description: ($r.description // ""),
              language: ($r.primaryLanguage.name // ""),
              stars: ($r.stargazerCount // 0),
              forks: ($r.forkCount // 0),
              private: ($r.isPrivate == true),
              archived: ($r.isArchived == true),
              fork: ($r.isFork == true),
              branch: ($br.name // ""),
              headline: ($head.messageHeadline // ""),
              headHash: ($head.abbreviatedOid // ""),
              headAge: ago($head.committedDate; $now),
              headMark: (($head.statusCheckRollup.state // "") | mark),
              prs: ($r.pullRequests.totalCount // 0),
              issues: ($r.issues.totalCount // 0),
              release: ($r.latestRelease.tagName // ""),
              releaseAge: ago($r.latestRelease.publishedAt; $now),
              pushed: ago($r.pushedAt; $now),
              url: $r.url
            },
            prs: [ ($r.openPrs.nodes // [])[]
                   | { number: .number,
                       title: .title,
                       author: (.author.login // ""),
                       draft: (.isDraft == true),
                       mark: ((. | prstate) | mark),
                       review: (.reviewDecision | revword),
                       age: ago(.updatedAt; $now) } ],
            actions: [
              { title: "Open in Browser", shortcut: "↵", exec: openurl($r.url) },
              { title: "Pull Requests", exec: "true", query: ("pr:" + $r.nameWithOwner) },
              { title: "Workflow Runs", exec: "true", query: ("ci:" + $r.nameWithOwner) },
              { title: "Issues", exec: openurl($r.url + "/issues") },
              { title: "Clone", exec: ("'"$TUI"' gh repo clone " + ($r.nameWithOwner | @sh)) },
              { title: "Copy URL", exec: copyurl($r.url) }
            ]
          }
      end'
}

repo_skeleton() {
  local slug="$1"
  jq -nc --arg slug "$slug" --arg br "$BROWSER" --arg tui "$TUI" '
    ("https://github.com/" + $slug) as $url
    | { id: ("gh:" + $slug),
        view: "ghrepo",
        title: $slug,
        subtitle: "",
        exec: ($br + " " + ($url | @sh)),
        score: 90000,
        waiting: true,
        repo: { slug: $slug, url: $url, description: "" },
        prs: [],
        actions: [ { title: "Open in Browser", shortcut: "↵", exec: ($br + " " + ($url | @sh)) },
                   { title: "Pull Requests", exec: "true", query: ("pr:" + $slug) },
                   { title: "Clone", exec: ($tui + " gh repo clone " + ($slug | @sh)) },
                   { title: "Copy URL", exec: ("printf %s " + ($url | @sh) + " | wl-copy") } ] }'
}

# --------------------------------------------------------------------- modes

mode_repo() {
  parse_target "$query"

  case "$T_KIND" in
    pr|issue|number)
      local body
      if body=$(peek "pr-$(key_for "$T_SLUG#$T_NUM")" 30 \
        gh api graphql -f "query=$GQL_PR" -F owner="${T_SLUG%%/*}" -F name="${T_SLUG##*/}" -F number="$T_NUM"); then
        printf '%s' "$body" | render_pr_panel "$T_SLUG"
      else
        pr_skeleton "$T_SLUG" "$T_NUM"
      fi
      return
      ;;

    repo)
      local body
      if body=$(peek "repo-$(key_for "$T_SLUG")" 60 \
        gh api graphql -f "query=$GQL_REPO" -F owner="${T_SLUG%%/*}" -F name="${T_SLUG##*/}"); then
        printf '%s' "$body" | render_repo_panel "$T_SLUG"
      else
        repo_skeleton "$T_SLUG"
      fi
      return
      ;;
  esac

  # No slug: your own repositories, filtered here rather than at GitHub, and a
  # search of the rest of GitHub once there are enough characters to mean
  # something. Your own list is the one that answers instantly and it is also
  # the one you want first.
  authed || { signin_row; return; }

  local own
  own=$(pull "own-repos" 120 gh repo list --limit 100 \
    --json nameWithOwner,description,primaryLanguage,stargazerCount,pushedAt,isPrivate,isArchived,url) || own=""
  [[ -n $own ]] || own="[]"

  printf '%s' "$own" | emit --arg q "${T_TEXT,,}" "$JQ"'
    [ .[] | select($q == "" or ((.nameWithOwner + " " + (.description // "")) | ascii_downcase | contains($q))) ]
    | sort_by(.pushedAt) | reverse | .[:12]
    | to_entries[] | .key as $i | .value
    | {
        id: ("own:" + .nameWithOwner),
        title: .nameWithOwner,
        detail: (.description // ""),
        subtitle: ([ (.primaryLanguage.name // ""), (if .isPrivate then "private" else "" end),
                     (if .isArchived then "archived" else "" end) ]
                   | map(select(. != "")) | join("  ")),
        accessory: ("★ " + (.stargazerCount | tostring) + "  " + ago(.pushedAt; $now)),
        group: "Your Repos",
        exec: openurl(.url),
        score: (90000 - ($i * 100)),
        actions: [
          { title: "Open in Browser", shortcut: "↵", exec: openurl(.url) },
          { title: "This Repository", exec: "true", query: ("gh:" + .nameWithOwner) },
          { title: "Pull Requests", exec: "true", query: ("pr:" + .nameWithOwner) },
          { title: "Clone", exec: ("'"$TUI"' gh repo clone " + (.nameWithOwner | @sh)) },
          { title: "Copy URL", exec: copyurl(.url) }
        ]
      }'

  # Three characters. Below that a search term is not a search term, and every
  # keystroke under it is answered from the list above for no request at all.
  ((${#T_TEXT} >= 3)) || return

  local seen found
  seen=$(printf '%s' "$own" | jq -c '[.[].nameWithOwner]' 2>/dev/null) || seen="[]"
  found=$(peek "search-$(key_for "$T_TEXT")" 300 gh search repos "$T_TEXT" --limit 12 \
    --json fullName,description,language,stargazersCount,updatedAt,url) || return

  printf '%s' "$found" | emit --argjson seen "$seen" "$JQ"'
    [ .[] | select(.fullName as $n | ($seen | index($n)) == null) ] | .[:6]
    | to_entries[] | .key as $i | .value
    | {
        id: ("found:" + .fullName),
        title: .fullName,
        detail: (.description // ""),
        subtitle: (.language // ""),
        accessory: ("★ " + (.stargazersCount | tostring) + "  " + ago(.updatedAt; $now)),
        group: "On GitHub",
        exec: openurl(.url),
        score: (80000 - ($i * 100)),
        actions: [
          { title: "Open in Browser", shortcut: "↵", exec: openurl(.url) },
          { title: "This Repository", exec: "true", query: ("gh:" + .fullName) },
          { title: "Clone", exec: ("'"$TUI"' gh repo clone " + (.fullName | @sh)) },
          { title: "Copy URL", exec: copyurl(.url) }
        ]
      }'
}

mode_prs() {
  parse_target "$query"

  # A number with a repository in front of it is one pull request.
  if [[ $T_KIND == pr || $T_KIND == number || $T_KIND == issue ]]; then
    local body
    if body=$(peek "pr-$(key_for "$T_SLUG#$T_NUM")" 30 \
      gh api graphql -f "query=$GQL_PR" -F owner="${T_SLUG%%/*}" -F name="${T_SLUG##*/}" -F number="$T_NUM"); then
      printf '%s' "$body" | render_pr_panel "$T_SLUG"
    else
      pr_skeleton "$T_SLUG" "$T_NUM"
    fi
    return
  fi

  authed || { signin_row; return; }

  if [[ $T_KIND == repo ]]; then
    local body
    body=$(pull "repoprs-$(key_for "$T_SLUG")" 45 \
      gh api graphql -f "query=$GQL_REPO_PRS" -F owner="${T_SLUG%%/*}" -F name="${T_SLUG##*/}") || return
    printf '%s' "$body" | emit --arg slug "$T_SLUG" --arg q "${T_TEXT,,}" "$JQ$JQ_PR_ROWS"'
      def keep: select($q == ""
        or (((.title // "") + " " + (.author.login // "") + " " + (.headRefName // "")
             + " #" + (.number | tostring)) | ascii_downcase | contains($q)));
      [ (.data.repository.pullRequests.nodes // [])[] | keep ] | .[:14]
      | to_entries[] | .key as $i | .value
      | prrow("Open Pull Requests  " + $slug; 90000 - ($i * 100))'
    return
  fi

  # A bare number, or words. Neither names a repository, and the launcher has no
  # working directory to guess one from, so the only repositories it can
  # honestly mean are the ones already in your own list.
  local body out filter="${T_TEXT,,}"
  body=$(pull "mine-prs" 45 gh api graphql -f "query=$GQL_MINE") || return

  out=$(printf '%s' "$body" | emit --arg q "$filter" --arg slug "" "$JQ$JQ_PR_ROWS"'
    def keep: select($q == ""
      or (((.title // "") + " " + (.repository.nameWithOwner // "") + " "
           + (.author.login // "") + " " + (.headRefName // "") + " #" + (.number | tostring))
          | ascii_downcase | contains($q)));

    [ (.data.review.nodes // [])[] | keep ] as $review
    | [ (.data.mine.nodes // [])[] | keep ] as $mine
    | ([ $review[] | . + { g: "Waiting On You", b: 95000 } ]
       + [ $mine[] | . + { g: "Your Pull Requests", b: 90000 } ])
    | to_entries[] | .key as $i | .value
    | prrow(.g; .b - ($i * 100))')

  # An empty inbox is an answer, and a good one. The launcher's own "Nothing
  # matches" is not: it reads as a search that failed rather than as a day with
  # nothing on it.
  if [[ -z $out && -z $filter ]]; then
    row "Nothing open, nothing waiting" "no pull requests of yours, none for you to review" \
      "" "" "pr-empty" 90000
    return
  fi
  printf '%s\n' "$out"
}

mode_issues() {
  parse_target "$query"

  # A repository and a number is a URL. GitHub sends /issues/N to the pull
  # request when it turns out to be one, so this is right without asking.
  if [[ -n $T_NUM ]]; then
    jq -nc --arg slug "$T_SLUG" --argjson num "$T_NUM" --arg br "$BROWSER" '
      ("https://github.com/" + $slug + "/issues/" + ($num | tostring)) as $url
      | { id: ("issue:" + $slug + "#" + ($num | tostring)),
          title: ($slug + " #" + ($num | tostring)),
          subtitle: "open on GitHub",
          exec: ($br + " " + ($url | @sh)),
          score: 90000,
          actions: [ { title: "Open in Browser", shortcut: "↵", exec: ($br + " " + ($url | @sh)) },
                     { title: "Copy URL", exec: ("printf %s " + ($url | @sh) + " | wl-copy") } ] }'
    return
  fi

  authed || { signin_row; return; }

  # A repository and no number is that repository's issues. It used to fall
  # through to your own inbox and filter it by nothing, so `issue:basecamp/omarchy`
  # answered "nothing assigned to you" about a repo holding 455 open issues.
  if [[ $T_KIND == repo ]]; then
    local rbody
    if [[ -n $T_TEXT ]]; then
      # A word after the repository is a search of that repository, not a filter
      # over the thirty most recent. The window is what the graphql query
      # fetches, so `basecamp/omarchy clipboard` found nothing on a repo with
      # four open clipboard issues, none of which were in the newest thirty.
      # GitHub's own search reaches all of them and is one call either way.
      rbody=$(pull "repoissuesearch-$(key_for "$T_SLUG $T_TEXT")" 45 \
        gh search issues --repo "$T_SLUG" --state open --limit 30 \
          --json number,title,url,updatedAt,repository,author,labels,commentsCount \
          -- "$T_TEXT") || return

      # `gh search` returns a flat array where the graphql returns it nested,
      # and calls the comment count something else. Reshaped here so one jq
      # filter serves both paths rather than two that must be kept in step.
      rbody=$(printf '%s' "$rbody" | jq -c --arg slug "$T_SLUG" '
        { data: { repository: { nameWithOwner: $slug, issues: { nodes:
          [ .[] | { number, title, url, updatedAt,
                    repository: { nameWithOwner: $slug },
                    author: { login: (.author.login // "") },
                    comments: { totalCount: (.commentsCount // 0) },
                    labels: { nodes: [ (.labels // [])[] | { name } ] } } ] } } } }' 2>/dev/null) || return
    else
      rbody=$(pull "repoissues-$(key_for "$T_SLUG")" 45 \
        gh api graphql -f "query=$GQL_REPO_ISSUES" -F owner="${T_SLUG%%/*}" -F name="${T_SLUG##*/}") || return
    fi
    printf '%s' "$rbody" | emit --arg slug "$T_SLUG" --arg q "${T_TEXT,,}" "$JQ"'
      def keep: select($q == ""
        or (((.title // "") + " " + (.author.login // "")
             + " " + ([ (.labels.nodes // [])[].name ] | join(" "))
             + " #" + (.number | tostring)) | ascii_downcase | contains($q)));
      [ (.data.repository.issues.nodes // [])[] | keep ] | .[:14]
      | to_entries[] | .key as $i | .value
      | { id: ("issue:" + $slug + "#" + (.number | tostring)),
          title: .title,
          detail: ($slug + "  #" + (.number | tostring) + "  " + (.author.login // "")),
          subtitle: ([ (.labels.nodes // [])[].name ] | join(", ")),
          accessory: ((if (.comments.totalCount // 0) > 0 then "\(.comments.totalCount)󰆉  " else "" end)
                      + ago(.updatedAt; $now)),
          group: ("Open Issues  " + $slug),
          exec: openurl(.url),
          score: (90000 - ($i * 100)),
          actions: [
            { title: "Open in Browser", shortcut: "↵", exec: openurl(.url) },
            { title: "This Repository", exec: "true", query: ("gh:" + $slug) },
            { title: "Copy URL", exec: copyurl(.url) }
          ] }'
    return
  fi

  local body out
  body=$(pull "my-issues" 60 gh api graphql -f "query=$GQL_ISSUES") || return

  out=$(printf '%s' "$body" | emit --arg q "${T_TEXT,,}" "$JQ"'
    def keep: select($q == ""
      or (((.title // "") + " " + (.repository.nameWithOwner // "")
           + " #" + (.number | tostring)) | ascii_downcase | contains($q)));

    def issuerow($group; $base):
      ((.repository.nameWithOwner // "")) as $repo
      | { id: ("issue:" + $repo + "#" + (.number | tostring)),
          title: .title,
          detail: ($repo + "  #" + (.number | tostring) + "  " + (.author.login // "")),
          subtitle: ([ (.labels.nodes // [])[].name ] | join(", ")),
          accessory: ((if (.comments.totalCount // 0) > 0 then "\(.comments.totalCount)󰆉  " else "" end)
                      + ago(.updatedAt; $now)),
          group: $group,
          exec: openurl(.url),
          score: $base,
          actions: [
            { title: "Open in Browser", shortcut: "↵", exec: openurl(.url) },
            { title: "This Repository", exec: "true", query: ("gh:" + $repo) },
            { title: "Copy URL", exec: copyurl(.url) }
          ] };

    ([ (.data.assigned.nodes // [])[] | keep | . + { g: "Assigned To You", b: 95000 } ]
     + [ (.data.mentioned.nodes // [])[] | keep | . + { g: "Mentioning You", b: 88000 } ])
    | unique_by(.url)
    | to_entries[] | .key as $i | .value
    | issuerow(.g; .b - ($i * 100))')

  if [[ -z $out && -z ${T_TEXT} ]]; then
    row "Nothing assigned, nothing mentioning you" "an empty inbox is an answer" \
      "" "" "issue-empty" 90000
    return
  fi
  printf '%s\n' "$out"
}

mode_runs() {
  parse_target "$query"

  if [[ -z $T_SLUG ]]; then
    row "Name a repository" "ci:owner/repo" \
      "workflow runs belong to a repository" "" "ci-hint" 90000
    return
  fi

  authed || { signin_row; return; }

  local body
  body=$(pull "runs-$(key_for "$T_SLUG")" 30 gh run list --repo "$T_SLUG" --limit 20 \
    --json databaseId,displayTitle,workflowName,status,conclusion,headBranch,event,createdAt,url) || return

  printf '%s' "$body" | emit --arg slug "$T_SLUG" "$JQ"'
    [ .[] ] | .[:14]
    | to_entries[] | .key as $i | .value
    | (if .status != "completed" then "●" else (.conclusion | mark) end) as $m
    | {
        id: ("run:" + $slug + ":" + (.databaseId | tostring)),
        title: .displayTitle,
        detail: (.workflowName + "  " + .headBranch + "  " + .event),
        subtitle: (if (.conclusion // "") == "" then .status else .conclusion end),
        accessory: (($m + " " + ago(.createdAt; $now)) | ltrimstr(" ")),
        group: ("Workflow Runs  " + $slug),
        exec: openurl(.url),
        # Failures first: a list of twenty greens with one red in the middle is
        # a list you have to read, and the red one is the only reason you asked.
        score: ((if $m == "✗" then 95000 elif $m == "●" then 92000 else 90000 end) - ($i * 100)),
        actions: [
          { title: "Open in Browser", shortcut: "↵", exec: openurl(.url) },
          { title: "Failed Logs", exec: ("'"$TUI"' gh run view --repo " + ($slug | @sh) + " " + (.databaseId | tostring) + " --log-failed") },
          { title: "Watch", exec: ("'"$TUI"' gh run watch --repo " + ($slug | @sh) + " " + (.databaseId | tostring)) },
          { title: "This Repository", exec: "true", query: ("gh:" + $slug) },
          { title: "Copy URL", exec: copyurl(.url) }
        ]
      }'
}

case "$MODE" in
  repo)   mode_repo ;;
  prs)    mode_prs ;;
  issues) mode_issues ;;
  runs)   mode_runs ;;
esac

exit 0

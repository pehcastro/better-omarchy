#!/bin/bash
# Emits JSON rows for OmaCast's `alarm:` keyword: a reminder set in the
# words people actually say.
#
#   alarm:30 minutes and 45 seconds tea is ready
#   alarm:1h30m
#   alarm:5m
#   alarm:in 2 hours call mum
#   alarm:half an hour tea       a fraction, said out loud
#   alarm:                       what is already pending, and how long is left
#
# The reminders themselves are Omarchy's: `omarchy reminder <minutes> <message>`
# arms a transient systemd user timer that sends the notification. This script
# only reads the words and hands over, so a reminder set here is the same object
# as one set from the bar, cancels the same way, and survives this launcher.
#
# `omarchy reminder` takes whole minutes and nothing finer. A duration that
# does not divide is rounded up rather than down, because an alarm that fires
# early is a broken alarm, and the row says what it rounded to: setting a
# different time from the one that was typed without mentioning it is worse
# than refusing.
#
# A time with no words after it is refused rather than set. `omarchy reminder 25`
# on its own stores "25-min reminder", which is a notification that arrives and
# tells you nothing: by the time it fires, the one thing you needed it to carry
# is the one thing it did not.
#
# One instruction, spelled with a leading `--`, for the rows to call back into:
#
#   omacast-alarm --cancel UNIT   stop one pending reminder
#
# The launcher passes a query as a single shell-quoted argument, so a typed
# `alarm:--cancel x` arrives as one word and is parsed as a duration, not obeyed.

set -uo pipefail

reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-reminders"

# Stopping the timer is the whole cancel as far as the notification goes, but
# `omarchy reminder` only removes the message file when the reminder actually
# fires. Cancelling without this left one behind under $XDG_RUNTIME_DIR for
# every reminder anybody ever changed their mind about.
if (($# >= 2)) && [[ $1 == --cancel ]]; then
  unit="$2"
  # A unit name, not a path. The name goes straight into an `rm` under
  # $XDG_RUNTIME_DIR, and a `/` in it would let that `rm` point anywhere.
  [[ $unit == omarchy-reminder-* && $unit != */* ]] || exit 0
  systemctl --user stop "${unit%.timer}.timer" >/dev/null 2>&1
  rm -f -- "$reminder_dir/${unit%.timer}.message" 2>/dev/null
  omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1
  exit 0
fi

query="${1:-}"

# ---- duration vocabulary

unit_seconds() {
  case "${1,,}" in
  d | day | days) printf '86400' ;;
  h | hr | hrs | hour | hours) printf '3600' ;;
  m | min | mins | minute | minutes) printf '60' ;;
  s | sec | secs | second | seconds) printf '1' ;;
  *) return 1 ;;
  esac
}

# One word holding its own units: 1h30m, 90s, 5m. Longest unit spellings come
# first in the alternation so "5minutes" is not read as 5 followed by "inutes".
compact_seconds() {
  local rest="${1,,}" total=0 num unit step
  [[ $rest =~ ^[0-9] ]] || return 1
  while [[ $rest =~ ^([0-9]+)(days?|d|hours?|hrs?|h|minutes?|mins?|m|seconds?|secs?|s)(.*)$ ]]; do
    num=${BASH_REMATCH[1]}
    unit=${BASH_REMATCH[2]}
    rest=${BASH_REMATCH[3]}
    step=$(unit_seconds "$unit") || return 1
    total=$((total + num * step))
  done
  [[ -n $rest ]] && return 1
  ((total > 0)) || return 1
  printf '%s' "$total"
}

# Whether a word opens another chunk of duration. This is what decides that the
# "and" in "30 minutes and 45 seconds" is part of the time, while the "and" in
# "5m and call mum" is part of the message.
starts_duration() {
  local word="${1:-}"
  [[ -z $word ]] && return 1
  case "${word,,}" in
  a | an | half | quarter) return 0 ;;
  esac
  [[ ${word,,} =~ ^[0-9]+$ ]] && return 0
  compact_seconds "$word" >/dev/null && return 0
  return 1
}

format_span() {
  local secs="$1" hours mins rest out=""
  hours=$((secs / 3600))
  mins=$((secs % 3600 / 60))
  rest=$((secs % 60))
  ((hours > 0)) && out+="${hours}h "
  ((mins > 0)) && out+="${mins}m "
  ((rest > 0)) && out+="${rest}s"
  printf '%s' "${out% }"
}

# The rounded time, said back the way it was asked for. "1 hour and 30 minutes"
# rather than "90 minutes", because the row is a confirmation and a confirmation
# in different words than the question is one more thing to check.
say_duration() {
  local mins="$1" hours out=""
  hours=$((mins / 60))
  mins=$((mins % 60))

  ((hours == 1)) && out="1 hour"
  ((hours > 1)) && out="$hours hours"

  if ((mins > 0)); then
    [[ -n $out ]] && out+=" and "
    ((mins == 1)) && out+="1 minute"
    ((mins > 1)) && out+="$mins minutes"
  fi

  printf '%s' "$out"
}

# ---- pending reminders

# `reminder show --json` already knows the remaining time and the wall clock,
# so this reformats rather than recomputes. Enter on a row cancels that one
# reminder: `reminder clear` drops all of them, which is a different question
# and gets its own row only when there is more than one to drop.
#
# Nothing pending prints nothing. A placeholder row saying "no reminders" is an
# alarm-shaped thing with no alarm in it, and the launcher already draws a
# proper "Nothing in Reminder" under an empty answer.
list_pending() {
  local json
  json=$(omarchy reminder show --json 2>/dev/null) || return 0
  [[ -z $json ]] && return 0

  printf '%s' "$json" | jq -c '
    if (.count // 0) == 0 then empty
    else
      ( .reminders
        | to_entries[]
        | { id: .value.unit,
            title: .value.label,
            subtitle: (.value.remaining + " left"),
            detail: ("fires at " + .value.atTime),
            accessory: "Cancel",
            glyph: "󰢌",
            exec: ("omacast-alarm --cancel " + (.value.unit | @sh)),
            score: (90000 - .key),
            view: "list" } ),
      ( if (.count // 0) > 1 then
          { id: "alarm-clear", title: "Cancel every reminder",
            subtitle: ((.count | tostring) + " pending"),
            exec: "omarchy reminder clear", score: 10000, view: "list" }
        else empty end )
    end'
}

if [[ -z $query ]]; then
  list_pending
  exit 0
fi

# ---- read the duration off the front, keep the rest as the message

words=()
read -r -a words <<<"$query"
count=${#words[@]}
total=0
index=0

# "in 20 minutes" and "for 20 minutes" are how it gets said out loud, and
# neither word is part of the time.
while ((index < count)); do
  case "${words[index],,}" in
  in | for) index=$((index + 1)) ;;
  *) break ;;
  esac
done

while ((index < count)); do
  word=${words[index],,}
  next=${words[index + 1]:-}
  step=""

  # "an hour", "a minute".
  if [[ $word == a || $word == an ]]; then
    if step=$(unit_seconds "$next"); then
      total=$((total + step))
      index=$((index + 2))
      continue
    fi
    # "a quarter of an hour": the article belongs to the fraction behind it.
    if [[ ${next,,} == half || ${next,,} == quarter ]]; then
      index=$((index + 1))
      continue
    fi
  fi

  # "half an hour", "a quarter of an hour". The filler between the fraction and
  # the unit carries no meaning, so it is walked past rather than parsed.
  if [[ $word == half || $word == quarter ]]; then
    peek_at=$((index + 1))
    peek=${words[peek_at]:-}
    while [[ ${peek,,} == of || ${peek,,} == a || ${peek,,} == an ]]; do
      peek_at=$((peek_at + 1))
      peek=${words[peek_at]:-}
    done
    if step=$(unit_seconds "$peek"); then
      if [[ $word == half ]]; then
        total=$((total + step / 2))
      else
        total=$((total + step / 4))
      fi
      index=$((peek_at + 1))
      continue
    fi
  fi

  if [[ $word =~ ^[0-9]+$ ]]; then
    if step=$(unit_seconds "$next"); then
      total=$((total + word * step))
      index=$((index + 2))
      continue
    fi
    # A bare number is minutes, which is what `omarchy reminder` itself takes.
    total=$((total + word * 60))
    index=$((index + 1))
    continue
  fi

  if step=$(compact_seconds "$word"); then
    total=$((total + step))
    index=$((index + 1))
    continue
  fi

  if [[ $word == and || $word == "&" || $word == "," ]] &&
    ((total > 0)) && starts_duration "$next"; then
    index=$((index + 1))
    continue
  fi

  break
done

message=""
((index < count)) && message="${words[*]:index}"

# ---- the row

# Half an alarm is not an alarm, and both halves fail the same way: a row that
# offered to set one anyway would be offering to store something that cannot do
# its job. No time yet, or no words yet, means the sentence is not finished, so
# there is nothing to show and the launcher says "Nothing in Reminder" until
# there is.
((total == 0)) && exit 0
[[ -z ${message//[[:space:]]/} ]] && exit 0

minutes=$(((total + 59) / 60))
((minutes < 1)) && minutes=1
fire_at=$(date -d "+$minutes minutes" +%H:%M) || exit 0

detail=""
if ((minutes * 60 != total)); then
  detail="Rounded up from $(format_span "$total")  ·  Omarchy reminders are whole minutes"
fi

title="$message"
subtitle="Reminder in $(say_duration "$minutes"), at $fire_at"
command="omarchy reminder $minutes $(printf '%q' "$message")"

jq -cn --arg t "$title" --arg s "$subtitle" --arg d "$detail" --arg e "$command" \
  '{
     id: "alarm", title: $t, subtitle: $s, detail: $d,
     exec: $e, glyph: "󰢌", score: 99000, view: "hero",
     actions: [
       { title: "Set Reminder", shortcut: "↵", exec: $e },
       { title: "Show Pending", exec: "omarchy reminder show" },
       { title: "Cancel Every Reminder", exec: "omarchy reminder clear" }
     ]
   }'

# The pending reminders under the one being set, so arming a second is done
# while looking at the first. This is the whole reason the set row is a hero and
# these are a list: they are two different things on one card, not five results.
list_pending

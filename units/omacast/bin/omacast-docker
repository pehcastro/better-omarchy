#!/bin/bash
# Emits one JSON row per container for OmaCast's `docker:` keyword.
#
#   docker:          every container, running ones first
#   docker:pg        by name, image or id
#
# Running before stopped, because a stopped container is something you are about
# to start and a running one is something you are about to look inside, and the
# second is the more common errand.
#
# The extension's `when` asks the daemon rather than asking whether the binary
# exists: a machine with Docker installed and the daemon off would otherwise
# show an error where results should be. This script checks again anyway, since
# `when` is evaluated once at load and the daemon can stop afterwards.

set -uo pipefail

query="${1:-}"
needle="${query,,}"

command -v docker >/dev/null 2>&1 || exit 0
docker info --format '{{.ServerVersion}}' >/dev/null 2>&1 || exit 0

running=()
stopped=()

# One `docker ps` for everything. Asking per state would be one round trip to
# the daemon per state, for an ordering that is two lines of bash.
while IFS=$'\t' read -r id name image state status; do
  [[ -n $id ]] || continue
  if [[ -n $needle ]]; then
    [[ "${name,,} ${image,,} ${id,,}" == *"$needle"* ]] || continue
  fi
  if [[ $state == "running" ]]; then
    running+=("$id	$name	$image	$state	$status")
  else
    stopped+=("$id	$name	$image	$state	$status")
  fi
done < <(docker ps --all --format '{{.ID}}\t{{.Names}}\t{{.Image}}\t{{.State}}\t{{.Status}}' 2>/dev/null)

rank=90000
emitted=0

while IFS=$'\t' read -r id name image state status; do
  [[ -n $id ]] || continue

  quoted=$(printf '%q' "$id")

  jq -cn --arg id "$id" --arg t "$name" --arg d "$image" \
    --arg s "$state" --arg a "$status" \
    --arg logs "omarchy-launch-tui --app-id=org.omarchy.docker docker logs -f --tail 200 $quoted" \
    --arg shell "omarchy-launch-tui --app-id=org.omarchy.docker docker exec -it $quoted sh -c 'command -v bash >/dev/null && exec bash || exec sh'" \
    --arg q "$quoted" --arg n "$name" \
    --argjson sc "$rank" '
      # Start, stop and restart would otherwise fail invisibly: nothing is
      # watching for a non-zero exit once the launcher has closed.
      def act($verb; $past):
        { title: (($verb | ascii_upcase)[0:1] + $verb[1:]),
          exec: ("out=$(docker " + $verb + " " + $q + " 2>&1)"
                 + " && omarchy-notification-send " + (($n + " " + $past) | @sh)
                 + " || omarchy-notification-send -u normal "
                 + (("docker " + $verb + " failed") | @sh) + " \"$out\"") };
      {
        id: ("docker:" + $id), title: $t, detail: $d, subtitle: $s,
        accessory: $a, exec: $logs, score: $sc,
        actions: (
          [ { title: "Follow Logs", shortcut: "↵", exec: $logs } ]
          + (if $s == "running"
             then [ { title: "Shell Inside", exec: $shell },
                    act("stop"; "stopped"), act("restart"; "restarted") ]
             else [ act("start"; "started"), act("restart"; "restarted") ] end)
          + [ { title: "Copy Container ID", exec: ("printf %s " + ($id | @sh) + " | wl-copy") },
              { title: "Copy Name", exec: ("printf %s " + ($n | @sh) + " | wl-copy") } ]
        )
      }'

  rank=$((rank - 100))
  emitted=$((emitted + 1))
  ((emitted >= 20)) && break
done < <(printf '%s\n' "${running[@]}" "${stopped[@]}")

exit 0

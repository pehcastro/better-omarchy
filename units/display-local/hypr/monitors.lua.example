-- Copy this to monitors.lua beside it, then edit. The copy is gitignored, so
-- your layout never travels to another machine.
--
-- List what you have: hyprctl monitors all

hl.env("GDK_SCALE", "1")
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })


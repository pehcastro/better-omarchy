#!/bin/bash
# Emits one JSON row per open window for OmaCast's `win:` keyword.
#
#   win:            every window
#   win:chrome      by class or title
#
# Focus goes through the Lua dispatcher, not `dispatch focuswindow`: under a Lua
# config the old string form returns ok and does nothing.

set -uo pipefail

query="${1:-}"

hyprctl clients -j 2>/dev/null | jq -c --arg q "${query,,}" '
  [ .[]
    | select(.mapped and .workspace.id > 0)
    | { class: (.class // ""), title: (.title // ""), address: .address,
        workspace: (.workspace.name // (.workspace.id | tostring)) }
    | select($q == "" or ((.class + " " + .title) | ascii_downcase | contains($q)))
  ]
  | to_entries[]
  | {
      id: .value.address,
      title: (if .value.title == "" then .value.class else .value.title end),
      subtitle: (.value.class + "  ·  " + .value.workspace),
      exec: ("hyprctl dispatch " +
             ("hl.dsp.focus({ window = \"address:" + .value.address + "\" })" | @sh)),
      score: (90000 - (.key * 500))
    }'

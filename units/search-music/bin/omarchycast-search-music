#!/bin/bash
# Emits JSON rows for OmarchyCast's `music:` keyword: what is playing, and the
# transport controls for it.
#
#   music:          now playing, plus play/pause, next, previous
#   music:next      just the controls that match
#
# MPRIS over busctl rather than playerctl, so this needs nothing installed:
# every player that shows a media control anywhere already speaks it.

set -uo pipefail

query="${1:-}"
BUS=org.mpris.MediaPlayer2
PATH_=/org/mpris/MediaPlayer2
IFACE=org.mpris.MediaPlayer2.Player

player=$(busctl --user list --no-legend 2>/dev/null |
  awk '$1 ~ /^org\.mpris\.MediaPlayer2\./ { print $1; exit }')

[[ -z $player ]] && exit 0

short=${player#org.mpris.MediaPlayer2.}

# busctl prints a variant as a type tag and a value. This pulls the value out of
# a string variant, and the first string out of an array variant, which is how
# xesam:artist arrives.
prop() {
  busctl --user get-property "$player" "$PATH_" "$IFACE" "$1" 2>/dev/null
}

metadata=$(busctl --user get-property "$player" "$PATH_" "$IFACE" Metadata 2>/dev/null)

# busctl escapes a quote, a backslash and an apostrophe inside its strings, so
# a title like "Doesn't Just Happen" arrives with a backslash in it. Undo that
# here, or every apostrophe reaches the row as \'.
unescape() { sed "s/\\\\\\(.\\)/\\1/g"; }

field() {
  printf '%s' "$metadata" | grep -oP "\"$1\"\s+\Ks[^\"]*\"([^\"\\\\]|\\\\.)*\"" | head -1 |
    sed 's/^s\s*//; s/^"//; s/"$//' | unescape
}

title=$(field "xesam:title")
album=$(field "xesam:album")
artist=$(printf '%s' "$metadata" | grep -oP '"xesam:artist"\s+as\s+\d+\s+\K"([^"\\\\]|\\\\.)*"' |
  head -1 | sed 's/^"//; s/"$//' | unescape)

status=$(prop PlaybackStatus | sed 's/^s\s*//; s/"//g')
[[ -z $status ]] && status="Stopped"

subtitle="$short"
[[ -n $artist ]] && subtitle="$artist"
[[ -n $artist && -n $album ]] && subtitle="$artist  ·  $album"

row() {
  jq -cn --arg id "$1" --arg t "$2" --arg s "$3" --arg e "$4" --argjson sc "$5" \
    '{id: $id, title: $t, subtitle: $s, exec: $e, score: $sc}'
}

call="busctl --user call $player $PATH_ $IFACE"

# Nothing typed: lead with what is playing, then the controls.
matches() {
  [[ -z $query ]] && return 0
  [[ ${1,,} == *"${query,,}"* ]]
}

if [[ -n $title ]] && matches "$title $artist $album"; then
  verb=$([[ $status == "Playing" ]] && echo Pause || echo Play)
  row "now" "$title" "$subtitle  ·  $verb" "$call PlayPause" 95000
fi

matches "play pause" && row "playpause" "Play or Pause" "$short" "$call PlayPause" 80000
matches "next skip forward" && row "next" "Next Track" "$short" "$call Next" 79000
matches "previous back" && row "prev" "Previous Track" "$short" "$call Previous" 78000
matches "stop" && row "stop" "Stop" "$short" "$call Stop" 77000

exit 0
